@{
    Layout = null;
}
@model MySite.Web.Models.FooterModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>页脚设置</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
    <style>
        .upload-card { width: 120px; height: 120px; border: 2px dashed #d2d2d2; border-radius: 6px; display: flex; align-items: center; justify-content: center; cursor: pointer; background: #f9f9f9; }
        .upload-card i { font-size: 32px; color: #c2c2c2; }
        .upload-preview { width: 120px; height: 120px; border-radius: 6px; overflow: hidden; position: relative; }
        .upload-preview img { width: 100%; height: 100%; object-fit: contain; background: #f9f9f9; }
        .upload-preview .mask { position: absolute; inset: 0; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .2s; }
        .upload-preview:hover .mask { opacity: 1; }
        .mask .mask-btn { width: 28px; height: 28px; line-height: 28px; text-align: center; background: rgba(255,255,255,.9); border-radius: 50%; cursor: pointer; border: 0; }
        .friend-link-row { margin-bottom: 8px; }
        .color-input { width: 80px !important; }
    </style>
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">页脚设置</div>
            <div class="layui-card-body" style="padding: 15px;">
                <form class="layui-form" lay-filter="form-group">
                    <div class="layui-form-item">
                        <label class="layui-form-label">Logo</label>
                        <div class="layui-input-block">
                            <div id="logoWrap" style="display:inline-block;">
                                @if (!string.IsNullOrWhiteSpace(Model.Logo))
                                {
                                    <div class="upload-preview">
                                        <img src="@Model.Logo" alt="Logo" />
                                        <div class="mask"><button type="button" class="mask-btn" data-action="remove" title="删除"><i class="layui-icon layui-icon-delete"></i></button></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="upload-card"><i class="layui-icon layui-icon-upload-drag"></i></div>
                                }
                            </div>
                            <input type="hidden" name="Logo" id="txtLogo" value="@Html.Raw(Model.Logo)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">公司名称</label>
                        <div class="layui-input-block">
                            <input type="text" name="CompanyName" lay-verify="required" autocomplete="off" class="layui-input" value="@Html.Raw(Model.CompanyName)">
                        </div>
                    </div>
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">公司简介</label>
                        <div class="layui-input-block">
                            <textarea name="Intro" placeholder="公司简介" class="layui-textarea" style="height:100px;">@Html.Raw(Model.Intro)</textarea>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">联系电话</label>
                        <div class="layui-input-inline" style="width:240px;">
                            <input type="text" name="Phone" autocomplete="off" class="layui-input" value="@Html.Raw(Model.Phone)">
                        </div>
                        <label class="layui-form-label">联系邮箱</label>
                        <div class="layui-input-inline" style="width:240px;">
                            <input type="text" name="Email" autocomplete="off" class="layui-input" value="@Html.Raw(Model.Email)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">公司地址</label>
                        <div class="layui-input-block">
                            <input type="text" name="Address" autocomplete="off" class="layui-input" value="@Html.Raw(Model.Address)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">二维码</label>
                        <div class="layui-input-block">
                            <div id="qrcodeWrap" style="display:inline-block;">
                                @if (!string.IsNullOrWhiteSpace(Model.Qrcode))
                                {
                                    <div class="upload-preview">
                                        <img src="@Model.Qrcode" alt="二维码" />
                                        <div class="mask"><button type="button" class="mask-btn" data-action="remove" title="删除"><i class="layui-icon layui-icon-delete"></i></button></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="upload-card"><i class="layui-icon layui-icon-upload-drag"></i></div>
                                }
                            </div>
                            <input type="hidden" name="Qrcode" id="txtQrcode" value="@Html.Raw(Model.Qrcode)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">ICP备案号</label>
                        <div class="layui-input-inline" style="width:240px;">
                            <input type="text" name="IcpNo" autocomplete="off" class="layui-input" value="@Html.Raw(Model.IcpNo)">
                        </div>
                        <label class="layui-form-label">公安备案号</label>
                        <div class="layui-input-inline" style="width:240px;">
                            <input type="text" name="PoliceNo" autocomplete="off" class="layui-input" value="@Html.Raw(Model.PoliceNo)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">版权信息</label>
                        <div class="layui-input-block">
                            <input type="text" name="Copyright" autocomplete="off" class="layui-input" value="@Html.Raw(Model.Copyright)">
                        </div>
                    </div>
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">友情链接</label>
                        <div class="layui-input-block">
                            <div id="friendLinksBox"></div>
                            <button type="button" class="layui-btn layui-btn-normal layui-btn-sm" id="btnAddLink"><i class="layui-icon layui-icon-addition"></i>新增链接</button>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">背景颜色</label>
                        <div class="layui-input-inline" style="width:160px;">
                            <input type="text" name="BgColor" id="txtBgColor" class="layui-input color-input" value="@Model.BgColor">
                        </div>
                        <label class="layui-form-label">文字颜色</label>
                        <div class="layui-input-inline" style="width:160px;">
                            <input type="text" name="TextColor" id="txtTextColor" class="layui-input color-input" value="@Model.TextColor">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">是否启用</label>
                        <div class="layui-input-block">
                            <input type="radio" name="IsActive" value="true" title="启用" @Html.Raw(Model.IsActive ? " checked" : "")>
                            <input type="radio" name="IsActive" value="false" title="禁用" @Html.Raw(!Model.IsActive ? " checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item layui-layout-admin">
                        <div class="layui-input-block">
                            <div class="layui-footer" style="left: 0; z-index: 20000">
                                <button class="layui-btn" lay-submit="" lay-filter="form-page">立即保存</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <input type="hidden" id="initFriendLinks" value="@Html.Raw(Model.FriendLinks)">
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script src="~/resource/js/pickr.min.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['index', 'form'], function () {
            var $ = layui.$, form = layui.form, layer = layui.layer;

            var friendLinks = [];
            try { friendLinks = JSON.parse($('#initFriendLinks').val() || '[]') || []; } catch (e) { friendLinks = []; }

            function renderFriendLinks() {
                var html = '';
                for (var i = 0; i < friendLinks.length; i++) {
                    var link = friendLinks[i] || {};
                    html += '<div class="friend-link-row layui-form-item" data-idx="' + i + '">';
                    html += '<div class="layui-input-inline" style="width:200px;"><input type="text" class="layui-input" placeholder="标题" value="' + (link.title || '') + '" data-field="title"></div>';
                    html += '<div class="layui-input-inline" style="width:300px;"><input type="text" class="layui-input" placeholder="链接" value="' + (link.url || '') + '" data-field="url"></div>';
                    html += '<button type="button" class="layui-btn layui-btn-danger layui-btn-sm" data-action="remove-link"><i class="layui-icon layui-icon-delete"></i></button>';
                    html += '</div>';
                }
                $('#friendLinksBox').html(html);
            }

            $('#friendLinksBox').on('change', 'input[data-field]', function () {
                var row = $(this).closest('.friend-link-row');
                var idx = parseInt(row.attr('data-idx'));
                var field = $(this).attr('data-field');
                if (!friendLinks[idx]) friendLinks[idx] = {};
                friendLinks[idx][field] = $(this).val();
            }).on('click', '[data-action="remove-link"]', function () {
                var idx = parseInt($(this).closest('.friend-link-row').attr('data-idx'));
                friendLinks.splice(idx, 1);
                renderFriendLinks();
            });

            $('#btnAddLink').on('click', function () {
                friendLinks.push({ title: '', url: '' });
                renderFriendLinks();
            });

            renderFriendLinks();

            function openImageSelector(wrapId, inputId) {
                window._imgSelectorWrap = wrapId;
                window._imgSelectorInput = inputId;
                layer.open({ type: 2, title: '选择图片', area: ['900px', '680px'], content: '/Admin/ImageSelector' });
            }

            $('#logoWrap').on('click', '.upload-card, .upload-preview', function (e) {
                if ($(e.target).closest('[data-action="remove"]').length) return;
                openImageSelector('logoWrap', 'txtLogo');
            }).on('click', '[data-action="remove"]', function () {
                layer.confirm("确认删除吗？", function (i) {
                    $('#logoWrap').html('<div class="upload-card"><i class="layui-icon layui-icon-upload-drag"></i></div>');
                    $('#txtLogo').val('');
                    layer.close(i);
                });
            });

            $('#qrcodeWrap').on('click', '.upload-card, .upload-preview', function (e) {
                if ($(e.target).closest('[data-action="remove"]').length) return;
                openImageSelector('qrcodeWrap', 'txtQrcode');
            }).on('click', '[data-action="remove"]', function () {
                layer.confirm("确认删除吗？", function (i) {
                    $('#qrcodeWrap').html('<div class="upload-card"><i class="layui-icon layui-icon-upload-drag"></i></div>');
                    $('#txtQrcode').val('');
                    layer.close(i);
                });
            });

            window.addEventListener('message', function (e) {
                if (e.data && e.data.type === 'imageSelected') {
                    var url = e.data.url;
                    $('#' + window._imgSelectorWrap).html('<div class="upload-preview"><img src="' + url + '" alt="图片"><div class="mask"><button type="button" class="mask-btn" data-action="remove" title="删除"><i class="layui-icon layui-icon-delete"></i></button></div></div>');
                    $('#' + window._imgSelectorInput).val(url);
                }
            });

            if (window.Pickr) {
                Pickr.create({
                    el: '#txtBgColor',
                    default: $('#txtBgColor').val() || '#2c3e50',
                    components: { preview: true, opacity: false, hue: true, interaction: { hex: true, input: true, save: true } }
                }).on('save', function (val) { $('#txtBgColor').val(val.toHEX().toString()); });

                Pickr.create({
                    el: '#txtTextColor',
                    default: $('#txtTextColor').val() || '#ffffff',
                    components: { preview: true, opacity: false, hue: true, interaction: { hex: true, input: true, save: true } }
                }).on('save', function (val) { $('#txtTextColor').val(val.toHEX().toString()); });
            }

            form.on('submit(form-page)', function (data) {
                data.field.FriendLinks = JSON.stringify(friendLinks);
                $.ajax({
                    type: "post",
                    url: '/footer/edit?id=@Model.Id',
                    data: data.field,
                    dataType: "json",
                    success: function (res) {
                        if (res.code == 200) { layer.msg(res.message, { icon: 1 }); }
                        else { layer.msg(res.message, { icon: 5 }); }
                    },
                    error: function () { layer.msg('保存失败', { icon: 5 }); }
                });
                return false;
            });
        });
    </script>
</body>
</html>
