@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>信息</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row layui-col-space15">
            <div class="layui-col-md12">
                <div class="layui-card">
                    <!---搜索条件 begin--->
                    <div class="layui-form layui-card-header layuiadmin-card-header-auto">
                        <div class="layui-inline">
                            <div class="layui-inline">
                                <label class="layui-form-label">关键词</label>
                                <div class="layui-input-block">
                                    <input type="text" name="keywords" placeholder="请输入用户名或手机" autocomplete="off" class="layui-input">
                                </div>
                            </div>
                            <div class="layui-inline">
                                <label class="layui-form-label">是否查看</label>
                                <div class="layui-input-block" style="width:100px">
                                    <select name="IsRead" id="IsRead" lay-verify="">
                                        <option value="0">全部</option>
                                        <option value="2">已读</option>
                                        <option value="1">未读</option>
                                    </select>
                                </div>
                            </div>
                            <div class="layui-inline">
                                <button class="layui-btn layuiadmin-btn-admin" lay-submit="" lay-filter="app-search">
                                    <i class="layui-icon layui-icon-search layuiadmin-button-btn"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <!----搜索条件 end--->
                    <div class="layui-card-body">
                        <table class="layui-hide" id="app-table" lay-filter="app-table"></table>
                        <script type="text/html" id="app-table-bar">
                            <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="view"><i class="layui-icon layui-icon-play"></i>查看</a>
                            @if ((bool)ViewData[PageCode.PAGE_Button_Delete])
                            {
                                <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del"><i class="layui-icon layui-icon-delete"></i>删除</a>
                            }
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="div_box" class="layui-hide layui-form">
        <div class="layui-card">
            <div class="layui-card-body">
                <div class="layui-form-item">
                    <div class="layui-inline">
                        <label class="layui-form-label">姓名：</label>
                        <div class="layui-input-inline">
                            <p id="username" style="height:38px;line-height:38px;"></p>
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-inline">
                        <label class="layui-form-label">手机：</label>
                        <div class="layui-input-inline">
                            <p id="phone" style="height:38px;line-height:38px;"></p>
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-inline">
                        <label class="layui-form-label">邮箱：</label>
                        <div class="layui-input-inline">
                            <p id="email" style="height:38px;line-height:38px;"></p>
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-inline">
                        <label class="layui-form-label">留言：</label>
                        <div class="layui-input-inline">
                            <p id="message" style="min-height: 38px; line-height: 38px; width: 500px; "></p>
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <div class="layui-inline">
                        <label class="layui-form-label">时间：</label>
                        <div class="layui-input-inline">
                            <p id="sendDate" style="height:38px;line-height:38px;"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script src="~/resource/js/site.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['table', 'form'], function () {
            var $ = layui.$
                , table = layui.table
                , form = layui.form;

            // 当前的select的id
            var isRead = getQueryString('isRead');
            if (isRead != null) {
                $('#IsRead').val(getQueryString('isRead'));
            }
            else {
                $('#IsRead').val(0);
            }
            form.render();

            var dataTable = table.render({
                where: { isRead: $('#IsRead').val() }, //如果无需传递额外参数，可不加该参数
                elem: '#app-table',
                url: '/Message/GetList',
                response: {
                    statusName: 'code', //规定数据状态的字段名称，默认：code
                    statusCode: '200 ', //规定成功的状态码，默认：0
                    msgName: 'message', //规定状态信息的字段名称，默认：msg
                    countName: 'count', //规定数据总数的字段名称，默认：count
                    dataName: 'data' //规定数据列表的字段名称，默认：data
                },
                cols: [[
                    { field: 'id', width: 80, title: 'ID' },
                    { field: 'userName', width: 200, title: '用户名' },
                    { field: 'email', title: '邮箱' },
                    { field: 'phone', width: 150, title: '手机' },
                    {
                        field: 'isRead', width: 90, title: '状态', templet: function (d) {
                            var str = '';
                            if (d.isRead) {
                                str = '<span class="layui-btn layui-btn-primary layui-btn-xs">已读</span>'
                            }
                            else {
                                str = '<span class="layui-btn layui-btn-warm layui-btn-xs">未读</span>'
                            }
                            return str;
                        }
                    },
                    { field: 'creationTime', width: 200, title: '日期' },
                    { align: 'center', width: 240, toolbar: '#app-table-bar' }
                ]],
                request: {
                    pageName: 'pageIndex', //页码的参数名称，默认：page
                    limitName: 'pageSize' //每页数据量的参数名，默认：limit
                },
                page: true
            });

            //监听工具条
            table.on('tool(app-table)', function (obj) {
                if (obj.event === 'view') {
                    $('#username').html(obj.data.userName);
                    $('#phone').html(obj.data.phone);
                    $('#email').html(obj.data.email);
                    $('#message').html(obj.data.message);
                    $('#sendDate').html(obj.data.creationTime);

                    layer.open({
                        type: 1,
                        title: '信息内容',
                        content: $('#div_box').html(),
                        area: ['680px', '500px'],
                        btn: ['确定', '取消'],
                        yes: function (index, layero) {
                            $.ajax({
                                url: '/Message/GetInfo',
                                data: { 'id': obj.data.id },
                                type: 'get',
                                dataType: 'json',
                                success: function (res) {
                                    layer.close(index);
                                    if (!obj.data.isRead) {
                                        if (res.code == 200) {
                                            layui.table.reload('app-table', { page: { curr: $(".layui-laypage-em").next().html() } });
                                        }
                                        else {
                                            layer.msg(res.message);
                                        }
                                    }
                                }
                            });
                        }
                    });
                } else if (obj.event === 'del') {
                    layer.confirm('确认删除?', function (index) {
                        layer.msg('正在删除...', { icon: 16, shade: 0.3, time: 5000 });
                        $.ajax({
                            url: '/Message/Delete',
                            data: { 'id': obj.data.id },
                            type: 'post',
                            dataType: 'json',
                            success: function (res) {
                                if (res.code == 200) {
                                    layer.msg(res.message);
                                    layui.table.reload('app-table', { page: { curr: $(".layui-laypage-em").next().html() } });
                                    layer.close(index);
                                }
                                else {
                                    layer.msg(res.message);
                                }
                            }
                        });
                    });
                }
            });

            //监听搜索
            form.on('submit(app-search)', function (data) {
                dataTable.reload({
                    where: data.field,
                    page: { curr: 1 }
                });
                return false;
            });

        });
    </script>
</body>
</html>