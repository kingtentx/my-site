@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>全局 Header / Footer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/static/layuiadmin/layui/css/layui.css">
    <link rel="stylesheet" href="~/static/layuiadmin/style/admin.css">
    <style>
        .region-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.region-card{border:1px solid #e5e7eb;border-radius:8px;padding:22px;background:#fff}.region-card h2{margin:0 0 10px}.region-card p{color:#6b7280;line-height:1.8;min-height:52px}.region-actions{display:flex;gap:8px;flex-wrap:wrap}.status{font-size:12px;margin-left:8px}.status.published{color:#16a34a}.status.draft{color:#d97706}.tip{margin-bottom:18px;padding:12px 14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;color:#475569;line-height:1.8}@@media(max-width:800px){.region-grid{grid-template-columns:1fr}}
    </style>
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-header">全局区域设计</div>
        <div class="layui-card-body">
            <div class="tip">Header 和 Footer 分别保存、分别发布。首页发布不会自动发布这里的修改。草稿预览会显示最新保存的全局区域；正式网站只显示各自的发布版本。尚未发布的区域不会用默认模板替代。</div>
            <div class="region-grid">
                <div class="region-card">
                    <h2>页头 Header <span class="status @(ViewBag.HeaderStatus == 1 ? "published" : "draft")">@ViewBag.HeaderState</span></h2>
                    <p>适合设计单层/双层导航、Logo、搜索、语言切换、联系电话、CTA 等组合。</p>
                    <p>最近发布：@ViewBag.HeaderPublishTime<br>建议先配置 Logo，再配置导航；按钮仅在需要时添加。</p>
                    <div class="region-actions"><a class="layui-btn" href="/Page/Design?id=@ViewBag.HeaderId">配置页头</a><a class="layui-btn layui-btn-primary" target="_blank" rel="noopener" href="/Page/Preview?id=@ViewBag.HeaderId">整页草稿预览</a>@if (ViewBag.CanPublish == true) {<button class="layui-btn layui-btn-normal" data-publish="@ViewBag.HeaderId" data-name="页头">发布页头</button>}<button class="layui-btn layui-btn-danger layui-btn-primary" data-reset="header">重置草稿</button></div>
                </div>
                <div class="region-card">
                    <h2>页脚 Footer <span class="status @(ViewBag.FooterStatus == 1 ? "published" : "draft")">@ViewBag.FooterState</span></h2>
                    <p>可自由组合企业介绍、快捷导航、联系方式、社交链接、版权信息等内容。</p>
                    <p>最近发布：@ViewBag.FooterPublishTime<br>可从组合模板开始，用页面结构快速选择嵌套组件。</p>
                    <div class="region-actions"><a class="layui-btn" href="/Page/Design?id=@ViewBag.FooterId">配置页脚</a><a class="layui-btn layui-btn-primary" target="_blank" rel="noopener" href="/Page/Preview?id=@ViewBag.FooterId">整页草稿预览</a>@if (ViewBag.CanPublish == true) {<button class="layui-btn layui-btn-normal" data-publish="@ViewBag.FooterId" data-name="页脚">发布页脚</button>}<button class="layui-btn layui-btn-danger layui-btn-primary" data-reset="footer">重置草稿</button></div>
                </div>
            </div>
            <div style="margin-top:20px"><a href="/Page/Index" class="layui-btn layui-btn-primary">返回页面管理</a><a href="/" target="_blank" rel="noopener" class="layui-btn layui-btn-primary">查看正式网站</a></div>
        </div>
    </div>
</div>
<script src="~/static/layuiadmin/layui/layui.js"></script>
<script>
layui.use(['layer'], function(){
    var $=layui.$, layer=layui.layer;
    $('[data-publish]').on('click',function(){
        var button=$(this);
        layer.confirm('将最新保存的'+button.attr('data-name')+'应用到所有前台页面？未保存的编辑不会发布。',function(index){
            layer.close(index); button.prop('disabled',true);
            $.post('/Page/Publish',{id:button.attr('data-publish')}).done(function(res){if(Number(res.code)===200){location.reload();}else layer.msg(res.message||'发布失败');}).fail(function(){layer.msg('发布失败，请重试');}).always(function(){button.prop('disabled',false);});
        });
    });
    $('[data-reset]').on('click', function(){
        var region=$(this).attr('data-reset');
        layer.confirm('确认重置草稿？当前草稿会被覆盖，已发布的正式网站保持不变。', function(index){
            layer.close(index);
            $.post('/GlobalRegion/Reset',{region:region},function(res){if(res.code===200){layer.alert(res.message,function(){location.reload();});}else layer.msg(res.message||'操作失败',{icon:5});},'json').fail(function(){layer.msg('重置失败，请重试');});
        });
    });
});
</script>
</body>
</html>
