@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>全局 Header / Footer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css">
    <style>
        .region-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.region-card{border:1px solid #e5e7eb;border-radius:8px;padding:22px;background:#fff}.region-card h2{margin:0 0 10px}.region-card p{color:#6b7280;line-height:1.8;min-height:52px}.region-actions{display:flex;gap:8px;flex-wrap:wrap}.status{font-size:12px;margin-left:8px}.status.published{color:#16a34a}.status.draft{color:#d97706}.tip{margin-bottom:18px;padding:12px 14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;color:#475569;line-height:1.8}@@media(max-width:800px){.region-grid{grid-template-columns:1fr}}
    </style>
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-header">全局区域设计</div>
        <div class="layui-card-body">
            <div class="tip">Header 和 Footer 分别保存、分别发布。首页发布不会自动发布这里的修改。草稿预览会显示最新保存的全局区域；正式网站只显示各自的发布版本。尚未发布的区域不会用默认模板替代。</div>
            <div class="region-grid">
                <div class="region-card">
                    <h2>Header <span class="status @(ViewBag.HeaderStatus == 1 ? "published" : "draft")">@(ViewBag.HeaderStatus == 1 ? "已发布" : "草稿")</span></h2>
                    <p>适合设计单层/双层导航、Logo、搜索、语言切换、联系电话、CTA 等组合。</p>
                    <div class="region-actions"><a class="layui-btn" href="/Page/Design?id=@ViewBag.HeaderId">装修 Header</a><a class="layui-btn layui-btn-primary" target="_blank" href="/Page/Preview?id=@ViewBag.HeaderId">预览</a><button class="layui-btn layui-btn-danger layui-btn-primary" data-reset="header">恢复默认</button></div>
                </div>
                <div class="region-card">
                    <h2>Footer <span class="status @(ViewBag.FooterStatus == 1 ? "published" : "draft")">@(ViewBag.FooterStatus == 1 ? "已发布" : "草稿")</span></h2>
                    <p>可自由组合企业介绍、快捷导航、联系方式、社交链接、版权信息等内容。</p>
                    <div class="region-actions"><a class="layui-btn" href="/Page/Design?id=@ViewBag.FooterId">装修 Footer</a><a class="layui-btn layui-btn-primary" target="_blank" href="/Page/Preview?id=@ViewBag.FooterId">预览</a><button class="layui-btn layui-btn-danger layui-btn-primary" data-reset="footer">恢复默认</button></div>
                </div>
            </div>
            <div style="margin-top:20px"><a href="/Page/Index" class="layui-btn layui-btn-primary">返回页面管理</a></div>
        </div>
    </div>
</div>
<script src="~/resource/layuiadmin/layui/layui.js"></script>
<script>
layui.use(['layer'], function(){
    var $=layui.$, layer=layui.layer;
    $('[data-reset]').on('click', function(){
        var region=$(this).attr('data-reset');
        layer.confirm('确认恢复为新版默认结构？当前未发布装修内容会被覆盖。', function(index){
            $.post('/GlobalRegion/Reset',{region:region},function(res){layer.close(index);if(res.code===200){layer.alert(res.message,function(){location.reload();});}else layer.msg(res.message||'操作失败',{icon:5});},'json');
        });
    });
});
</script>
</body>
</html>
