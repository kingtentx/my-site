@model CIMC.Data.Tag
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>分类编辑</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
    <link rel="stylesheet" href="~/resource/css/site.css" media="all">
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-header">@(Model.Id > 0 ? "修改分类" : "添加分类")</div>
        <div class="layui-card-body" style="padding:15px;">
            <form class="layui-form" lay-filter="form-group">
                <div class="layui-form-item"><label class="layui-form-label">分类名称</label><div class="layui-input-block"><input type="text" name="TagName" lay-verify="required" autocomplete="off" placeholder="请输入分类名称" class="layui-input w500" value="@Html.Raw(Model.TagName)"></div></div>
                <div class="layui-form-item"><label class="layui-form-label">分类名称(EN)</label><div class="layui-input-block"><input type="text" name="TagName_EN" autocomplete="off" placeholder="Please enter category name" class="layui-input w500" value="@Html.Raw(Model.TagName_EN)"></div></div>
                <div class="layui-form-item">
                    <label class="layui-form-label">内容类型</label>
                    <div class="layui-input-inline w300">
                        <select name="TagType" lay-verify="required">
                            <option value="">请选择</option>
                            <option value="1" selected="@(Model.TagType == 1 ? "selected" : null)">新闻</option>
                            <option value="2" selected="@(Model.TagType == 2 ? "selected" : null)">产品</option>
                            <option value="3" selected="@(Model.TagType == 3 ? "selected" : null)">招聘</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item"><label class="layui-form-label">排序</label><div class="layui-input-inline"><input type="number" name="Sort" autocomplete="off" class="layui-input" value="@Model.Sort"></div><div class="layui-form-mid layui-word-aux">数字越小越靠前</div></div>
                <div class="layui-form-item"><label class="layui-form-label">是否启用</label><div class="layui-input-block"><input type="checkbox" name="IsActive" lay-skin="switch" lay-text="是|否" value="true" checked="@(Model.IsActive ? "checked" : null)"></div></div>
                <div class="layui-form-item layui-layout-admin"><div class="layui-input-block"><div class="layui-footer" style="left:0;z-index:20000"><button class="layui-btn" lay-submit lay-filter="save">立即保存</button><a class="layui-btn layui-btn-primary" href="/Tag/Index">返回列表</a></div></div></div>
            </form>
        </div>
    </div>
</div>
<script src="~/resource/layuiadmin/layui/layui.js"></script>
<script>
layui.config({base:'@Url.Content("~")/resource/layuiadmin/'}).extend({index:'lib/index'}).use(['index','form'],function(){
    var $=layui.$,form=layui.form,layer=layui.layer;
    form.on('submit(save)',function(data){
        data.field.IsActive=$('input[name="IsActive"]').prop('checked');
        $.post('/Tag/Edit?id=@Model.Id',data.field,function(res){if(res.code===200)layer.alert(res.message,function(){location.href='/Tag/Index';});else layer.msg(res.message,{icon:5});});
        return false;
    });
});
</script>
</body>
</html>
