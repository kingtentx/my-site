@model List<MySite.Web.Models.TagModel>
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>产品管理</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/static/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/static/layuiadmin/style/admin.css" media="all">
    <style>.layui-table-cell{height:auto}.product-thumb{width:110px;height:70px;object-fit:contain;cursor:pointer;background:#f8f8f8}</style>
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-form layui-card-header layuiadmin-card-header-auto">
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">产品分类</label><div class="layui-input-block" style="width:200px"><select name="tagsId"><option value="0">全部产品</option>@foreach (var tag in Model) { <option value="@tag.Id">@tag.TagName</option> }</select></div></div>
                <div class="layui-inline"><button class="layui-btn layuiadmin-btn-admin" lay-submit lay-filter="app-search"><i class="layui-icon layui-icon-search layuiadmin-button-btn"></i></button></div>
            </div>
        </div>
        <div class="layui-card-body">
            <div style="padding-bottom:10px;">
                @if ((bool)ViewData[PageCode.PAGE_Button_Add])
                {
                    <a class="layui-btn" href="/Album/BatchUpload">批量添加</a>
                    <a class="layui-btn" href="/Album/Edit">添加产品</a>
                }
                @if ((bool)ViewData[PageCode.PAGE_Button_Delete]) { <button class="layui-btn" id="batchDelete">删除</button> }
            </div>
            <table class="layui-hide" id="app-table" lay-filter="app-table"></table>
            <script type="text/html" id="imageTpl">{{# if(d.imageUrl){ }}<img class="product-thumb" src="{{d.imageUrl}}" alt="{{d.title||'产品图片'}}">{{# }else{ }}<span style="color:#bbb">无图片</span>{{# } }}</script>
            <script type="text/html" id="statusTpl">{{# if(d.isActive){ }}<span class="layui-btn layui-btn-primary layui-btn-xs">已发布</span>{{# }else{ }}<span class="layui-btn layui-btn-warm layui-btn-xs">未发布</span>{{# } }}</script>
            <script type="text/html" id="barTpl">
                @if ((bool)ViewData[PageCode.PAGE_Button_Edit]) { <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="edit"><i class="layui-icon layui-icon-edit"></i>编辑</a> }
                @if ((bool)ViewData[PageCode.PAGE_Button_Delete]) { <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del"><i class="layui-icon layui-icon-delete"></i>删除</a> }
            </script>
        </div>
    </div>
</div>
<script src="~/static/layuiadmin/layui/layui.js"></script>
<script>
layui.config({base:'@Url.Content("~/static/layuiadmin/")'}).extend({index:'lib/index'}).use(['index','table','form'],function(){
    var $=layui.$,table=layui.table,form=layui.form,layer=layui.layer;
    table.render({elem:'#app-table',url:'/Album/GetList',response:{statusName:'code',statusCode:200,msgName:'message',countName:'count',dataName:'data'},request:{pageName:'pageIndex',limitName:'pageSize'},page:true,cols:[[{type:'checkbox'},{field:'id',width:70,title:'ID'},{field:'imageUrl',minWidth:180,title:'产品图片',templet:'#imageTpl'},{field:'title',width:220,title:'产品标题'},{field:'tagName',width:140,title:'分类'},{field:'sort',width:80,title:'排序'},{field:'isActive',width:100,title:'状态',templet:'#statusTpl'},{field:'creationTime',width:180,title:'创建时间'},{align:'center',width:180,title:'操作',toolbar:'#barTpl'}]]});
    form.on('submit(app-search)',function(data){table.reload('app-table',{page:{curr:1},where:data.field});return false;});
    table.on('tool(app-table)',function(obj){if(obj.event==='edit'){location.href='/Album/Edit/'+obj.data.id;return;}if(obj.event==='del')layer.confirm('确认删除？',function(index){$.post('/Album/Delete',{id:obj.data.id},function(res){layer.close(index);if(res.code===200)obj.del();layer.msg(res.message);});});});
    $('#batchDelete').on('click',function(){var rows=table.checkStatus('app-table').data;if(!rows.length){layer.msg('请至少选择一项');return;}layer.confirm('确认删除选中的 '+rows.length+' 条数据？',function(index){$.ajax({type:'post',url:'/Album/Delete?isAll=1',data:{ids:rows.map(function(x){return x.id;})},traditional:true,success:function(res){layer.close(index);layer.msg(res.message);if(res.code===200)table.reload('app-table');}});});});
});
</script>
</body>
</html>
