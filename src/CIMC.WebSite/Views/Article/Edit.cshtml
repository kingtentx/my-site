@using CIMC.Data
@{
    Layout = null;
    var categories = ViewBag.Categories as List<ContentProductCategory> ?? new List<ContentProductCategory>();
}
@model ArticleModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>文章编辑</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
    <style>
        .cover-card{width:260px;height:150px;border:2px dashed #d2d2d2;border-radius:6px;display:flex;align-items:center;justify-content:center;cursor:pointer;overflow:hidden;background:#fafafa}
        .cover-card img{width:100%;height:100%;object-fit:cover}.cover-actions{margin-top:8px}.form-section{font-weight:600;border-left:3px solid #1e9fff;padding-left:10px;margin:18px 0 14px}
    </style>
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-header">@(Model.Id > 0 ? "修改文章" : "添加文章")</div>
        <div class="layui-card-body" style="padding:15px;">
            <form class="layui-form">
                <div class="form-section">基础信息</div>
                <div class="layui-form-item">
                    <label class="layui-form-label">文章标题</label>
                    <div class="layui-input-block"><input type="text" name="Title" lay-verify="required" class="layui-input" value="@Html.Raw(Model.Title)"></div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">英文标题</label>
                    <div class="layui-input-block"><input type="text" name="Title_EN" class="layui-input" value="@Html.Raw(Model.Title_EN)"></div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">文章分类</label>
                    <div class="layui-input-inline" style="width:260px;">
                        <select name="TagId">
                            <option value="0">未分类</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id" selected="@(category.Id == Model.TagId ? "selected" : null)">@category.Name</option>
                            }
                        </select>
                    </div>
                    <label class="layui-form-label">文章标签</label>
                    <div class="layui-input-inline" style="width:360px;"><input type="text" name="Keyword" placeholder="多个标签用逗号分隔" class="layui-input" value="@Html.Raw(Model.Keyword)"></div>
                </div>
                <div class="layui-form-item layui-form-text">
                    <label class="layui-form-label">摘要</label>
                    <div class="layui-input-block"><textarea name="Description" class="layui-textarea">@Html.Raw(Model.Description)</textarea></div>
                </div>
                <div class="layui-form-item layui-form-text">
                    <label class="layui-form-label">英文摘要</label>
                    <div class="layui-input-block"><textarea name="Description_EN" class="layui-textarea">@Html.Raw(Model.Description_EN)</textarea></div>
                </div>

                <div class="layui-form-item">
                    <label class="layui-form-label">封面图</label>
                    <div class="layui-input-block">
                        <div class="cover-card" id="coverCard">
                            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="封面"> }
                            else { <span><i class="layui-icon layui-icon-picture" style="font-size:28px"></i> 选择封面图</span> }
                        </div>
                        <div class="cover-actions"><button type="button" class="layui-btn layui-btn-primary layui-btn-sm" id="removeCover">清除封面</button></div>
                        <input type="hidden" name="ImageUrl" id="txtImageUrl" value="@Html.Raw(Model.ImageUrl)">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">作者</label>
                    <div class="layui-input-inline" style="width:220px;"><input type="text" name="Author" class="layui-input" value="@Html.Raw(Model.Author)"></div>
                    <label class="layui-form-label">来源</label>
                    <div class="layui-input-inline" style="width:220px;"><input type="text" name="Source" class="layui-input" value="@Html.Raw(Model.Source)"></div>
                    <label class="layui-form-label">排序</label>
                    <div class="layui-input-inline" style="width:100px;"><input type="number" name="Sort" class="layui-input" value="@Model.Sort"></div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">来源链接</label>
                    <div class="layui-input-inline" style="width:360px;"><input type="text" name="SourceUrl" class="layui-input" value="@Html.Raw(Model.SourceUrl)"></div>
                    <label class="layui-form-label">跳转链接</label>
                    <div class="layui-input-inline" style="width:360px;"><input type="text" name="LinkUrl" class="layui-input" value="@Html.Raw(Model.LinkUrl)"></div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">状态</label>
                    <div class="layui-input-inline" style="width:220px;">
                        <input type="radio" name="IsActive" value="true" title="发布" @Html.Raw(Model.IsActive ? " checked" : "")>
                        <input type="radio" name="IsActive" value="false" title="草稿" @Html.Raw(!Model.IsActive ? " checked" : "")>
                    </div>
                    <label class="layui-form-label">热门文章</label>
                    <div class="layui-input-inline"><input type="checkbox" name="IsHot" value="true" lay-skin="switch" lay-text="是|否" @Html.Raw(Model.IsHot ? " checked" : "")></div>
                </div>

                <div class="form-section">文章内容</div>
                <div class="layui-form-item layui-form-text"><label class="layui-form-label">中文内容</label><div class="layui-input-block"><div id="txtDetail">@Html.Raw(Model.Detail)</div></div></div>
                <div class="layui-form-item layui-form-text"><label class="layui-form-label">英文内容</label><div class="layui-input-block"><div id="txtDetailEN">@Html.Raw(Model.Detail_EN)</div></div></div>
                <div class="layui-form-item"><div class="layui-input-block"><button class="layui-btn" lay-submit lay-filter="save">保存文章</button><a href="/article/index" class="layui-btn layui-btn-primary">返回列表</a>@if(Model.Id>0){<a href="/news/preview-@(Model.Id).html" target="_blank" class="layui-btn layui-btn-normal">预览</a>}</div></div>
            </form>
        </div>
    </div>
</div>
<script src="~/resource/layuiadmin/layui/layui.js"></script>
<script src="~/resource/js/jquery-1.12.4.min.js"></script>
<script src="~/resource/wangeditor-4.7.9/wangEditor.min.js"></script>
<script>
layui.config({base:'@Url.Content("~")/resource/layuiadmin/'}).extend({index:'lib/index'}).use(['index','form'],function(){
    var $=layui.$,form=layui.form,layer=layui.layer,E=window.wangEditor;
    function makeEditor(selector){var e=new E(selector);e.config.uploadFileName='file';e.config.uploadImgServer='/Upload/UploadImage';e.config.uploadImgHooks={customInsert:function(insertImg,result){if(result&&result.url)insertImg(result.url);}};e.create();return e;}
    var detail=makeEditor('#txtDetail'), detailEn=makeEditor('#txtDetailEN');
    $('#coverCard').on('click',function(){layer.open({type:2,title:'选择图片',area:['900px','680px'],content:'/Admin/ImageSelector'});});
    $('#removeCover').on('click',function(){$('#txtImageUrl').val('');$('#coverCard').html('<span><i class="layui-icon layui-icon-picture" style="font-size:28px"></i> 选择封面图</span>');});
    window.addEventListener('message',function(e){if(e.data&&e.data.type==='imageSelected'){var url=e.data.url||'';$('#txtImageUrl').val(url);$('#coverCard').html('<img src="'+url+'" alt="封面">');}});
    form.on('submit(save)',function(data){
        data.field.Detail=detail.txt.html();data.field.Detail_EN=detailEn.txt.html();data.field.IsHot=$('input[name="IsHot"]').prop('checked');
        $.post('/article/edit?id=@Model.Id',data.field,function(res){if(res.code===200)layer.alert(res.message,function(){location.href='/article/index';});else layer.msg(res.message,{icon:5});},'json');
        return false;
    });
});
</script>
</body>
</html>
