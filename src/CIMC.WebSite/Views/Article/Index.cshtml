@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>文章管理</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
    <style>.viewimg{width:80px;height:55px;object-fit:cover}.layui-table-cell{height:auto}</style>
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-form layui-card-header layuiadmin-card-header-auto">
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label">标题</label>
                    <div class="layui-input-inline"><input type="text" name="keywords" placeholder="请输入文章标题" autocomplete="off" class="layui-input"></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">文章分类</label>
                    <div class="layui-input-inline" style="width:220px;"><select name="tagsId" id="selCategory"><option value="0">全部文章</option></select></div>
                </div>
                <div class="layui-inline"><button class="layui-btn" lay-submit lay-filter="app-search"><i class="layui-icon layui-icon-search"></i> 查询</button></div>
            </div>
        </div>
        <div class="layui-card-body">
            <div style="padding-bottom:10px;">
                @if ((bool)ViewData[PageCode.PAGE_Button_Add]) { <a class="layui-btn" href="/article/edit">添加文章</a> }
                @if ((bool)ViewData[PageCode.PAGE_Button_Delete]) { <button class="layui-btn layui-btn-danger" id="batchdel">批量删除</button> }
            </div>
            <table class="layui-hide" id="app-table" lay-filter="app-table"></table>
            <script type="text/html" id="coverTpl">{{# if(d.imageUrl){ }}<img src="{{d.imageUrl}}" class="viewimg" alt="">{{# } else { }}<span style="color:#bbb">无</span>{{# } }}</script>
            <script type="text/html" id="statusTpl">{{# if(d.isActive){ }}<span class="layui-badge layui-bg-green">已发布</span>{{# } else { }}<span class="layui-badge layui-bg-gray">草稿</span>{{# } }}</script>
            <script type="text/html" id="hotTpl">{{# if(d.isHot){ }}<span class="layui-badge">热门</span>{{# } else { }}-{{# } }}</script>
            <script type="text/html" id="barTpl">
                @if ((bool)ViewData[PageCode.PAGE_Button_Edit]) { <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="edit">编辑</a><a class="layui-btn layui-btn-warm layui-btn-xs" lay-event="hot">切换热门</a> }
                @if ((bool)ViewData[PageCode.PAGE_Button_Delete]) { <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a> }
            </script>
        </div>
    </div>
</div>
<script src="~/resource/layuiadmin/layui/layui.js"></script>
<script>
layui.config({base:'@Url.Content("~")/resource/layuiadmin/'}).extend({index:'lib/index'}).use(['index','table','form'],function(){
    var $=layui.$,form=layui.form,table=layui.table,layer=layui.layer;
    $.get('/ContentCategory/GetOptions',{contentType:'article'},function(res){
        if(res.code!==200||!res.data)return;
        var html='<option value="0">'+(res.data.allText||'全部文章')+'</option>';
        (res.data.options||[]).forEach(function(item){html+='<option value="'+item.value+'">'+item.text+'</option>';});
        $('#selCategory').html(html);form.render('select');
    },'json');

    table.render({
        elem:'#app-table',url:'/Article/GetList',where:{tagsId:0},
        response:{statusName:'code',statusCode:200,msgName:'message',countName:'count',dataName:'data'},
        cols:[[
            {type:'checkbox'},{field:'id',width:65,title:'ID'},{field:'imageUrl',width:105,title:'封面',templet:'#coverTpl'},
            {field:'title',minWidth:230,title:'文章标题'},{field:'tagName',width:130,title:'文章分类'},
            {field:'isHot',width:75,align:'center',title:'热门',templet:'#hotTpl'},
            {field:'isActive',width:90,align:'center',title:'状态',templet:'#statusTpl'},
            {field:'viewCount',width:85,title:'浏览量'},{field:'creationTime',width:170,title:'创建时间'},
            {width:230,align:'center',title:'操作',toolbar:'#barTpl'}
        ]],
        request:{pageName:'pageIndex',limitName:'pageSize'},page:true,limit:10,limits:[10,20,50]
    });

    table.on('tool(app-table)',function(obj){
        var d=obj.data;
        if(obj.event==='edit')location.href='/article/edit/'+d.id;
        else if(obj.event==='hot')$.post('/Article/SetHotArticle',{id:d.id,isHot:!d.isHot},function(res){if(res.code===200){layer.msg(res.message);table.reload('app-table');}else layer.msg(res.message,{icon:5});},'json');
        else if(obj.event==='del')layer.confirm('确认删除该文章？',function(index){$.post('/Article/Delete',{id:d.id},function(res){layer.close(index);if(res.code===200){layer.msg(res.message);obj.del();}else layer.msg(res.message,{icon:5});},'json');});
    });

    $('#batchdel').on('click',function(){
        var rows=table.checkStatus('app-table').data;
        if(!rows.length){layer.msg('请至少选择一项');return;}
        layer.confirm('确认删除选中的 '+rows.length+' 条文章？',function(index){
            $.ajax({type:'post',url:'/Article/Delete?isAll=1',data:{ids:rows.map(function(x){return x.id;})},traditional:true,dataType:'json',success:function(res){layer.close(index);if(res.code===200){layer.msg(res.message);table.reload('app-table');}else layer.msg(res.message,{icon:5});}});
        });
    });
    form.on('submit(app-search)',function(data){table.reload('app-table',{page:{curr:1},where:data.field});return false;});
});
</script>
</body>
</html>
