@using Newtonsoft.Json
@model MySite.Web.WebsiteBuilder.Models.WebsitePageRenderModel
@{ Layout = null; var pageJson = Model.IsPreview ? Model.Page.DraftJson : Model.Page.PublishJson; if (string.IsNullOrWhiteSpace(pageJson)) { pageJson = "{}"; } }
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@(ViewData["Title"] ?? Model.Page.PageName)</title><meta name="keywords" content="@(ViewData["Keywords"] ?? string.Empty)"><meta name="description" content="@(ViewData["Description"] ?? string.Empty)"><style>body{margin:0;font-family:Arial,'Microsoft YaHei';color:#1f2937}a{text-decoration:none;color:inherit}.nav{border-bottom:1px solid #e5e7eb;background:white}.navin{max-width:1200px;margin:auto;height:68px;display:flex;align-items:center;justify-content:space-between;padding:0 18px}.brand{font-size:20px;font-weight:bold}.menus{display:flex;gap:24px}.banner{min-height:420px;background:#2563eb;color:white;display:flex;align-items:center;justify-content:center;text-align:center;padding:40px 18px;background-size:cover;background-position:center}.banner h1{font-size:46px;margin:0 0 14px}.banner p{font-size:20px}.btn{display:inline-block;background:#fff;color:#2563eb;border-radius:999px;padding:10px 22px;font-weight:bold}.sec{padding:64px 18px}.container{max-width:1200px;margin:auto}.title{text-align:center;font-size:32px;margin:0 0 30px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.card{background:white;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;box-shadow:0 8px 24px #0001}.cover{height:160px;background:#e5e7eb;display:flex;align-items:center;justify-content:center;color:#94a3b8;background-size:cover;background-position:center}.body{padding:18px}.body h3{margin:0 0 10px}.body p{color:#64748b;line-height:1.7}.footer{background:#111827;color:white;padding:40px 18px}.preview{position:fixed;right:16px;bottom:16px;background:#f59e0b;padding:9px 14px;border-radius:999px;font-weight:bold}.apply{margin-top:10px;border:1px solid #d1d5db;border-radius:8px;padding:10px}@@media(max-width:800px){.menus{display:none}.grid{grid-template-columns:1fr}.banner h1{font-size:32px}}</style></head><body><div id="app"></div>@if(Model.IsPreview){<div class="preview">预览模式</div>}<script>const cfg=@Html.Raw(pageJson);const site=@Html.Raw(JsonConvert.SerializeObject(Model.SiteConfig));const news=@Html.Raw(JsonConvert.SerializeObject(Model.News));const products=@Html.Raw(JsonConvert.SerializeObject(Model.Products));const jobs=@Html.Raw(JsonConvert.SerializeObject(Model.Jobs));let navData=[],bannerData=[],footerData=null;function g(o,k){return o?.[k]??o?.[k.charAt(0).toUpperCase()+k.slice(1)]}function h(s){return String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}function safe(s){return String(s??'').replace(/<script[\s\S]*?>[\s\S]*?<\/script>/gi,'')}function wp(p){if(!p||p==='/')return'/website';if(/^https?:/i.test(p))return p;return'/website'+(String(p).startsWith('/')?p:'/'+p)}function comps(){return Array.isArray(cfg.components)?cfg.components:(Array.isArray(cfg)?cfg:[])}function secStyle(c){let s=c.style||{};return`background:${s.backgroundColor||'#fff'};padding-top:${s.paddingTop??64}px;padding-bottom:${s.paddingBottom??64}px`}function nav(c){let p=c.props||{},ms=navData.length?navData.map(x=>({title:g(x,'title'),path:g(x,'linkUrl')||'/',target:g(x,'target')||'_self'})):(p.menus||[{title:'首页',path:'/'},{title:'关于我们',path:'/about'},{title:'产品中心',path:'/products'},{title:'新闻中心',path:'/news'},{title:'招聘中心',path:'/jobs'}]);return`<nav class="nav"><div class="navin"><a class="brand" href="/website">${h(p.siteName||g(site,'siteName')||'企业官网')}</a><div class="menus">${ms.map(m=>`<a target="${h(m.target||'_self')}" href="${wp(m.path)}">${h(m.title)}</a>`).join('')}</div></div></nav>`}function banner(c){let p=c.props||{},s=c.style||{},it=(p.items&&p.items[0])||{},b=bannerData[0]||{},img=it.image||p.image||g(b,'imageUrl')||'';let title=it.title||p.title||g(b,'title')||'',sub=it.subtitle||p.subtitle||g(b,'subtitle')||'',bt=it.buttonText||p.buttonText||g(b,'buttonText')||'',bl=it.buttonLink||p.buttonLink||g(b,'buttonLink')||'/';return`<section class="banner" style="min-height:${p.height||g(b,'height')||420}px;background-color:${s.backgroundColor||'#2563eb'};${img?`background-image:url('${h(img)}')`:''}"><div><h1>${h(title)}</h1><p>${h(sub)}</p>${bt?`<a class="btn" href="${wp(bl)}">${h(bt)}</a>`:''}</div></section>`}function rich(c){let p=c.props||{};return`<section class="sec" style="${secStyle(c)}"><div class="container"><h2 class="title">${h(p.title||c.name)}</h2><div>${safe(p.content||'')}</div></div></section>`}function list(c,data,kind){let p=c.props||{},arr=data.slice(0,Number(p.count||6));return`<section class="sec" style="${secStyle(c)}"><div class="container"><h2 class="title">${h(p.title||c.name)}</h2><div class="grid">${arr.map(x=>{let id=g(x,'id'),name=g(x,'title')||g(x,'productName')||g(x,'jobTitle')||'',sum=g(x,'summary')||g(x,'workLocation')||g(x,'department')||'',img=g(x,'coverImage')||'';let apply=kind==='job'?`<div class="apply"><input placeholder="姓名" id="n${id}"> <input placeholder="电话" id="p${id}"> <button onclick="applyJob(${id})">在线投递</button></div>`:'';return`<article class="card">${kind!=='job'?`<div class="cover" style="${img?`background-image:url('${h(img)}')`:''}">${img?'':kind.toUpperCase()}</div>`:''}<div class="body"><h3>${h(name)}</h3><p>${h(sum)}</p>${apply}</div></article>`}).join('')}</div></div></section>`}function footer(c){let p=Object.assign({},site||{},footerData||{},c.props||{}),s=c.style||{};let links=[];try{links=JSON.parse(g(p,'friendLinksJson')||'[]')}catch(e){}return`<footer class="footer" style="background:${g(p,'backgroundColor')||s.backgroundColor||'#111827'};color:${g(p,'textColor')||'#fff'}"><div class="container"><h2>${h(g(p,'companyName')||g(p,'siteName')||'企业官网')}</h2><p>${h(g(p,'description')||'')}</p><p>电话：${h(g(p,'tel')||'')}　邮箱：${h(g(p,'email')||'')}</p><p>${h(g(p,'address')||'')}</p>${links.length?`<p>友情链接：${links.map(x=>`<a style="margin-right:12px" href="${h(x.url)}">${h(x.title)}</a>`).join('')}</p>`:''}<p>${h(g(p,'copyright')||'')}</p></div></footer>`}function render(c){if(c.visible===false)return'';if(c.type==='navigation')return nav(c);if(c.type==='banner')return banner(c);if(c.type==='richText')return rich(c);if(c.type==='news')return list(c,news,'news');if(c.type==='product')return list(c,products,'product');if(c.type==='job')return list(c,jobs,'job');if(c.type==='footer')return footer(c);return''}async function applyJob(id){let name=document.getElementById('n'+id)?.value,phone=document.getElementById('p'+id)?.value;if(!name||!phone){alert('请填写姓名和电话');return}let r=await fetch('/api/jobs/'+id+'/apply',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({applicantName:name,phone})});alert(r.ok?'投递成功':'投递失败')}async function loadFrontData(){try{let rs=await Promise.all([fetch('/api/front/navigation'),fetch('/api/front/banners'),fetch('/api/front/footer')]);navData=await rs[0].json();bannerData=await rs[1].json();footerData=await rs[2].json()}catch(e){}}loadFrontData().then(()=>{app.innerHTML=comps().sort((a,b)=>(a.sort||0)-(b.sort||0)).map(render).join('')});</script></body></html>