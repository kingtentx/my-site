@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>产品管理</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
    <style>
        .viewimg { width: 80px; height: 60px; object-fit: cover; }
    </style>
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row layui-col-space15">
            <div class="layui-col-md12">
                <div class="layui-card">
                    <div class="layui-form layui-card-header layuiadmin-card-header-auto">
                        <div class="layui-form-item">
                            <div class="layui-inline">
                                <label class="layui-form-label">名称</label>
                                <div class="layui-input-block">
                                    <input type="text" name="keywords" placeholder="请输入" autocomplete="off" class="layui-input">
                                </div>
                            </div>
                            <div class="layui-inline">
                                <label class="layui-form-label">分类</label>
                                <div class="layui-input-block">
                                    <select name="categoryId" id="selCategory">
                                        <option value="0">全部</option>
                                    </select>
                                </div>
                            </div>
                            <div class="layui-inline">
                                <button class="layui-btn layuiadmin-btn-admin" lay-submit="" lay-filter="app-search">
                                    <i class="layui-icon layui-icon-search layuiadmin-button-btn"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="layui-card-body">
                        <div style="padding-bottom: 10px;">
                            @if ((bool)ViewData[PageCode.PAGE_Button_Add])
                            {
                                <a class="layui-btn layuiadmin-btn-admin" href="/product/edit">添加</a>
                            }
                            @if ((bool)ViewData[PageCode.PAGE_Button_Delete])
                            {
                                <button class="layui-btn layuiadmin-btn-admin" id="batchdel" data-type="batchdel">批量删除</button>
                            }
                        </div>
                        <table class="layui-hide" id="app-table" lay-filter="app-table"></table>
                        <script type="text/html" id="cover">
                            {{# if(d.coverImage){ }}
                            <img src="{{ d.coverImage }}" class="viewimg" alt="">
                            {{# } else { }}
                            <span style="color:#ccc;">无</span>
                            {{# } }}
                        </script>
                        <script type="text/html" id="active">
                            {{# if(d.isActive){ }}
                            <span class="layui-btn layui-btn-primary layui-btn-xs">上架</span>
                            {{# } else { }}
                            <span class="layui-btn layui-btn-warm layui-btn-xs">下架</span>
                            {{# } }}
                        </script>
                        <script type="text/html" id="recommend">
                            {{# if(d.isRecommend){ }}
                            <span class="layui-btn layui-btn-normal layui-btn-xs">推荐</span>
                            {{# } else { }}
                            <span class="layui-btn layui-btn-primary layui-btn-xs">-</span>
                            {{# } }}
                        </script>
                        <script type="text/html" id="app-table-bar">
                            @if ((bool)ViewData[PageCode.PAGE_Button_Edit])
                            {
                                <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="edit"><i class="layui-icon layui-icon-edit"></i>编辑</a>
                                <a class="layui-btn layui-btn-warm layui-btn-xs" lay-event="recommend"><i class="layui-icon layui-icon-star"></i>切换推荐</a>
                            }
                            @if ((bool)ViewData[PageCode.PAGE_Button_Delete])
                            {
                                <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del"><i class="layui-icon layui-icon-delete"></i>删除</a>
                            }
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['index', 'table', 'form'], function () {
            var $ = layui.$, form = layui.form, table = layui.table, layer = layui.layer;

            $.ajax({
                type: 'get', url: '@Url.Content("~")/ProductCategory/GetList', dataType: 'json',
                success: function (res) {
                    if (res.code == 200 && res.data) {
                        var html = '<option value="0">全部</option>';
                        for (var i = 0; i < res.data.length; i++) {
                            html += '<option value="' + res.data[i].id + '">' + res.data[i].name + '</option>';
                        }
                        $('#selCategory').html(html);
                        form.render('select');
                    }
                }
            });

            table.render({
                elem: '#app-table',
                url: '@Url.Content("~")/Product/GetList',
                response: { statusName: 'code', statusCode: 200, msgName: 'message', countName: 'count', dataName: 'data' },
                cols: [[
                    { type: 'checkbox' },
                    { field: 'id', width: 60, title: 'ID' },
                    { field: 'productName', title: '产品名称', minWidth: 180 },
                    { field: 'coverImage', width: 110, title: '封面', templet: '#cover' },
                    { field: 'sort', width: 80, title: '排序' },
                    { align: 'center', field: 'isRecommend', width: 90, title: '推荐', templet: '#recommend' },
                    { align: 'center', field: 'isActive', width: 90, title: '状态', templet: '#active' },
                    { field: 'viewCount', width: 90, title: '浏览量' },
                    { field: 'creationTime', width: 170, title: '创建时间' },
                    { align: 'center', width: 280, toolbar: '#app-table-bar', title: '操作' }
                ]],
                request: { pageName: 'pageIndex', limitName: 'pageSize' },
                page: true
            });

            table.on('tool(app-table)', function (obj) {
                var data = obj.data;
                if (obj.event === 'edit') {
                    window.location.href = '/product/edit/' + data.id;
                } else if (obj.event === 'recommend') {
                    var newVal = !data.isRecommend;
                    $.ajax({
                        type: 'post', url: '/Product/SetRecommend', data: { id: data.id, isRecommend: newVal }, dataType: 'json',
                        success: function (res) {
                            if (res.code == 200) { layer.msg(res.message); table.reload('app-table'); }
                            else { layer.msg(res.message, { icon: 5 }); }
                        }
                    });
                } else if (obj.event === 'del') {
                    layer.confirm('确认删除？', function (index) {
                        $.ajax({
                            type: 'post', url: '/Product/Delete', data: { 'id': data.id }, dataType: 'json',
                            success: function (res) {
                                if (res.code == 200) { layer.msg(res.message); obj.del(); layer.close(index); }
                                else { layer.msg(res.message, { icon: 5 }); }
                            }
                        });
                    });
                }
            });

            $("#batchdel").on('click', function () {
                var checkStatus = table.checkStatus('app-table');
                var checkData = checkStatus.data;
                if (checkData.length == 0) { layer.msg('批量删除至少选中一项数据'); return false; }
                layer.confirm('你确定要删除这 ' + checkData.length + ' 条数据吗？', { icon: 3, title: '提示' }, function (index) {
                    var ids = [];
                    for (var i = 0; i < checkData.length; i++) { ids.push(checkData[i].id); }
                    $.ajax({
                        type: 'post', data: { "ids": ids }, url: '/product/delete?isAll=1',
                        success: function (res) {
                            if (res.code == 200) { layer.msg(res.message); table.reload('app-table'); }
                            else { layer.msg(res.message, { icon: 5 }); }
                        }
                    });
                });
            });

            form.on('submit(app-search)', function (data) {
                table.reload('app-table', { page: { curr: 1 }, where: data.field });
            });
        });
    </script>
</body>
</html>
