@{
    Layout = null;
}
@model MySite.Web.Models.ProductModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>产品编辑</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
    <style>
        .upload-card { width: 200px; height: 120px; border: 2px dashed #d2d2d2; border-radius: 6px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; background: #f9f9f9; }
        .upload-card i { font-size: 32px; color: #c2c2c2; margin-bottom: 4px; }
        .upload-preview { width: 200px; height: 120px; border-radius: 6px; overflow: hidden; position: relative; }
        .upload-preview img { width: 100%; height: 100%; object-fit: cover; }
        .upload-preview .mask { position: absolute; inset: 0; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .2s; }
        .upload-preview:hover .mask { opacity: 1; }
        .mask .mask-btn { width: 28px; height: 28px; line-height: 28px; text-align: center; background: rgba(255,255,255,.9); border-radius: 50%; cursor: pointer; border: 0; }
        .image-list-item { display: inline-block; margin-right: 8px; margin-bottom: 8px; position: relative; }
        .image-list-item img { width: 100px; height: 80px; object-fit: cover; border-radius: 4px; }
        .image-list-item .remove { position: absolute; top: -6px; right: -6px; width: 18px; height: 18px; line-height: 18px; text-align: center; background: #ff5722; color: #fff; border-radius: 50%; cursor: pointer; font-size: 12px; }
    </style>
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">@(Model.Id > 0 ? "修改产品" : "添加产品")</div>
            <div class="layui-card-body" style="padding: 15px;">
                <form class="layui-form" lay-filter="form-group">
                    <div class="layui-form-item">
                        <label class="layui-form-label">产品名称</label>
                        <div class="layui-input-block">
                            <input type="text" name="ProductName" lay-verify="required" autocomplete="off" placeholder="产品名称" class="layui-input" value="@Html.Raw(Model.ProductName)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">分类</label>
                        <div class="layui-input-inline" style="width:240px;">
                            <select name="CategoryId" id="selCategory">
                                <option value="0">-- 请选择 --</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.Id" @Html.Raw(Model.CategoryId == cat.Id ? "selected" : "")>@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">封面图</label>
                        <div class="layui-input-block">
                            <div id="coverWrap" style="display:inline-block;">
                                @if (!string.IsNullOrWhiteSpace(Model.CoverImage))
                                {
                                    <div class="upload-preview">
                                        <img src="@Model.CoverImage" alt="封面" />
                                        <div class="mask"><button type="button" class="mask-btn" data-action="remove"><i class="layui-icon layui-icon-delete"></i></button></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="upload-card"><i class="layui-icon layui-icon-upload-drag"></i><span>选择封面图</span></div>
                                }
                            </div>
                            <input type="hidden" name="CoverImage" id="txtCover" value="@Html.Raw(Model.CoverImage)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">多图列表</label>
                        <div class="layui-input-block">
                            <div id="imageListWrap" style="display:inline-block;"></div>
                            <button type="button" class="layui-btn layui-btn-normal layui-btn-sm" id="btnAddImage"><i class="layui-icon layui-icon-addition"></i>添加图片</button>
                            <input type="hidden" name="ImageList" id="txtImageList" value="@Html.Raw(Model.ImageList)">
                        </div>
                    </div>
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">摘要</label>
                        <div class="layui-input-block">
                            <textarea name="Summary" class="layui-textarea" style="height:60px;">@Html.Raw(Model.Summary)</textarea>
                        </div>
                    </div>
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">产品详情</label>
                        <div class="layui-input-block">
                            <div id="txtDescription">@Html.Raw(Model.Description)</div>
                        </div>
                    </div>
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">产品参数</label>
                        <div class="layui-input-block">
                            <textarea name="Specification" class="layui-textarea" style="height:120px;">@Html.Raw(Model.Specification)</textarea>
                        </div>
                    </div>
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">产品特点</label>
                        <div class="layui-input-block">
                            <textarea name="Feature" class="layui-textarea" style="height:80px;">@Html.Raw(Model.Feature)</textarea>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">排序</label>
                        <div class="layui-input-inline" style="width:120px;">
                            <input type="number" name="Sort" autocomplete="off" class="layui-input" value="@Model.Sort">
                        </div>
                        <label class="layui-form-label">是否推荐</label>
                        <div class="layui-input-inline" style="width:140px;">
                            <input type="checkbox" name="IsRecommend" value="true" lay-skin="switch" lay-text="是|否" @Html.Raw(Model.IsRecommend ? " checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">是否上架</label>
                        <div class="layui-input-block">
                            <input type="radio" name="IsActive" value="true" title="上架" @Html.Raw(Model.IsActive ? " checked" : "")>
                            <input type="radio" name="IsActive" value="false" title="下架" @Html.Raw(!Model.IsActive ? " checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item layui-layout-admin">
                        <div class="layui-input-block">
                            <div class="layui-footer" style="left: 0; z-index: 20000">
                                <button class="layui-btn" lay-submit="" lay-filter="form-page">立即保存</button>
                                <a href="@Url.Content("~")/product/index" class="layui-btn layui-btn-primary">返回列表</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script src="~/resource/js/jquery-1.12.4.min.js"></script>
    <script src="~/resource/wangeditor-4.7.9/wangEditor.min.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['index', 'form'], function () {
            var $ = layui.$, form = layui.form, layer = layui.layer;

            var imageList = [];
            try { imageList = JSON.parse($('#txtImageList').val() || '[]') || []; } catch (e) { imageList = []; }
            if (typeof imageList === 'string') { try { imageList = JSON.parse(imageList); } catch (e) { imageList = []; } }

            function renderImageList() {
                var html = '';
                for (var i = 0; i < imageList.length; i++) {
                    var url = typeof imageList[i] === 'string' ? imageList[i] : (imageList[i].url || imageList[i].src || '');
                    if (!url) continue;
                    html += '<div class="image-list-item" data-idx="' + i + '"><img src="' + url + '"><span class="remove" data-action="remove-img">×</span></div>';
                }
                $('#imageListWrap').html(html);
                var urls = [];
                for (var j = 0; j < imageList.length; j++) {
                    var u = typeof imageList[j] === 'string' ? imageList[j] : (imageList[j].url || imageList[j].src || '');
                    if (u) urls.push(u);
                }
                $('#txtImageList').val(JSON.stringify(urls));
            }
            renderImageList();

            function openImageSelector(callback) {
                window._imgSelectorCallback = callback;
                layer.open({ type: 2, title: '选择图片', area: ['900px', '680px'], content: '/Admin/ImageSelector' });
            }
            window.addEventListener('message', function (e) {
                if (e.data && e.data.type === 'imageSelected' && window._imgSelectorCallback) {
                    window._imgSelectorCallback(e.data.url);
                    window._imgSelectorCallback = null;
                }
            });

            $('#coverWrap').on('click', '.upload-card, .upload-preview', function (e) {
                if ($(e.target).closest('[data-action="remove"]').length) return;
                openImageSelector(function (url) {
                    $('#coverWrap').html('<div class="upload-preview"><img src="' + url + '" alt="封面"><div class="mask"><button type="button" class="mask-btn" data-action="remove"><i class="layui-icon layui-icon-delete"></i></button></div></div>');
                    $('#txtCover').val(url);
                });
            }).on('click', '[data-action="remove"]', function () {
                layer.confirm("确认删除吗？", function (i) {
                    $('#coverWrap').html('<div class="upload-card"><i class="layui-icon layui-icon-upload-drag"></i><span>选择封面图</span></div>');
                    $('#txtCover').val('');
                    layer.close(i);
                });
            });

            $('#btnAddImage').on('click', function () {
                openImageSelector(function (url) {
                    imageList.push(url);
                    renderImageList();
                });
            });

            $('#imageListWrap').on('click', '[data-action="remove-img"]', function () {
                var idx = parseInt($(this).closest('.image-list-item').attr('data-idx'));
                imageList.splice(idx, 1);
                renderImageList();
            });

            var E = window.wangEditor;
            var editor = new E('#txtDescription');
            editor.config.uploadFileName = 'file';
            editor.config.uploadImgServer = '/Upload/UploadImage';
            editor.config.uploadImgHooks = {
                customInsert: function (insertImg, result) { if (result.url) insertImg(result.url); }
            };
            editor.create();

            form.on('submit(form-page)', function (data) {
                data.field.Description = editor.txt.html();
                $.ajax({
                    type: "post",
                    url: '/product/edit?id=@Model.Id',
                    data: data.field,
                    dataType: "json",
                    success: function (res) {
                        if (res.code == 200) {
                            layer.alert(res.message, function (index) {
                                window.location.href = '/product/index';
                                layer.close(index);
                            });
                        } else { layer.msg(res.message, { icon: 5 }); }
                    },
                    error: function () { layer.msg('保存失败', { icon: 5 }); }
                });
                return false;
            });
        });
    </script>
</body>
</html>
