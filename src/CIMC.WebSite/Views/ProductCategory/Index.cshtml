@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>产品分类管理</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row layui-col-space15">
            <div class="layui-col-md12">
                <div class="layui-card">
                    <div class="layui-card-body">
                        <div style="padding-bottom: 10px;">
                            @if ((bool)ViewData[PageCode.PAGE_Button_Add])
                            {
                                <a class="layui-btn layuiadmin-btn-admin" href="@Url.Content("~")/ProductCategory/Edit">添加分类</a>
                            }
                        </div>
                        <table id="tree-table" class="layui-table" lay-filter="tree-table"></table>
                        <script type="text/html" id="active">
                            {{# if(d.isActive){ }}
                            <span class="layui-btn layui-btn-primary layui-btn-xs">启用</span>
                            {{# } else { }}
                            <span class="layui-btn layui-btn-warm layui-btn-xs">禁用</span>
                            {{# } }}
                        </script>
                        <script type="text/html" id="tree-table-bar">
                            {{# if (d.pid === 0){ }}
                            @if ((bool)ViewData[PageCode.PAGE_Button_Add])
                            {
                                <button class="layui-btn layui-btn-normal layui-btn-xs" lay-event="addchild"><i class="layui-icon layui-icon-addition"></i>添加子分类</button>
                            }
                            {{# } }}
                            @if ((bool)ViewData[PageCode.PAGE_Button_Edit])
                            {
                                <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="edit" href="@Url.Content("~")/ProductCategory/Edit/{{=d.id}}"><i class="layui-icon layui-icon-edit"></i>编辑</a>
                            }
                            @if ((bool)ViewData[PageCode.PAGE_Button_Delete])
                            {
                                <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del"><i class="layui-icon layui-icon-delete"></i>删除</a>
                            }
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['index', 'table', 'treetable'], function () {
            var $ = layui.$, layer = layui.layer, table = layui.table, treetable = layui.treetable;

            $.ajax({
                type: 'get', url: '@Url.Content("~")/ProductCategory/GetList', dataType: 'json',
                success: function (res) { renderTable(res.data); }
            });

            var renderTable = function (data) {
                layer.load(2);
                treetable.render({
                    treeColIndex: 0, treeSpid: 0, treeIdName: 'id', treePidName: 'pid',
                    treeDefaultClose: false, treeLinkage: false,
                    elem: '#tree-table', data: data, page: false,
                    cols: [[
                        { field: 'name', width: 280, title: '分类名称' },
                        { field: 'sort', width: 100, title: '排序' },
                        { align: 'center', field: 'isActive', width: 100, title: '状态', templet: '#active' },
                        { align: 'center', width: 280, title: '操作', toolbar: '#tree-table-bar' }
                    ]],
                    done: function () { layer.closeAll('loading'); }
                });
            };

            table.on("tool(tree-table)", function (obj) {
                var data = obj.data;
                if (obj.event === "del") {
                    layer.confirm("确认删除?", function (index) {
                        var loading = layer.load(1, { shade: 0.3 });
                        $.ajax({
                            url: "@Url.Content("~")/ProductCategory/Delete", data: { 'id': data.id }, type: "post", dataType: "json",
                            success: function (res) {
                                layer.close(loading);
                                if (res.code == 200) { layer.msg(res.message); layer.close(index); location.reload(); }
                                else { layer.msg(res.message); }
                            },
                            error: function () { layer.close(loading); }
                        });
                    });
                } else if (obj.event === 'addchild') {
                    window.location.href = '@Url.Content("~")/ProductCategory/Edit?pid=' + data.id;
                }
            });
        });
    </script>
</body>
</html>
