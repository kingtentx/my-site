@{
    Layout = null;
    var pageKey = (ViewData["PageKey"] as string) ?? "home";
    var navigationId = Convert.ToInt32(ViewData["NavigationId"] ?? 0);
    var navigationOptions = ViewData["NavigationOptions"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>可视化页面设计器</title>
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
    <style>
        body{background:#f3f5f8}.designer{padding:14px}.topbar,.panel{background:#fff;border-radius:10px;box-shadow:0 2px 10px rgba(15,23,42,.06)}
        .topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;margin-bottom:12px}.topbar-left{display:flex;align-items:center;gap:12px}
        .layout{display:grid;grid-template-columns:260px 1fr 360px;gap:12px}.panel-hd{padding:14px 16px;border-bottom:1px solid #edf0f5;font-weight:600}.panel-bd{padding:14px}
        .component{border:1px solid #e7ebf1;border-radius:8px;padding:12px;margin-bottom:10px;background:#fbfcff;cursor:grab}.component:hover{border-color:#16baaa}
        #canvas{min-height:610px;padding:16px;border:1px dashed #cbd5e1;border-radius:10px;background:#fbfdff}.empty{height:220px;display:flex;align-items:center;justify-content:center;color:#94a3b8;text-align:center;line-height:1.8;border:1px dashed #d6dee9;border-radius:10px}
        .module{position:relative;padding:14px 12px 14px 44px;margin-bottom:10px;background:#fff;border:1px solid #e2e8f0;border-radius:10px;box-shadow:0 4px 14px rgba(15,23,42,.06);cursor:pointer}
        .module.sel{border-color:#16baaa;box-shadow:0 0 0 3px rgba(22,186,170,.12)}.module.off{opacity:.55}.drag{position:absolute;left:14px;top:16px;color:#94a3b8;cursor:move}.module h3{margin:0 0 8px;font-size:16px}.module p{margin:0;color:#64748b}
        .actions{margin-top:10px}.prop-empty{height:260px;display:flex;align-items:center;justify-content:center;color:#94a3b8;text-align:center;line-height:1.8}.json{font-family:Consolas,'Courier New',monospace;min-height:150px!important}
        .preview{margin-top:12px;border:1px solid #e5e7eb;border-radius:8px;background:#fafafa;padding:12px;max-height:260px;overflow:auto}.preview-item{padding:10px;border-radius:8px;background:#fff;margin-bottom:8px;border:1px solid #eee}
        @@media(max-width:1200px){.layout{grid-template-columns:220px 1fr}.right{grid-column:1/3}}
    </style>
</head>
<body>
<div class="designer layui-form">
    <div class="topbar">
        <div class="topbar-left">
            <label>页面</label>
            <select id="pageKeySelect" lay-filter="pageKeySelect">
                <option value="home" @Html.Raw(pageKey=="home"?"selected":"")>首页</option>
                <option value="products" @Html.Raw(pageKey=="products"?"selected":"")>产品中心</option>
                <option value="news" @Html.Raw(pageKey=="news"?"selected":"")>新闻资讯</option>
                <option value="jobs" @Html.Raw(pageKey=="jobs"?"selected":"")>人才招聘</option>
                <option value="about" @Html.Raw(pageKey=="about"?"selected":"")>关于我们</option>
                <option value="contact" @Html.Raw(pageKey=="contact"?"selected":"")>联系我们</option>
            </select>
            <label>导航</label>
            <select id="navigationSelect" lay-filter="navigationSelect">
                @foreach (var option in navigationOptions)
                {
                    <option value="@option.Value" @Html.Raw(navigationId.ToString()==option.Value?"selected":"")>@option.Text</option>
                }
            </select>
        </div>
        <div>
            <button type="button" class="layui-btn layui-btn-primary" id="btnReload">重新加载</button>
            <button type="button" class="layui-btn layui-btn-normal" id="btnDefault">生成首页模板</button>
            <button type="button" class="layui-btn" id="btnSave">保存配置</button>
            <a class="layui-btn layui-btn-primary" href="/SiteModule/Index@(navigationId > 0 ? "?navigationId=" + navigationId : "")">返回列表</a>
        </div>
    </div>

    <div class="layout">
        <div class="panel">
            <div class="panel-hd">组件库</div>
            <div class="panel-bd" id="palette"></div>
        </div>
        <div class="panel">
            <div class="panel-hd">页面画布 <span class="layui-badge-rim" id="count">0</span></div>
            <div class="panel-bd"><div id="canvas"></div></div>
        </div>
        <div class="panel right">
            <div class="panel-hd">属性配置</div>
            <div class="panel-bd">
                <div id="props"></div>
                <div class="preview" id="preview"></div>
            </div>
        </div>
    </div>
</div>

<script src="~/resource/layuiadmin/layui/layui.js"></script>
<script src="~/resource/js/Sortable.min.js"></script>
<script>
layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['form'], function () {
    var $ = layui.$, form = layui.form;
    var pageKey = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(pageKey));
    var navigationId = @navigationId;
    var templates = [], modules = [], selected = -1, canvasSortable, paletteSortable;

    function esc(v){ return $('<div>').text(v == null ? '' : v).html(); }
    function tpl(key){ return templates.find(function(x){ return x.key === key; }) || { key:key, name:key, type:'section', defaultSettings:{} }; }
    function splitImages(v){ return (v || '').split(/[\n,;]+/).map(function(x){ return $.trim(x); }).filter(Boolean); }
    function copy(o){ return JSON.parse(JSON.stringify(o || {})); }
    function parseJson(v){ try { return JSON.parse(v || '{}'); } catch(e){ layer.msg('JSON格式错误：' + e.message, {icon:5}); return null; } }

    function newModule(key){
        var t = tpl(key);
        return {
            id:0,pageKey:pageKey,moduleKey:t.key,moduleName:t.name,moduleName_EN:'',moduleType:t.type,
            title:t.name,title_EN:'',subTitle:t.description || '',subTitle_EN:'',linkUrl:'',
            imageUrl:'',images:[],navigationId:navigationId>0?navigationId:null,isActive:true,
            settings:copy(t.defaultSettings),settings_EN:{}
        };
    }

    function renderPalette(){
        $('#palette').html(templates.map(function(t){
            return '<div class="component" data-key="'+t.key+'"><b><i class="layui-icon '+(t.icon||'layui-icon-template')+'"></i> '+esc(t.name)+'</b><p>'+esc(t.description||'')+'</p></div>';
        }).join(''));
        if(paletteSortable) paletteSortable.destroy();
        paletteSortable = new Sortable(document.getElementById('palette'), { group:{name:'designer',pull:'clone',put:false}, sort:false, animation:150 });
    }

    function renderCanvas(){
        $('#count').text(modules.length + ' 个模块');
        if(!modules.length){
            $('#canvas').html('<div class="empty">从左侧拖入组件<br/>或点击“生成首页模板”</div>');
            renderProps(); renderPreview(); return;
        }
        $('#canvas').html(modules.map(function(m,i){
            return '<div class="module '+(selected===i?'sel ':'')+(!m.isActive?'off':'')+'" data-index="'+i+'">'
                +'<i class="layui-icon layui-icon-more-vertical drag"></i><h3>'+esc(m.title||m.moduleName||m.moduleKey)+'</h3>'
                +'<p>组件：'+esc(m.moduleKey)+' ｜ 类型：'+esc(m.moduleType)+'</p>'
                +'<div class="actions"><button type="button" class="layui-btn layui-btn-xs layui-btn-primary" data-act="copy">复制</button> '
                +'<button type="button" class="layui-btn layui-btn-xs layui-btn-warm" data-act="toggle">'+(m.isActive?'停用':'启用')+'</button> '
                +'<button type="button" class="layui-btn layui-btn-xs layui-btn-danger" data-act="remove">删除</button></div></div>';
        }).join(''));
        if(canvasSortable) canvasSortable.destroy();
        canvasSortable = new Sortable(document.getElementById('canvas'), {
            group:'designer', animation:150, handle:'.drag',
            onAdd:function(evt){ var key=$(evt.item).attr('data-key'); $(evt.item).remove(); if(key){ modules.splice(evt.newIndex,0,newModule(key)); selected=evt.newIndex; renderAll(); } },
            onEnd:function(){ var arr=[]; $('#canvas .module').each(function(){ arr.push(modules[parseInt($(this).attr('data-index'))]); }); if(arr.length===modules.length){ modules=arr; renderAll(); } }
        });
    }

    function renderProps(){
        var m = modules[selected];
        if(!m){ $('#props').html('<div class="prop-empty">请选择画布中的模块</div>'); return; }
        $('#props').html(
            '<div class="layui-form-item"><label class="layui-form-label">后台名称</label><div class="layui-input-block"><input class="layui-input" data-f="moduleName" value="'+esc(m.moduleName)+'"></div></div>'
            +'<div class="layui-form-item"><label class="layui-form-label">标题</label><div class="layui-input-block"><input class="layui-input" data-f="title" value="'+esc(m.title)+'"></div></div>'
            +'<div class="layui-form-item"><label class="layui-form-label">标题EN</label><div class="layui-input-block"><input class="layui-input" data-f="title_EN" value="'+esc(m.title_EN)+'"></div></div>'
            +'<div class="layui-form-item"><label class="layui-form-label">副标题</label><div class="layui-input-block"><textarea class="layui-textarea" data-f="subTitle">'+esc(m.subTitle)+'</textarea></div></div>'
            +'<div class="layui-form-item"><label class="layui-form-label">链接</label><div class="layui-input-block"><input class="layui-input" data-f="linkUrl" value="'+esc(m.linkUrl)+'" placeholder="/contact 或 https://..."></div></div>'
            +'<div class="layui-form-item"><label class="layui-form-label">图片</label><div class="layui-input-block"><textarea class="layui-textarea" id="imgs" placeholder="一行一个图片地址">'+esc((m.images&&m.images.length?m.images:splitImages(m.imageUrl)).join('\n'))+'</textarea></div></div>'
            +'<div class="layui-form-item"><label class="layui-form-label">JSON</label><div class="layui-input-block"><textarea class="layui-textarea json" id="json">'+esc(JSON.stringify(m.settings||{},null,2))+'</textarea><button type="button" class="layui-btn layui-btn-sm" id="applyJson" style="margin-top:8px">应用JSON</button></div></div>'
            +'<div class="layui-form-item"><label class="layui-form-label">启用</label><div class="layui-input-block"><input type="checkbox" id="active" lay-skin="switch" lay-text="启用|停用" '+(m.isActive?'checked':'')+'></div></div>'
        );
        form.render();

        $('#props [data-f]').on('input', function(){ modules[selected][$(this).data('f')]=$(this).val(); renderCanvas(); renderPreview(); renderProps(); });
        $('#imgs').on('input', function(){ var imgs=splitImages($(this).val()); modules[selected].images=imgs; modules[selected].imageUrl=imgs.join(','); renderPreview(); });
        $('#applyJson').on('click', function(){ var obj=parseJson($('#json').val()); if(obj){ modules[selected].settings=obj; layer.msg('已应用', {icon:1}); renderPreview(); } });
        form.on('switch', function(data){ if($(data.elem).attr('id')==='active' && modules[selected]){ modules[selected].isActive=data.elem.checked; renderAll(); } });
    }

    function renderPreview(){
        $('#preview').html(modules.filter(function(m){return m.isActive;}).map(function(m){
            return '<div class="preview-item"><b>'+esc(m.title||m.moduleName)+'</b><p>'+esc(m.subTitle||tpl(m.moduleKey).description||'')+'</p></div>';
        }).join('') || '<div style="color:#94a3b8;text-align:center;padding:30px 0">暂无预览</div>');
    }

    function renderAll(){ renderCanvas(); renderProps(); renderPreview(); }

    function load(){
        pageKey = $('#pageKeySelect').val() || 'home';
        navigationId = parseInt($('#navigationSelect').val() || '0');
        $.get('/SiteModule/GetDesignerData', { pageKey:pageKey, navigationId:navigationId }, function(res){
            if(res.code == 200){
                templates = res.data.templates || [];
                modules = (res.data.modules || []).map(function(m){
                    return {
                        id:m.id||0,pageKey:m.pageKey||pageKey,moduleKey:m.moduleKey,moduleName:m.moduleName,moduleName_EN:m.moduleName_EN,moduleType:m.moduleType||tpl(m.moduleKey).type,
                        title:m.title,title_EN:m.title_EN,subTitle:m.subTitle,subTitle_EN:m.subTitle_EN,linkUrl:m.linkUrl,imageUrl:m.imageUrl,
                        images:m.images||[],navigationId:m.navigationId,isActive:m.isActive===true||m.isActive==='true',settings:m.settings||{},settings_EN:m.settings_EN||{}
                    };
                });
                selected = modules.length ? 0 : -1;
                renderPalette(); renderAll();
            } else { layer.msg(res.message || '加载失败', {icon:5}); }
        });
    }

    function save(){
        $.ajax({
            url:'/SiteModule/SaveDesigner', type:'POST', contentType:'application/json',
            data:JSON.stringify({ pageKey:pageKey, navigationId:navigationId>0?navigationId:null, modules:modules }),
            success:function(res){ if(res.code==200){ layer.msg(res.message||'保存成功',{icon:1}); load(); } else { layer.msg(res.message||'保存失败',{icon:5}); } },
            error:function(){ layer.msg('请求失败，请检查登录状态或服务器日志',{icon:5}); }
        });
    }

    $('#canvas').on('click','.module',function(e){
        var i=parseInt($(this).attr('data-index')), act=$(e.target).closest('[data-act]').data('act');
        if(act==='copy'){ var c=copy(modules[i]); c.id=0; c.moduleName=(c.moduleName||c.moduleKey)+' - 复制'; modules.splice(i+1,0,c); selected=i+1; renderAll(); return; }
        if(act==='toggle'){ modules[i].isActive=!modules[i].isActive; selected=i; renderAll(); return; }
        if(act==='remove'){ layer.confirm('确认移除此模块？保存后将删除配置。',function(idx){ modules.splice(i,1); selected=modules.length?Math.min(i,modules.length-1):-1; layer.close(idx); renderAll(); }); return; }
        selected=i; renderAll();
    });

    form.on('select(pageKeySelect)', function(){ $('#navigationSelect').val('0'); form.render('select'); load(); });
    form.on('select(navigationSelect)', load);
    $('#btnReload').on('click', load);
    $('#btnDefault').on('click', function(){ modules=['hero','products','about','partners','news','careers','cta'].map(newModule); selected=0; renderAll(); });
    $('#btnSave').on('click', save);
    load();
});
</script>
</body>
</html>