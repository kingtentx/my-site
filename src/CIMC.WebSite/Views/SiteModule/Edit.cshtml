@model SiteModule
@{
    Layout = null;
    var linkOptions = ViewData["LinkOptions"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var moduleOptions = ViewData["ModuleOptions"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var navigationOptions = ViewData["NavigationOptions"] as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var linkEnabled = !string.IsNullOrWhiteSpace(Model.LinkUrl);
    var bannerImages = (Model.ImageUrl ?? string.Empty)
        .Split(new[] { ',', ';', '\r', '\n' }, System.StringSplitOptions.RemoveEmptyEntries)
        .Select(p => p.Trim())
        .Where(p => !string.IsNullOrWhiteSpace(p))
        .ToList();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>页面模块编辑</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
    <style>
        .banner-upload-area {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            align-items: flex-start;
        }

        .banner-upload-card {
            width: 200px;
            height: 120px;
            border: 2px dashed #d2d2d2;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            background: #f9f9f9;
            transition: all .25s;
            position: relative;
            overflow: hidden;
        }

        .banner-upload-card:hover {
            border-color: #009688;
            background: #f0faf8;
        }

        .banner-upload-card i {
            font-size: 32px;
            color: #c2c2c2;
            margin-bottom: 6px;
            transition: color .25s;
        }

        .banner-upload-card:hover i {
            color: #009688;
        }

        .banner-upload-card span {
            font-size: 13px;
            color: #999;
        }

        .banner-preview {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin-top: 0;
        }

        .banner-preview__item {
            position: relative;
            width: 200px;
            height: 120px;
            border-radius: 6px;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,.12);
            transition: transform .2s;
        }

        .banner-preview__item:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0,0,0,.18);
        }

        .banner-preview__item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .banner-preview__item .banner-mask {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background .2s;
            opacity: 0;
        }

        .banner-preview__item:hover .banner-mask {
            background: rgba(0,0,0,.45);
            opacity: 1;
        }

        .banner-mask .mask-btn {
            width: 32px;
            height: 32px;
            line-height: 32px;
            text-align: center;
            background: rgba(255,255,255,.9);
            border-radius: 50%;
            cursor: pointer;
            color: #666;
            font-size: 16px;
            transition: all .2s;
        }

        .banner-mask .mask-btn:hover {
            background: #fff;
            color: #ff5722;
        }

        .banner-mask .mask-btn.mask-btn-view:hover {
            color: #009688;
        }

        .banner-sort-tip {
            color: #999;
            font-size: 13px;
            margin-top: 8px;
            line-height: 1.6;
        }

        .banner-preview__item.sortable-chosen {
            opacity: .6;
            box-shadow: 0 0 0 2px #009688;
        }

        .banner-preview__item.sortable-ghost {
            opacity: .3;
        }

        .icon-eye {
            display: inline-block;
            width: 16px;
            height: 11px;
            position: relative;
        }

        .icon-eye::before {
            content: '';
            position: absolute;
            inset: 0;
            border: 2px solid currentColor;
            border-radius: 50%;
        }

        .icon-eye::after {
            content: '';
            position: absolute;
            width: 6px;
            height: 6px;
            background: currentColor;
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        #settingsJson {
            font-family: 'Courier New', Courier, monospace;
            min-height: 200px;
            width: 100%;
            resize: vertical;
        }

        .json-editor-actions {
            margin-top: 8px;
            display: flex;
            gap: 8px;
        }
    </style>
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">@(Model.Id > 0 ? "修改页面配置" : "添加页面配置")</div>
            <div class="layui-card-body" style="padding: 15px;">
                <form class="layui-form">
                    <input type="hidden" name="NavigationId" id="navigationId" value="@Model.NavigationId">
                    <div class="layui-form-item">
                        <label class="layui-form-label">所属页面</label>
                        <div class="layui-input-inline">
                            <select name="PageKey" lay-verify="required">
                                <option value="home" @Html.Raw(Model.PageKey == "home" ? "selected" : "")>首页</option>
                                <option value="products" @Html.Raw(Model.PageKey == "products" ? "selected" : "")>产品中心</option>
                                <option value="news" @Html.Raw(Model.PageKey == "news" ? "selected" : "")>新闻资讯</option>
                                <option value="jobs" @Html.Raw(Model.PageKey == "jobs" ? "selected" : "")>人才招聘</option>
                                <option value="about" @Html.Raw(Model.PageKey == "about" ? "selected" : "")>关于我们</option>
                                <option value="contact" @Html.Raw(Model.PageKey == "contact" ? "selected" : "")>联系我们</option>
                            </select>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">模块位置</label>
                        <div class="layui-input-inline">
                            <select name="ModuleKey" id="moduleKeySelect" lay-verify="required">
                                @foreach (var option in moduleOptions)
                                {
                                    <option value="@option.Value" @Html.Raw(Model.ModuleKey == option.Value ? "selected" : "")>@option.Text</option>
                                }
                            </select>
                        </div>
                        <div class="layui-form-mid layui-word-aux">选择这个配置控制前台哪个区域</div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">后台名称</label>
                        <div class="layui-input-block">
                            <input type="text" name="ModuleName" placeholder="可选，留空时自动使用模块位置名称" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.ModuleName)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">排序</label>
                        <div class="layui-input-inline">
                            <input type="number" name="Sort" autocomplete="off" class="layui-input" value="@Model.Sort">
                        </div>
                        <input type="hidden" name="ModuleType" id="moduleType" value="@Html.Raw(Model.ModuleType)">
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">前台标题</label>
                        <div class="layui-input-block">
                            <input type="text" name="Title" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.Title)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">前台标题(EN)</label>
                        <div class="layui-input-block">
                            <input type="text" name="Title_EN" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.Title_EN)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">副标题/说明</label>
                        <div class="layui-input-block">
                            <textarea name="SubTitle" class="layui-textarea">@Html.Raw(Model.SubTitle)</textarea>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">副标题/说明(EN)</label>
                        <div class="layui-input-block">
                            <textarea name="SubTitle_EN" class="layui-textarea">@Html.Raw(Model.SubTitle_EN)</textarea>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">启用链接</label>
                        <div class="layui-input-inline">
                            <input type="checkbox" name="EnableLink" value="true" lay-skin="switch" lay-text="启用|关闭" @(linkEnabled ? "checked" : "")>
                        </div>
                        <label class="layui-form-label">站内链接</label>
                        <div class="layui-input-inline w300" id="linkSelectWrap">
                            <select name="LinkUrl">
                                @foreach (var option in linkOptions)
                                {
                                    <option value="@option.Value" @Html.Raw(Model.LinkUrl == option.Value ? "selected" : "")>@option.Text</option>
                                }
                            </select>
                        </div>
                        <div class="layui-form-mid layui-word-aux">关闭链接后，前台按钮不会显示</div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">关联导航</label>
                        <div class="layui-input-inline w300">
                            <select name="NavigationId" id="navigationSelect" lay-filter="navigationSelect">
                                <option value="0">无</option>
                                @foreach (var option in navigationOptions)
                                {
                                    <option value="@option.Value" @Html.Raw(Model.NavigationId.ToString() == option.Value ? "selected" : "")>@option.Text</option>
                                }
                            </select>
                        </div>
                        <div class="layui-form-mid layui-word-aux">选择此模块关联的前台导航菜单</div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">Banner图片</label>
                        <div class="layui-input-block">
                            <div class="banner-upload-area" id="bannerUploadArea">
                                @foreach (var image in bannerImages)
                                {
                                    <div class="banner-preview__item" data-url="@image">
                                        <img src="@image" alt="Banner图片" />
                                        <div class="banner-mask">
                                            <span class="mask-btn mask-btn-view" data-action="view" title="查看大图"><i class="icon-eye"></i></span>
                                            <span class="mask-btn" data-action="remove" title="删除"><i class="layui-icon layui-icon-delete"></i></span>
                                        </div>
                                    </div>
                                }
                                <div class="banner-upload-card" id="bannerUploadBtn">
                                    <i class="layui-icon layui-icon-upload-drag"></i>
                                    <span>点击或拖拽上传</span>
                                </div>
                                <a class="layui-btn layui-btn-sm layui-btn-normal" id="btnSelectFromLib" style="margin-top:8px;"><i class="layui-icon layui-icon-picture"></i>从素材库选择</a>
                            </div>
                            <input type="hidden" name="ImageUrl" id="txtImageUrl" value="@Html.Raw(Model.ImageUrl)">
                            <div class="banner-sort-tip">支持 JPG/PNG/GIF，可上传多张图片，前台 Banner 将按此顺序轮播展示。拖拽图片可调整顺序。</div>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">扩展配置(JSON)</label>
                        <div class="layui-input-block">
                            <textarea name="SettingsJson" id="settingsJson" class="layui-textarea">@Html.Raw(Model.SettingsJson)</textarea>
                            <div class="json-editor-actions">
                                <button type="button" class="layui-btn layui-btn-sm" id="btnFormatJson">格式化</button>
                                <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnValidateJson">验证</button>
                            </div>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">扩展配置(EN)</label>
                        <div class="layui-input-block">
                            <textarea name="SettingsJson_EN" id="settingsJsonEN" class="layui-textarea">@Html.Raw(Model.SettingsJson_EN)</textarea>
                            <div class="json-editor-actions">
                                <button type="button" class="layui-btn layui-btn-sm" id="btnFormatJsonEN">格式化</button>
                                <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnValidateJsonEN">验证</button>
                            </div>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">是否启用</label>
                        <div class="layui-input-block">
                            <input type="radio" name="IsActive" value="true" title="是" @Html.Raw(Model.IsActive ? "checked" : "")>
                            <input type="radio" name="IsActive" value="false" title="否" @Html.Raw(!Model.IsActive ? "checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item layui-layout-admin">
                        <div class="layui-input-block">
                            <div class="layui-footer" style="left: 0; z-index: 20000">
                                <button class="layui-btn" lay-submit lay-filter="form-page">立即保存</button>
                                <a href="/SiteModule/Index@(Model.NavigationId > 0 ? "?navigationId=" + Model.NavigationId : (Context.Request.Query["navigationId"].ToString().Length > 0 ? "?navigationId=" + Context.Request.Query["navigationId"] : ""))" class="layui-btn layui-btn-primary">返回列表</a>
                                <a href="/Navigation/Index" class="layui-btn layui-btn-primary">返回导航</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script src="~/resource/js/Sortable.min.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['form', 'upload'], function () {
            var $ = layui.$, form = layui.form, upload = layui.upload;
            var moduleTypes = {
                hero: 'banner',
                banner: 'banner',
                certificates: 'carousel',
                message: 'form',
                products: 'section',
                about: 'section',
                partners: 'section',
                news: 'section',
                careers: 'section'
            };

            function syncModuleType() {
                var key = $('#moduleKeySelect').val();
                $('#moduleType').val(moduleTypes[key] || 'section');
            }

            $('#moduleKeySelect').on('change', syncModuleType);
            syncModuleType();

            function syncImages() {
                var urls = [];
                $('#bannerUploadArea .banner-preview__item').each(function () {
                    urls.push($(this).attr('data-url'));
                });
                $('#txtImageUrl').val(urls.join(','));
            }

            new Sortable(document.getElementById('bannerUploadArea'), {
                animation: 150,
                handle: '.banner-preview__item',
                draggable: '.banner-preview__item',
                filter: '.banner-upload-card',
                onEnd: function () {
                    syncImages();
                }
            });

            upload.render({
                elem: '#bannerUploadBtn',
                acceptMime: 'image/*',
                exts: 'jpg|jpeg|png|gif',
                url: '/Upload/UploadImage',
                multiple: true,
                auto: true,
                done: function (res) {
                    var itemHtml = '<div class="banner-preview__item" data-url="' + res.url + '">'
                        + '<img src="' + res.url + '" alt="Banner图片">'
                        + '<div class="banner-mask">'
                        + '<span class="mask-btn mask-btn-view" data-action="view" title="查看大图"><i class="icon-eye"></i></span>'
                        + '<span class="mask-btn" data-action="remove" title="删除"><i class="layui-icon layui-icon-delete"></i></span>'
                        + '</div></div>';
                    $('#bannerUploadBtn').before(itemHtml);
                    syncImages();
                    layer.msg('图片上传成功', { icon: 1 });
                }
            });

            $('#btnSelectFromLib').on('click', function () {
                layer.open({
                    type: 2,
                    title: '选择图片',
                    area: ['900px', '680px'],
                    content: '/Admin/ImageSelector',
                    end: function () { }
                });
            });

            window.addEventListener('message', function (e) {
                if (e.data && e.data.type === 'imageSelected') {
                    var url = e.data.url;
                    var itemHtml = '<div class="banner-preview__item" data-url="' + url + '">'
                        + '<img src="' + url + '" alt="Banner图片">'
                        + '<div class="banner-mask">'
                        + '<span class="mask-btn mask-btn-view" data-action="view" title="查看大图"><i class="icon-eye"></i></span>'
                        + '<span class="mask-btn" data-action="remove" title="删除"><i class="layui-icon layui-icon-delete"></i></span>'
                        + '</div></div>';
                    $('#bannerUploadBtn').before(itemHtml);
                    syncImages();
                }
            });

            $('#bannerUploadArea').on('click', '[data-action="remove"]', function () {
                $(this).closest('.banner-preview__item').remove();
                syncImages();
            }).on('click', '[data-action="view"]', function () {
                var url = $(this).closest('.banner-preview__item').attr('data-url');
                layer.photos({ photos: { data: [{ src: url }] }, anim: 5 });
            });

            $('#btnFormatJson').on('click', function () {
                var val = $('#settingsJson').val().trim();
                if (!val) return;
                try {
                    var obj = JSON.parse(val);
                    $('#settingsJson').val(JSON.stringify(obj, null, 4));
                    layer.msg('格式化成功', { icon: 1 });
                } catch (e) {
                    layer.msg('JSON格式错误：' + e.message, { icon: 5 });
                }
            });

            $('#btnValidateJson').on('click', function () {
                var val = $('#settingsJson').val().trim();
                if (!val) {
                    layer.msg('内容为空', { icon: 0 });
                    return;
                }
                try {
                    JSON.parse(val);
                    layer.msg('JSON格式正确', { icon: 1 });
                } catch (e) {
                    layer.msg('JSON格式错误：' + e.message, { icon: 5 });
                }
            });

            $('#btnFormatJsonEN').on('click', function () {
                var val = $('#settingsJsonEN').val().trim();
                if (!val) return;
                try {
                    var obj = JSON.parse(val);
                    $('#settingsJsonEN').val(JSON.stringify(obj, null, 4));
                    layer.msg('格式化成功', { icon: 1 });
                } catch (e) {
                    layer.msg('JSON格式错误：' + e.message, { icon: 5 });
                }
            });

            $('#btnValidateJsonEN').on('click', function () {
                var val = $('#settingsJsonEN').val().trim();
                if (!val) {
                    layer.msg('内容为空', { icon: 0 });
                    return;
                }
                try {
                    JSON.parse(val);
                    layer.msg('JSON格式正确', { icon: 1 });
                } catch (e) {
                    layer.msg('JSON格式错误：' + e.message, { icon: 5 });
                }
            });

            form.on('select(navigationSelect)', function (data) {
                $('#navigationId').val(data.value);
            });

            form.on('submit(form-page)', function (data) {
                syncImages();
                syncModuleType();
                data.field.ImageUrl = $('#txtImageUrl').val();
                data.field.NavigationId = $('#navigationSelect').val();
                if (data.field.EnableLink !== 'true') {
                    data.field.LinkUrl = '';
                }
                $.post('/SiteModule/Edit/@Model.Id', data.field, function (res) {
                    if (res.code == 200) {
                        layer.alert(res.message, function () {
                            var backUrl = '/SiteModule/Index';
                            var navId = @(Model.NavigationId ?? 0);
                            if (navId > 0) {
                                backUrl += '?navigationId=' + navId;
                            } else {
                                var navIdParam = '@(Context.Request.Query["navigationId"].ToString())';
                                if (navIdParam.length > 0) {
                                    backUrl += '?navigationId=' + navIdParam;
                                }
                            }
                            window.location.href = backUrl;
                        });
                    } else {
                        layer.msg(res.message, { icon: 5 });
                    }
                });
                return false;
            });
        });
    </script>
</body>
</html>
