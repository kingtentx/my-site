@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>页面配置</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-form layui-card-header layuiadmin-card-header-auto">
                <div class="layui-inline">
                    <label class="layui-form-label">页面</label>
                    <div class="layui-input-block" style="width:120px">
                        <select name="pageKey">
                            <option value="">全部</option>
                            <option value="home">首页</option>
                            <option value="products">产品中心</option>
                            <option value="news">新闻资讯</option>
                            <option value="jobs">人才招聘</option>
                            <option value="about">关于我们</option>
                            <option value="contact">联系我们</option>
                        </select>
                    </div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">关键词</label>
                    <div class="layui-input-block">
                        <input type="text" name="keywords" placeholder="后台名称/前台标题" autocomplete="off" class="layui-input">
                    </div>
                </div>
                <div class="layui-inline">
                    <button class="layui-btn layuiadmin-btn-admin" lay-submit lay-filter="app-search">
                        <i class="layui-icon layui-icon-search layuiadmin-button-btn"></i>
                    </button>
                </div>
            </div>
            <div class="layui-card-body">
                <div style="padding-bottom: 10px;">
                    @if ((bool)ViewData[PageCode.PAGE_Button_Add])
                    {
                        <a class="layui-btn layui-btn-sm layuiadmin-btn-admin" href="/SiteModule/Edit@(Context.Request.Query["navigationId"].ToString().Length > 0 ? "?navigationId=" + Context.Request.Query["navigationId"] : "")">添加模块</a>
                    }
                    @if ((bool)ViewData[PageCode.PAGE_Button_Edit])
                    {
                        <a class="layui-btn layui-btn-sm layui-btn-normal" href="/SiteModule/Designer@(Context.Request.Query["navigationId"].ToString().Length > 0 ? "?navigationId=" + Context.Request.Query["navigationId"] : "")"><i class="layui-icon layui-icon-template-1"></i>可视化设计</a>
                    }
                    <a class="layui-btn layui-btn-sm layui-btn-primary" href="/SiteModule/Designer?pageKey=home"><i class="layui-icon layui-icon-home"></i>设计首页</a>
                    <a class="layui-btn layui-btn-sm layui-btn-normal" href="/Navigation/Index"><i class="layui-icon layui-icon-return"></i>返回导航</a>
                </div>
                <table class="layui-hide" id="app-table" lay-filter="app-table"></table>
                <script type="text/html" id="status">
                    {{# if(d.isActive === true){ }}
                    <span class="layui-btn layui-btn-primary layui-btn-xs">启用</span>
                    {{# } else { }}
                    <span class="layui-btn layui-btn-warm layui-btn-xs">停用</span>
                    {{# } }}
                </script>
                <script type="text/html" id="module-position">
                    {{# var names = { hero: '首页Banner', products: '首页-产品服务', about: '首页-企业介绍', partners: '首页-合作客户', news: '首页-新闻资讯', careers: '首页-人才招聘', banner: '内页Banner', certificates: '资质证书', message: '在线留言', 'rich-text': '富文本内容', 'feature-grid': '能力宫格', 'image-text': '图文介绍', stats: '数据指标', cta: '行动号召' }; }}
                    {{ names[d.moduleKey] || d.moduleKey }}
                </script>
                <script type="text/html" id="app-table-bar">
                    @if ((bool)ViewData[PageCode.PAGE_Button_Edit])
                    {
                        <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="edit"><i class="layui-icon layui-icon-edit"></i>编辑</a>
                    }
                    @if ((bool)ViewData[PageCode.PAGE_Button_Delete])
                    {
                        <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del"><i class="layui-icon layui-icon-delete"></i>删除</a>
                    }
                </script>
            </div>
        </div>
    </div>
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['table', 'form'], function () {
            var $ = layui.$, table = layui.table, form = layui.form;
            var navId = '@(Context.Request.Query["navigationId"].ToString())';
            var isFiltered = navId.length > 0;
            var defaultWhere = isFiltered ? { navigationId: navId } : {};

            var dataTable = table.render({
                elem: '#app-table',
                url: '/SiteModule/GetList',
                where: defaultWhere,
                response: { statusName: 'code', statusCode: '200 ', msgName: 'message', countName: 'count', dataName: 'data' },
                cols: [[
                    { field: 'id', width: 70, title: 'ID' },
                    { field: 'pageKey', width: 100, title: '页面' },
                    { field: 'moduleKey', width: 150, title: '模块位置', templet: '#module-position' },
                    { field: 'moduleName', width: 170, title: '后台名称' },
                    { field: 'title', title: '前台标题' },
                    { field: 'sort', width: 80, title: '排序' },
                    { field: 'isActive', width: 90, title: '状态', templet: '#status' },
                    { align: 'center', width: 180, toolbar: '#app-table-bar' }
                ]],
                request: { pageName: 'pageIndex', limitName: 'pageSize' },
                page: true
            });

            table.on('tool(app-table)', function (obj) {
                if (obj.event === 'edit') {
                    window.location.href = '/SiteModule/Edit/' + obj.data.id;
                }
                if (obj.event === 'del') {
                    layer.confirm('确认删除?', function (index) {
                        $.post('/SiteModule/Delete', { id: obj.data.id }, function (res) {
                            if (res.code == 200) {
                                obj.del();
                                layer.close(index);
                            }
                            layer.msg(res.message);
                        });
                    });
                }
            });

            form.on('submit(app-search)', function (data) {
                var where = data.field;
                if (isFiltered) {
                    where.navigationId = navId;
                }
                dataTable.reload({ where: where, page: { curr: 1 } });
                return false;
            });
        });
    </script>
</body>
</html>