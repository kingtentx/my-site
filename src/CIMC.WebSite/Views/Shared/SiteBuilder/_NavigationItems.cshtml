@using System.Collections.Generic
@model List<MySite.Web.Models.NavigationModel>
@foreach (var item in Model ?? new List<MySite.Web.Models.NavigationModel>())
{
    <div class="sb-public-nav-item @(item.IsCurrent ? "is-current" : "")">
        <a href="@(string.IsNullOrWhiteSpace(item.Path) ? "#" : item.Path)" target="@(item.Target == 1 ? "_blank" : "_self")">
            @if (!string.IsNullOrWhiteSpace(item.Icon))
            {
                <i class="layui-icon @item.Icon"></i>
            }
            <span>@item.Title</span>
        </a>
        @if (item.Children != null && item.Children.Count > 0)
        {
            <div class="sb-public-subnav">
                @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_NavigationItems.cshtml", item.Children)
            </div>
        }
    </div>
}
