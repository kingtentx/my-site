@model MySite.Web.Models.PageRenderModel
@{
    var designWidth = 1200;
    if (Model?.Document?.Settings != null && Model.Document.Settings.TryGetValue("designWidth", out var configuredWidth)
        && int.TryParse(configuredWidth?.ToString(), out var parsedWidth)
        && (parsedWidth == 1200 || parsedWidth == 1440 || parsedWidth == 1920))
    {
        designWidth = parsedWidth;
    }
    var fullWidth = Model?.Document?.Settings != null && Model.Document.Settings.TryGetValue("fullWidth", out var configuredFullWidth) && bool.TryParse(configuredFullWidth?.ToString(), out var parsedFullWidth) && parsedFullWidth;
}
<div class="sb-runtime" data-builder-document data-design-width="@designWidth" data-full-width="@fullWidth.ToString().ToLowerInvariant()" style="--sb-design-width:@(designWidth)px;max-width:@(fullWidth ? "none" : designWidth + "px");margin-left:auto;margin-right:auto">
@if (Model?.Document?.Nodes != null)
{
    foreach (var node in Model.Document.Nodes)
    {
        if (node == null || !node.Visible) { continue; }
        @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Node.cshtml", new MySite.Web.Models.BuilderNodeRenderModel { Node = node, Page = Model })
    }
}
</div>
