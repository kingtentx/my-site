@using CIMC.Data
@using CIMC.EntityFramework
@using System
@using System.Collections
@using System.Collections.Generic
@using System.Linq
@using System.Net
@model MySite.Web.Models.BuilderNodeRenderModel
@inject IRepository<Product> ProductRepository
@inject IRepository<Tag> CategoryRepository
@{
    var props = Model.Node.Props ?? new Dictionary<string, object>();
    int GetInt(string key, int fallback) => props.TryGetValue(key, out var value) && value != null && int.TryParse(value.ToString(), out var number) ? number : fallback;
    bool GetBool(string key, bool fallback) => props.TryGetValue(key, out var value) && value != null && bool.TryParse(value.ToString(), out var result) ? result : fallback;
    var pageSize = Math.Max(1, Math.Min(100, GetInt("pageSize", 8)));
    var columns = Math.Max(1, Math.Min(6, GetInt("columns", 4)));
    var showSummary = GetBool("showSummary", false);
    var showTabs = GetBool("showTabs", true);
    var enablePagination = GetBool("enablePagination", true);
    string GetString(string key, string fallback) => props.TryGetValue(key, out var value) && value != null && !string.IsNullOrWhiteSpace(value.ToString()) ? value.ToString().Trim() : fallback;

    // ── 分类 Tab 排列展示样式（取值与 default-components.js 的 TAB_*_OPTIONS 一致）──
    var tabStyles = new[] { "pill", "underline", "segmented", "card", "plain" };
    var tabAligns = new[] { "left", "center", "right" };
    var tabStyle = GetString("tabStyle", "pill").ToLowerInvariant();
    if (!tabStyles.Contains(tabStyle)) tabStyle = "pill";
    var tabAlign = GetString("tabAlign", "left").ToLowerInvariant();
    if (!tabAligns.Contains(tabAlign)) tabAlign = "left";
    var tabClass = "sb-content-tabs is-tab-" + tabStyle + " align-" + tabAlign;
    var selectedIds = new List<int>();
    if (props.TryGetValue("categoryIds", out var idsObj) && idsObj != null)
    {
        if (idsObj is string idsText)
        {
            foreach (var part in idsText.Split(new[] { ',', '，', ';', '；', ' ' }, StringSplitOptions.RemoveEmptyEntries))
                if (int.TryParse(part.Trim(), out var parsed) && parsed > 0 && !selectedIds.Contains(parsed)) selectedIds.Add(parsed);
        }
        else if (idsObj is IEnumerable idsSeq)
        {
            foreach (var item in idsSeq)
                if (item != null && int.TryParse(item.ToString(), out var parsed) && parsed > 0 && !selectedIds.Contains(parsed)) selectedIds.Add(parsed);
        }
    }
    var activeProducts = ProductRepository.GetList(p => !p.IsDelete && p.IsActive, p => p.Sort, true).ToList();
    var tabs = new List<Tag>();
    if (showTabs)
    {
        if (selectedIds.Count > 1)
        {
            foreach (var id in selectedIds)
            {
                var category = CategoryRepository.GetOne(id);
                if (category != null && category.IsActive && category.TagType == (int)CIMC.Core.Enums.TagType.Product) tabs.Add(category);
            }
        }
        else if (selectedIds.Count == 0)
        {
            var used = activeProducts.Select(p => p.TagId).Where(v => v > 0).Distinct().ToHashSet();
            tabs = CategoryRepository.GetList(p => p.IsActive && p.TagType == (int)CIMC.Core.Enums.TagType.Product, p => p.Sort, true).Where(p => used.Contains(p.Id)).ToList();
        }
    }
    var request = ViewContext.HttpContext.Request;
    var nodeKey = new string((Model.Node.Id ?? "products").Where(char.IsLetterOrDigit).ToArray());
    var pageKey = "page_" + nodeKey;
    var catKey = "cat_" + nodeKey;
    var activeCat = int.TryParse(request.Query[catKey].ToString(), out var requestedCat) ? Math.Max(0, requestedCat) : 0;
    if (activeCat > 0 && !tabs.Any(t => t.Id == activeCat)) activeCat = 0;
    var filterIds = activeCat > 0 ? new List<int> { activeCat } : selectedIds;
    var allItems = activeProducts.Where(p => filterIds.Count == 0 || filterIds.Contains(p.TagId)).ToList();
    var current = int.TryParse(request.Query[pageKey].ToString(), out var requested) ? Math.Max(1, requested) : 1;
    var pages = Math.Max(1, (int)Math.Ceiling(allItems.Count / (double)pageSize));
    current = Math.Min(current, pages);
    var items = allItems.Skip((current - 1) * pageSize).Take(pageSize).ToList();
    var basePath = $"{request.PathBase}{request.Path}";
    string TabUrl(int categoryId)
    {
        var parts = new List<string>();
        foreach (var pair in request.Query)
        {
            if (string.Equals(pair.Key, pageKey, StringComparison.OrdinalIgnoreCase) || string.Equals(pair.Key, catKey, StringComparison.OrdinalIgnoreCase)) continue;
            foreach (var value in pair.Value) parts.Add(WebUtility.UrlEncode(pair.Key) + "=" + WebUtility.UrlEncode(value));
        }
        if (categoryId > 0) parts.Add(WebUtility.UrlEncode(catKey) + "=" + categoryId);
        return parts.Count == 0 ? basePath : basePath + "?" + string.Join("&", parts);
    }
    string PageUrl(int number)
    {
        var parts = new List<string>();
        foreach (var pair in request.Query)
        {
            if (string.Equals(pair.Key, pageKey, StringComparison.OrdinalIgnoreCase) || string.Equals(pair.Key, catKey, StringComparison.OrdinalIgnoreCase)) continue;
            foreach (var value in pair.Value) parts.Add(WebUtility.UrlEncode(pair.Key) + "=" + WebUtility.UrlEncode(value));
        }
        if (activeCat > 0) parts.Add(WebUtility.UrlEncode(catKey) + "=" + activeCat);
        parts.Add(WebUtility.UrlEncode(pageKey) + "=" + number);
        return basePath + "?" + string.Join("&", parts);
    }
}
<div class="sb-content-list" sb-effects="@Model.Node.Style" style="@Model.RenderedStyle" data-builder-id="@Model.Node.Id">
    @if (tabs.Count > 0)
    {
        <div class="@tabClass" role="tablist">
            <a class="sb-content-tab@(activeCat == 0 ? " is-active" : "")" href="@TabUrl(0)" role="tab" aria-selected="@(activeCat == 0 ? "true" : "false")">全部</a>
            @foreach (var tab in tabs)
            {
                <a class="sb-content-tab@(activeCat == tab.Id ? " is-active" : "")" href="@TabUrl(tab.Id)" role="tab" aria-selected="@(activeCat == tab.Id ? "true" : "false")">@tab.TagName</a>
            }
        </div>
    }
    @if (items.Count == 0) { <p class="sb-empty">暂无产品</p> }
    else
    {
        <div class="sb-product-grid" style="--sb-cols:@columns">
            @foreach (var item in items)
            {
                <article class="sb-content-card"><a href="/products/detail-@(item.Id).html">@if(!string.IsNullOrWhiteSpace(item.ImageUrl)){<img src="@item.ImageUrl" alt="@item.Title" loading="lazy" />}<div class="sb-content-card-body"><h3>@item.Title</h3>@if(showSummary && !string.IsNullOrWhiteSpace(item.Description)){<p>@item.Description</p>}</div></a></article>
            }
        </div>
        @if (enablePagination && pages > 1)
        {
            <nav class="component-pagination" aria-label="产品分页">@if(current > 1){<a href="@PageUrl(current - 1)">上一页</a>}@for(var i=1;i<=pages;i++){if(i==current){<span class="active">@i</span>}else{<a href="@PageUrl(i)">@i</a>}}@if(current < pages){<a href="@PageUrl(current + 1)">下一页</a>}</nav>
        }
    }
</div>
