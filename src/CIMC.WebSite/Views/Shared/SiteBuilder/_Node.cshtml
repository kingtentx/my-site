@using System
@using System.Collections.Generic
@using System.Linq
@using Newtonsoft.Json.Linq
@model MySite.Web.Models.BuilderNodeRenderModel
@{
    var node = Model.Node;
    var props = node.Props ?? new Dictionary<string, object>();
    var style = node.Style ?? new Dictionary<string, object>();

    string Prop(string key, string fallback = "")
    {
        return props.TryGetValue(key, out var value) && value != null ? value.ToString() : fallback;
    }
    int IntProp(string key, int fallback)
    {
        return props.TryGetValue(key, out var value) && value != null && int.TryParse(value.ToString(), out var number) ? number : fallback;
    }
    bool BoolProp(string key, bool fallback)
    {
        return props.TryGetValue(key, out var value) && value != null && bool.TryParse(value.ToString(), out var result) ? result : fallback;
    }
    List<string> StringListProp(string key)
    {
        if (!props.TryGetValue(key, out var value) || value == null) return new List<string>();
        if (value is JArray array)
        {
            return array.Select(x => x?.ToString()).Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
        }
        if (value is IEnumerable<string> strings)
        {
            return strings.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
        }
        if (value is string text && !string.IsNullOrWhiteSpace(text))
        {
            try
            {
                var parsed = JArray.Parse(text);
                return parsed.Select(x => x?.ToString()).Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
            }
            catch { }
        }
        return new List<string>();
    }
    string SafeUrl(string value)
    {
        value = (value ?? "").Trim();
        return value.StartsWith("javascript:", StringComparison.OrdinalIgnoreCase) || value.StartsWith("vbscript:", StringComparison.OrdinalIgnoreCase) || value.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ? "" : value;
    }
    string StyleText()
    {
        var map = new Dictionary<string,string>
        {
            {"paddingTop","padding-top"},{"paddingRight","padding-right"},{"paddingBottom","padding-bottom"},{"paddingLeft","padding-left"},
            {"marginTop","margin-top"},{"marginRight","margin-right"},{"marginBottom","margin-bottom"},{"marginLeft","margin-left"},
            {"backgroundColor","background-color"},{"color","color"},{"maxWidth","max-width"},{"width","width"},{"minHeight","min-height"},
            {"gap","gap"},{"borderRadius","border-radius"},{"textAlign","text-align"},{"borderTopWidth","border-top-width"},
            {"borderTopStyle","border-top-style"},{"borderTopColor","border-top-color"},{"position","position"},{"top","top"},
            {"zIndex","z-index"},{"boxShadow","box-shadow"}
        };
        return string.Join(";", map.Where(pair => style.ContainsKey(pair.Key) && style[pair.Key] != null && !string.IsNullOrWhiteSpace(style[pair.Key].ToString())).Select(pair => pair.Value + ":" + style[pair.Key]));
    }
    var css = StyleText();
    var children = node.Children ?? new List<MySite.Web.Models.BuilderNodeModel>();
}
@if (!node.Visible)
{
    return;
}

@if (node.Type == "section")
{
    <section class="sb-public-section" style="@css" data-builder-id="@node.Id">
        @foreach (var child in children) { @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Node.cshtml", new MySite.Web.Models.BuilderNodeRenderModel { Node = child, Page = Model.Page }) }
    </section>
}
else if (node.Type == "container")
{
    <div class="sb-public-container" style="@css" data-builder-id="@node.Id">
        @foreach (var child in children) { @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Node.cshtml", new MySite.Web.Models.BuilderNodeRenderModel { Node = child, Page = Model.Page }) }
    </div>
}
else if (node.Type == "grid")
{
    var columns = Math.Max(1, Math.Min(6, IntProp("columns", 2)));
    <div class="sb-public-grid" style="grid-template-columns:repeat(@columns,minmax(0,1fr));@css" data-builder-id="@node.Id">
        @foreach (var child in children) { @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Node.cshtml", new MySite.Web.Models.BuilderNodeRenderModel { Node = child, Page = Model.Page }) }
    </div>
}
else if (node.Type == "column")
{
    <div class="sb-public-column" style="@css" data-builder-id="@node.Id">
        @foreach (var child in children) { @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Node.cshtml", new MySite.Web.Models.BuilderNodeRenderModel { Node = child, Page = Model.Page }) }
    </div>
}
else if (node.Type == "heading")
{
    var text = Prop("text", "标题"); var level = Math.Max(1, Math.Min(4, IntProp("level", 2)));
    if (level == 1) { <h1 class="sb-heading" style="@css">@text</h1> }
    else if (level == 2) { <h2 class="sb-heading" style="@css">@text</h2> }
    else if (level == 3) { <h3 class="sb-heading" style="@css">@text</h3> }
    else { <h4 class="sb-heading" style="@css">@text</h4> }
}
else if (node.Type == "text")
{
    <p class="sb-text" style="@css">@Prop("text", "文本内容")</p>
}
else if (node.Type == "image")
{
    var src = SafeUrl(Prop("src")); var link = SafeUrl(Prop("link"));
    if (!string.IsNullOrWhiteSpace(src))
    {
        if (!string.IsNullOrWhiteSpace(link)) { <a href="@link"><img class="sb-image" style="@css" src="@src" alt="@Prop("alt")" loading="lazy" /></a> }
        else { <img class="sb-image" style="@css" src="@src" alt="@Prop("alt")" loading="lazy" /> }
    }
}
else if (node.Type == "banner")
{
    var images = StringListProp("images").Select(SafeUrl).Where(x => !string.IsNullOrWhiteSpace(x)).Take(30).ToList();
    var height = Math.Max(120, Math.Min(900, IntProp("height", 420)));
    var interval = Math.Max(1000, Math.Min(30000, IntProp("interval", 5000)));
    var fit = Prop("objectFit", "cover") == "contain" ? "contain" : "cover";
    var showArrows = BoolProp("showArrows", true);
    var showDots = BoolProp("showDots", true);
    if (images.Count > 0)
    {
        <div class="banner sb-public-banner" data-banner data-autoplay="@(images.Count > 1 ? "true" : "false")" data-interval="@interval" style="height:@(height)px;@css" data-builder-id="@node.Id">
            <div class="banner-slides">
                @for (var i = 0; i < images.Count; i++)
                {
                    <div class="banner-slide @(i == 0 ? "active" : "")">
                        <img src="@images[i]" alt="Banner @(i + 1)" loading="@(i == 0 ? "eager" : "lazy")" style="width:100%;height:100%;object-fit:@fit" />
                    </div>
                }
            </div>
            @if (images.Count > 1 && showArrows)
            {
                <button type="button" class="banner-arrow prev" data-banner-prev aria-label="上一张">‹</button>
                <button type="button" class="banner-arrow next" data-banner-next aria-label="下一张">›</button>
            }
            @if (images.Count > 1 && showDots)
            {
                <div class="banner-dots" data-banner-dots>
                    @for (var i = 0; i < images.Count; i++)
                    {
                        <span class="banner-dot @(i == 0 ? "active" : "")"></span>
                    }
                </div>
            }
        </div>
    }
}
else if (node.Type == "button")
{
    var href = SafeUrl(Prop("href", "#")); var target = Prop("target", "_self") == "_blank" ? "_blank" : "_self"; var variant = Prop("variant", "primary");
    <a class="sb-public-button sb-public-button-@variant" href="@href" target="@target" style="@css">@Prop("text", "按钮")</a>
}
else if (node.Type == "icon")
{
    <span class="sb-public-icon" style="font-size:@(Math.Max(12, Math.Min(160, IntProp("size",32))))px;@css">@Prop("text", "★")</span>
}
else if (node.Type == "video")
{
    var src = SafeUrl(Prop("src")); var poster = SafeUrl(Prop("poster")); var controls = BoolProp("controls", true);
    if (!string.IsNullOrWhiteSpace(src))
    {
        if (controls) { <video class="sb-public-video" style="@css" src="@src" poster="@poster" controls></video> }
        else { <video class="sb-public-video" style="@css" src="@src" poster="@poster"></video> }
    }
}
else if (node.Type == "divider")
{
    <hr class="sb-public-divider" style="@css" />
}
else if (node.Type == "spacer")
{
    <div aria-hidden="true" style="height:@(Math.Max(4, Math.Min(400, IntProp("height",40))))px;@css"></div>
}
else if (node.Type == "logo")
{
    var src = SafeUrl(Prop("src")); var href = SafeUrl(Prop("href", "/"));
    <a class="sb-public-logo" href="@href" style="@css">@if (!string.IsNullOrWhiteSpace(src)) { <img src="@src" alt="@Prop("text","Logo")" /> } else { <strong>@Prop("text","企业名称")</strong> }</a>
}
else if (node.Type == "navigation")
{
    var nav = Model.Page?.Navigation ?? new List<MySite.Web.Models.NavigationModel>();
    var vertical = Prop("direction", "horizontal") == "vertical";
    <nav class="sb-public-nav @(vertical ? "is-vertical" : "is-horizontal")" style="@css">
        @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_NavigationItems.cshtml", nav)
    </nav>
}
else if (node.Type == "search")
{
    <form class="sb-public-search" action="@SafeUrl(Prop("action","/search"))" method="get" style="@css"><input name="q" placeholder="@Prop("placeholder","搜索")" /><button type="submit" aria-label="搜索">⌕</button></form>
}
else if (node.Type == "language")
{
    <span class="sb-public-language" style="@css">@Prop("text","中文 / EN")</span>
}
else if (node.Type == "contact")
{
    <div class="sb-public-contact" style="@css">@if(!string.IsNullOrWhiteSpace(Prop("phone"))){<div>@Prop("phone")</div>}@if(!string.IsNullOrWhiteSpace(Prop("email"))){<div>@Prop("email")</div>}@if(!string.IsNullOrWhiteSpace(Prop("address"))){<div>@Prop("address")</div>}</div>
}
else if (node.Type == "social")
{
    <div class="sb-public-social" style="@css"><strong>@Prop("text","关注我们")</strong><div>@Prop("links")</div></div>
}
else if (node.Type == "copyright")
{
    <div class="sb-public-copyright" style="@css">@Prop("text","版权信息")</div>
}
else if (node.Type == "articleList")
{
    @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_ArticleList.cshtml", Model)
}
else if (node.Type == "productList")
{
    @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_ProductList.cshtml", Model)
}
else if (node.Type == "jobList")
{
    @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_JobList.cshtml", Model)
}
