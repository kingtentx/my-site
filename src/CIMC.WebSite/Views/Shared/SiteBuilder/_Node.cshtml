@using System
@using System.Collections.Generic
@using System.Linq
@using System.Globalization
@using Newtonsoft.Json.Linq
@model MySite.Web.Models.BuilderNodeRenderModel
@inject CIMC.EntityFramework.IRepository<CIMC.Data.WebsitePage> LinkPageRepository
@{
    var node = Model.Node;
    var props = node.Props ?? new Dictionary<string, object>();
    var style = node.Style ?? new Dictionary<string, object>();

    string Prop(string key, string fallback = "")
    {
        return props.TryGetValue(key, out var value) && value != null ? value.ToString() : fallback;
    }
    int IntProp(string key, int fallback)
    {
        return props.TryGetValue(key, out var value) && value != null && int.TryParse(value.ToString(), out var number) ? number : fallback;
    }
    bool BoolProp(string key, bool fallback)
    {
        return props.TryGetValue(key, out var value) && value != null && bool.TryParse(value.ToString(), out var result) ? result : fallback;
    }
    Dictionary<string, object> EffectsProp(string key)
    {
        if (!props.TryGetValue(key, out var value) || value == null) return new Dictionary<string, object>();
        return value is JObject json ? json.ToObject<Dictionary<string, object>>() : value as Dictionary<string, object> ?? new Dictionary<string, object>();
    }
    string LinkProp(string key) => MySite.Web.Common.BuilderLinkHelper.Resolve(props.TryGetValue(key, out var value) ? value : null, LinkPageRepository);
    // 文本/标题换行方式白名单：auto（默认，自适应所在元素宽度）/ nowrap（超出省略）/ break（强制断行）。
    // 取值与 default-components.js 的 TEXT_WRAP_OPTIONS、designer-renderer.js 的 TEXT_WRAPS 保持一致。
    string TextWrapClass()
    {
        var wrap = (Prop("textWrap", "auto") ?? "auto").Trim().ToLowerInvariant();
        return new[] { "auto", "nowrap", "break" }.Contains(wrap) ? "is-wrap-" + wrap : "is-wrap-auto";
    }
    List<string> StringListProp(string key)
    {
        if (!props.TryGetValue(key, out var value) || value == null) return new List<string>();
        if (value is JArray array)
        {
            return array.Select(x => x?.ToString()).Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
        }
        if (value is IEnumerable<string> strings)
        {
            return strings.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
        }
        if (value is string text && !string.IsNullOrWhiteSpace(text))
        {
            try
            {
                var parsed = JArray.Parse(text);
                return parsed.Select(x => x?.ToString()).Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
            }
            catch { }
        }
        return new List<string>();
    }
    string SafeUrl(string value)
    {
        value = (value ?? "").Trim();
        return value.StartsWith("javascript:", StringComparison.OrdinalIgnoreCase) || value.StartsWith("vbscript:", StringComparison.OrdinalIgnoreCase) || value.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ? "" : value;
    }
    string BgColorWithOpacity(string raw, string opacityRaw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return raw;
        // bgOpacity 0~1：仅对 #rgb/#rrggbb 背景色生效，转成 rgba；缺省/1/非法值原样返回
        if (!string.IsNullOrWhiteSpace(opacityRaw)
            && double.TryParse(opacityRaw, NumberStyles.Float, CultureInfo.InvariantCulture, out var op)
            && double.IsFinite(op) && op >= 0 && op < 1)
        {
            var hex = raw.Trim();
            if (hex.StartsWith("#"))
            {
                var h = hex.Substring(1);
                if (h.Length == 3) h = string.Concat(h.Select(c => new string(c, 2)));
                if (h.Length == 6
                    && byte.TryParse(h.Substring(0, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var r)
                    && byte.TryParse(h.Substring(2, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var g)
                    && byte.TryParse(h.Substring(4, 2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var b))
                {
                    return "rgba(" + r + "," + g + "," + b + "," + op.ToString("0.##", CultureInfo.InvariantCulture) + ")";
                }
            }
        }
        return raw;
    }
    string StyleText()
    {
        var map = new Dictionary<string,string>
        {
            {"paddingTop","padding-top"},{"paddingRight","padding-right"},{"paddingBottom","padding-bottom"},{"paddingLeft","padding-left"},
            {"marginTop","margin-top"},{"marginRight","margin-right"},{"marginBottom","margin-bottom"},{"marginLeft","margin-left"},
            {"color","color"},{"maxWidth","max-width"},{"width","width"},{"minHeight","min-height"},
            {"gap","gap"},{"borderWidth","border-width"},{"borderStyle","border-style"},{"borderColor","border-color"},{"borderRadius","border-radius"},{"textAlign","text-align"},{"borderTopWidth","border-top-width"},
            {"borderTopStyle","border-top-style"},{"borderTopColor","border-top-color"},{"position","position"},{"top","top"},
            {"zIndex","z-index"},{"boxShadow","box-shadow"},{"fontSize","font-size"},{"fontWeight","font-weight"},
            {"lineHeight","line-height"},{"letterSpacing","letter-spacing"},{"alignItems","align-items"},{"height","height"},{"objectFit","object-fit"}
        };
        var parts = map.Where(pair => style.ContainsKey(pair.Key) && style[pair.Key] != null && !string.IsNullOrWhiteSpace(style[pair.Key].ToString())).Select(pair => pair.Value + ":" + style[pair.Key]).ToList();
        // 背景色放最前，结合 bgOpacity 输出 rgba
        if (style.TryGetValue("backgroundColor", out var bgColor) && bgColor != null && !string.IsNullOrWhiteSpace(bgColor.ToString()))
        {
            var bgOpacity = style.TryGetValue("bgOpacity", out var bgo) ? bgo?.ToString() : null;
            parts.Insert(0, "background-color:" + BgColorWithOpacity(bgColor.ToString(), bgOpacity));
        }
        return string.Join(";", parts);
    }
    var css = StyleText();
    if (style.TryGetValue("backgroundImage", out var backgroundImage))
    {
        var url = SafeUrl(backgroundImage?.ToString()).Replace("\\", "%5C").Replace("\"", "%22").Replace("'", "%27").Replace("(", "%28").Replace(")", "%29");
        var shade = style.TryGetValue("backgroundOverlay", out var overlay) && double.TryParse(overlay?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var opacity) && double.IsFinite(opacity) ? Math.Clamp(opacity, 0, 1) : 0;
        if (!string.IsNullOrEmpty(url)) css += $";background-image:linear-gradient(rgba(0,0,0,{shade.ToString(CultureInfo.InvariantCulture)}),rgba(0,0,0,{shade.ToString(CultureInfo.InvariantCulture)})),url(\"{url}\");background-size:cover;background-position:center";
    }
    Model.RenderedStyle = css;
    var children = node.Children ?? new List<MySite.Web.Models.BuilderNodeModel>();
}
@if (!node.Visible)
{
    return;
}

@if (node.Type == "section")
{
    <section class="sb-public-section" sb-effects="@style" style="@css" data-builder-id="@node.Id">
        @foreach (var child in children) { @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Node.cshtml", new MySite.Web.Models.BuilderNodeRenderModel { Node = child, Page = Model.Page }) }
    </section>
}
else if (node.Type == "container")
{
    <div class="sb-public-container" sb-effects="@style" style="@css" data-builder-id="@node.Id">
        @foreach (var child in children) { @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Node.cshtml", new MySite.Web.Models.BuilderNodeRenderModel { Node = child, Page = Model.Page }) }
    </div>
}
else if (node.Type == "grid")
{
    var columns = children.Count > 0 ? Math.Max(1, Math.Min(6, children.Count)) : Math.Max(1, Math.Min(6, IntProp("columns", 2)));
    var weights = StringListProp("columnWidths")
        .Select(x => double.TryParse(x, NumberStyles.Float, CultureInfo.InvariantCulture, out var width) && double.IsFinite(width) ? width : 0)
        .Where(x => x > 0)
        .ToList();
    if (weights.Count != columns)
    {
        weights = Enumerable.Repeat(100d, columns).ToList();
    }
    var gridTemplate = string.Join(" ", weights.Select(x => Math.Max(1, x).ToString(CultureInfo.InvariantCulture) + "fr"));
    <div sb-effects="@style" class="sb-public-grid" style="grid-template-columns:@gridTemplate;@css" data-builder-id="@node.Id">
        @foreach (var child in children) { @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Node.cshtml", new MySite.Web.Models.BuilderNodeRenderModel { Node = child, Page = Model.Page }) }
    </div>
}
else if (node.Type == "column")
{
    <div class="sb-public-column" sb-effects="@style" style="@css" data-builder-id="@node.Id">
        @foreach (var child in children) { @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Node.cshtml", new MySite.Web.Models.BuilderNodeRenderModel { Node = child, Page = Model.Page }) }
    </div>
}
else if (node.Type == "heading")
{
    var text = Prop("text", "标题"); var level = Math.Max(1, Math.Min(4, IntProp("level", 2)));
    var headWrap = TextWrapClass();
    if (level == 1) { <h1 class="sb-heading @headWrap" sb-effects="@style" style="@css">@text</h1> }
    else if (level == 2) { <h2 class="sb-heading @headWrap" sb-effects="@style" style="@css">@text</h2> }
    else if (level == 3) { <h3 class="sb-heading @headWrap" sb-effects="@style" style="@css">@text</h3> }
    else { <h4 class="sb-heading @headWrap" sb-effects="@style" style="@css">@text</h4> }
}
else if (node.Type == "text")
{
    // 先 HTML 编码再换行转换：字面 \n 与真实换行都渲染成 <br/>，避免电话等长文本挤成一坨
    var textHtml = Html.Encode(Prop("text", "文本内容"))
        .Replace("\\n", "\n")
        .Replace("\r\n", "\n").Replace("\r", "\n")
        .Replace("\n", "<br/>");
    <div class="sb-text @TextWrapClass()" sb-effects="@style" style="@css">@Html.Raw(textHtml)</div>
}
else if (node.Type == "richText")
{
    <div class="sb-richtext">@Html.Raw(MySite.Web.Common.RichTextSanitizer.Sanitize(Prop("html")))</div>
}
else if (node.Type == "image")
{
    var src = SafeUrl(Prop("src")); var link = SafeUrl(Prop("link"));
    if (!string.IsNullOrWhiteSpace(src))
    {
        if (!string.IsNullOrWhiteSpace(link)) { <a href="@link" sb-effects="@style"><img class="sb-image" style="@css" src="@src" alt="@Prop("alt")" loading="lazy" /></a> }
        else { <img class="sb-image" sb-effects="@style" style="@css" src="@src" alt="@Prop("alt")" loading="lazy" /> }
    }
}
else if (node.Type == "banner")
{
    var images = StringListProp("images").Select(SafeUrl).Where(x => !string.IsNullOrWhiteSpace(x)).Take(30).ToList();
    var height = Math.Max(120, Math.Min(900, IntProp("height", 420)));
    var interval = Math.Max(1000, Math.Min(30000, IntProp("interval", 5000)));
    var fit = Prop("objectFit", "cover") == "contain" ? "contain" : "cover";
    var showArrows = BoolProp("showArrows", true);
    var showDots = BoolProp("showDots", true);
    if (images.Count > 0)
    {
        <div sb-effects="@style" class="banner sb-public-banner" data-banner data-autoplay="@(images.Count > 1 ? "true" : "false")" data-interval="@interval" style="height:@(height)px;@css" data-builder-id="@node.Id">
            <div class="banner-slides">
                @for (var i = 0; i < images.Count; i++)
                {
                    <div class="banner-slide @(i == 0 ? "active" : "")">
                        <img src="@images[i]" alt="Banner @(i + 1)" loading="@(i == 0 ? "eager" : "lazy")" style="width:100%;height:100%;object-fit:@fit" />
                    </div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Prop("title")) || !string.IsNullOrWhiteSpace(Prop("description")) || !string.IsNullOrWhiteSpace(Prop("buttonText")))
            {
                <div class="sb-banner-shade"></div>
                <div class="sb-banner-copy">
                    <h1 data-banner-part="title" sb-effects="@EffectsProp("titleEffects")">@Prop("title")</h1>
                    <p data-banner-part="description" sb-effects="@EffectsProp("descriptionEffects")">@Prop("description")</p>
                    @if(!string.IsNullOrWhiteSpace(Prop("buttonText")))
                    {
                        <a class="sb-public-button" data-banner-part="button" sb-effects="@EffectsProp("buttonEffects")" href="@LinkProp("buttonLink")" target="@(Prop("buttonTarget") == "_blank" ? "_blank" : "_self")" rel="noopener noreferrer">@Prop("buttonText")</a>
                    }
                </div>
            }
            @if (images.Count > 1 && showArrows)
            {
                <button type="button" class="banner-arrow prev" data-banner-prev aria-label="上一张">‹</button>
                <button type="button" class="banner-arrow next" data-banner-next aria-label="下一张">›</button>
            }
            @if (images.Count > 1 && showDots)
            {
                <div class="banner-dots" data-banner-dots>
                    @for (var i = 0; i < images.Count; i++)
                    {
                        <button type="button" class="banner-dot @(i == 0 ? "active" : "")" aria-label="切换到第 @(i + 1) 张"></button>
                    }
                </div>
            }
        </div>
    }
}
else if (node.Type == "button")
{
    var href = LinkProp("link"); var target = Prop("target", "_self") == "_blank" ? "_blank" : "_self"; var variant = Prop("variant", "primary");
    <a class="sb-public-button sb-public-button-@variant" href="@href" target="@target" rel="noopener noreferrer" sb-effects="@style" style="@css">@Prop("text", "按钮")</a>
}
else if (node.Type == "icon")
{
    <span sb-effects="@style" class="sb-public-icon" style="font-size:@(Math.Max(12, Math.Min(160, IntProp("size",32))))px;@css">@Prop("text", "★")</span>
}
else if (node.Type == "video")
{
    var src = SafeUrl(Prop("src")); var poster = SafeUrl(Prop("poster")); var controls = BoolProp("controls", true);
    if (!string.IsNullOrWhiteSpace(src))
    {
        if (controls) { <video class="sb-public-video" sb-effects="@style" style="@css" src="@src" poster="@poster" controls></video> }
        else { <video class="sb-public-video" sb-effects="@style" style="@css" src="@src" poster="@poster"></video> }
    }
}
else if (node.Type == "divider")
{
    <hr class="sb-public-divider" sb-effects="@style" style="@css" />
}
else if (node.Type == "spacer")
{
    <div sb-effects="@style" aria-hidden="true" style="height:@(Math.Max(4, Math.Min(400, IntProp("height",40))))px;@css"></div>
}
else if (node.Type == "logo")
{
    var src = SafeUrl(Prop("src")); var href = SafeUrl(Prop("href", "/"));
    var logoWidth = Math.Max(24, Math.Min(800, IntProp("logoWidth", 200)));
    var logoMaxHeight = Math.Max(16, Math.Min(240, IntProp("logoMaxHeight", 56)));
    <a class="sb-public-logo" href="@href" sb-effects="@style" style="@css">@if (!string.IsNullOrWhiteSpace(src)) { <img src="@src" alt="@Prop("text","Logo")" style="width:@(logoWidth)px;max-width:100%;height:auto;max-height:@(logoMaxHeight)px;object-fit:contain" /> } else { <strong>@Prop("text","企业名称")</strong> }</a>
}
else if (node.Type == "navigation")
{
    var nav = Model.Page?.Navigation ?? new List<MySite.Web.Models.NavigationModel>();
    var vertical = Prop("direction", "horizontal") == "vertical";
    var alignmentValue = Prop("alignment", "center");
    var alignment = new[] { "left", "center", "right" }.Contains(alignmentValue) ? alignmentValue : "center";
    var itemGap = Math.Max(0, Math.Min(80, IntProp("itemGap", 16)));
    var itemPaddingX = Math.Max(0, Math.Min(40, IntProp("itemPaddingX", 10)));
    var itemPaddingY = Math.Max(0, Math.Min(24, IntProp("itemPaddingY", 8)));
    var itemStyleValue = Prop("itemStyle", "underline");
    // 与 default-components.js 的 NAV_ITEM_STYLE_OPTIONS、designer-renderer.js 白名单三处同步
    var itemStyle = new[] { "underline", "pill", "block", "left-bar", "plain" }.Contains(itemStyleValue) ? itemStyleValue : "underline";
    var submenuEffectValue = Prop("submenuEffect", "slide-down");
    var submenuEffect = new[] { "slide-down", "fade", "zoom", "none" }.Contains(submenuEffectValue) ? submenuEffectValue : "slide-down";
    var submenuItemEffectValue = Prop("submenuItemEffect", "background");
    var submenuItemEffect = new[] { "background", "shift", "underline", "left-bar", "none" }.Contains(submenuItemEffectValue) ? submenuItemEffectValue : "background";
    var submenuDuration = Math.Max(100, Math.Min(1000, IntProp("submenuDuration", 200)));
    var submenuAccentValue = Prop("submenuAccentColor", "#0054a6");
    var submenuAccent = System.Text.RegularExpressions.Regex.IsMatch(submenuAccentValue, "^#[0-9a-fA-F]{6}$") ? submenuAccentValue : "#0054a6";
    <nav class="sb-public-nav is-item-@itemStyle @(vertical ? "is-vertical" : "is-horizontal") align-@alignment" data-subnav-effect="@submenuEffect" data-subnav-item-effect="@submenuItemEffect" sb-effects="@style" style="@css;--sb-nav-gap:@(itemGap)px;--sb-nav-padding-x:@(itemPaddingX)px;--sb-nav-padding-y:@(itemPaddingY)px;--sb-subnav-duration:@(submenuDuration)ms;--sb-subnav-accent:@submenuAccent">
        @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_NavigationItems.cshtml", nav)
    </nav>
}
else if (node.Type == "search")
{
    <form class="sb-public-search" action="@SafeUrl(Prop("action","/search"))" method="get" sb-effects="@style" style="@css"><input name="q" placeholder="@Prop("placeholder","搜索")" /><button type="submit" aria-label="搜索">⌕</button></form>
}
else if (node.Type == "language")
{
    <span class="sb-public-language" sb-effects="@style" style="@css">@Prop("text","中文 / EN")</span>
}
else if (node.Type == "contact")
{
    <div class="sb-public-contact" sb-effects="@style" style="@css">@if(!string.IsNullOrWhiteSpace(Prop("phone"))){<div>@Prop("phone")</div>}@if(!string.IsNullOrWhiteSpace(Prop("email"))){<div>@Prop("email")</div>}@if(!string.IsNullOrWhiteSpace(Prop("address"))){<div>@Prop("address")</div>}</div>
}
else if (node.Type == "contactForm")
{
    var action = SafeUrl(Prop("action", "/home/message"));
    var showCaptcha = BoolProp("showCaptcha", true);
    var captchaKey = DateTime.UtcNow.Ticks.ToString() + "-" + node.Id;
    <form class="sb-contact-form" action="@action" method="post" data-message-form sb-effects="@style" style="@css">
        <div class="sb-contact-form-row"><input type="text" name="UserName" placeholder="@Prop("namePlaceholder", "姓名")" required maxlength="100" /><input type="tel" name="Phone" placeholder="@Prop("phonePlaceholder", "联系电话")" required maxlength="50" /></div>
        <input type="email" name="Email" placeholder="@Prop("emailPlaceholder", "电子邮箱")" maxlength="250" />
        <textarea name="Message" rows="5" placeholder="@Prop("messagePlaceholder", "留言内容")" required maxlength="1000"></textarea>
        @if (showCaptcha)
        {
            <div class="sb-contact-form-row sb-contact-captcha"><input type="text" name="ValidateCode" placeholder="验证码" required maxlength="4" autocomplete="off" /><input type="hidden" name="ValidateKey" value="@captchaKey" /><img src="/Authorize/GetImg?key=@captchaKey" alt="验证码" title="点击刷新验证码" data-captcha-image /></div>
        }
        <button class="sb-public-button sb-public-button-primary" type="submit">@Prop("buttonText", "提交留言")</button>
        <p class="sb-contact-form-tip" data-message-tip aria-live="polite"></p>
    </form>
}
else if (node.Type == "social")
{
    <div class="sb-public-social" sb-effects="@style" style="@css"><strong>@Prop("text","关注我们")</strong><div>@Prop("links")</div></div>
}
else if (node.Type == "copyright")
{
    <div class="sb-public-copyright" sb-effects="@style" style="@css">@Prop("text","版权信息")</div>
}
else if (node.Type == "articleList")
{
    @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_ArticleList.cshtml", Model)
}
else if (node.Type == "productList")
{
    @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_ProductList.cshtml", Model)
}
else if (node.Type == "jobList")
{
    @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_JobList.cshtml", Model)
}
