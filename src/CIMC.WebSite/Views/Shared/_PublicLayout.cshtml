@using System.Collections.Generic
@using MySite.Web.Models
@{
    var siteConfig = ViewBag.SiteConfig as SiteConfigModel;
    var navigation = ViewBag.NavigationList as List<NavigationModel> ?? new List<NavigationModel>();
    var headerDocument = ViewBag.HeaderDocument as BuilderDocumentModel ?? new BuilderDocumentModel { Name = "Header" };
    var footerDocument = ViewBag.FooterDocument as BuilderDocumentModel ?? new BuilderDocumentModel { Name = "Footer" };
    var title = ViewData["Title"] as string ?? siteConfig?.BrowserTitle ?? siteConfig?.SiteName ?? "企业官网";
    var keywords = ViewData["Keywords"] as string ?? siteConfig?.Keywords;
    var description = ViewData["Description"] as string ?? siteConfig?.Description;
    var currentPath = Context.Request.Path.Value ?? "/";
    var chromeModel = new PageRenderModel { SiteConfig = siteConfig, Navigation = navigation, PagePath = currentPath };
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @if (!string.IsNullOrEmpty(keywords)) { <meta name="keywords" content="@keywords" /> }
    @if (!string.IsNullOrEmpty(description)) { <meta name="description" content="@description" /> }
    <link rel="stylesheet" href="~/site/css/site.css" />
    <style>
        .sb-public-section{width:100%}.sb-public-container{width:100%;max-width:1200px;margin-left:auto;margin-right:auto;padding-left:20px;padding-right:20px}.sb-public-grid{display:grid;align-items:stretch}.sb-public-column{min-width:0}.sb-heading{line-height:1.25}.sb-text{line-height:1.8;white-space:pre-line}.sb-image{display:block;max-width:100%;height:auto}.sb-public-button{display:inline-block;padding:10px 20px;border-radius:5px;text-decoration:none;transition:.2s}.sb-public-button-primary{background:#1677ff;color:#fff}.sb-public-button-outline{border:1px solid #1677ff;color:#1677ff;background:transparent}.sb-public-button-text{color:#1677ff}.sb-public-icon{display:inline-block}.sb-public-video{display:block;width:100%;max-width:100%;background:#000}.sb-public-divider{border:0}.sb-public-logo{display:inline-flex;align-items:center;text-decoration:none;color:inherit}.sb-public-logo img{display:block;max-width:200px;max-height:56px}.sb-public-nav{display:flex;align-items:center;gap:24px}.sb-public-nav.is-vertical{flex-direction:column;align-items:flex-start;gap:10px}.sb-public-nav-item{position:relative}.sb-public-nav a{text-decoration:none;color:inherit;white-space:nowrap}.sb-public-nav-item.is-current>a{color:#1677ff;font-weight:600}.sb-public-subnav{display:none;position:absolute;left:0;top:100%;min-width:170px;padding:8px;background:#fff;color:#1f2937;border:1px solid #e5e7eb;box-shadow:0 10px 25px rgba(0,0,0,.08);z-index:30}.sb-public-subnav>.sb-public-nav-item{display:block}.sb-public-subnav a{display:block;padding:8px 10px}.sb-public-nav-item:hover>.sb-public-subnav{display:block}.sb-public-subnav .sb-public-subnav{left:100%;top:0}.sb-public-nav.is-vertical .sb-public-subnav{position:static;display:block;border:0;box-shadow:none;background:transparent;color:inherit;padding:4px 0 0 14px}.sb-public-search{display:inline-flex;align-items:center;border:1px solid #d1d5db;border-radius:5px;background:#fff;overflow:hidden}.sb-public-search input{width:150px;border:0;outline:0;padding:8px 10px}.sb-public-search button{border:0;background:transparent;padding:8px;cursor:pointer}.sb-public-contact{line-height:1.9}.sb-content-list{width:100%}.sb-article-grid,.sb-product-grid{display:grid;grid-template-columns:repeat(var(--sb-cols,3),minmax(0,1fr));gap:24px}.sb-content-card{overflow:hidden;border:1px solid #edf0f3;border-radius:8px;background:#fff}.sb-content-card>a{text-decoration:none;color:inherit}.sb-content-card img{display:block;width:100%;aspect-ratio:16/10;object-fit:cover}.sb-content-card-body{padding:18px}.sb-content-card-body h3{margin:0 0 10px}.sb-content-card-body p{color:#6b7280;line-height:1.7}.sb-content-card-body time{color:#9ca3af;font-size:13px}.sb-job-card{border:1px solid #e5e7eb;border-radius:7px;margin-bottom:10px;background:#fff}.sb-job-card summary{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:15px;align-items:center;padding:16px 18px;cursor:pointer}.sb-job-detail{padding:0 20px 20px;line-height:1.8}.sb-empty{padding:30px;text-align:center;color:#9ca3af}.component-pagination{display:flex;justify-content:center;align-items:center;gap:7px;flex-wrap:wrap;margin:28px 0 8px}.component-pagination a,.component-pagination span{min-width:34px;height:34px;line-height:34px;text-align:center;padding:0 10px;border:1px solid #e5e7eb;border-radius:4px;color:#4b5563;background:#fff;text-decoration:none}.component-pagination a:hover,.component-pagination .active{border-color:#1677ff;background:#1677ff;color:#fff}
        @@media(max-width:900px){.sb-public-grid{grid-template-columns:1fr!important}.sb-public-nav.is-horizontal{flex-wrap:wrap;gap:12px}.sb-article-grid,.sb-product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.sb-job-card summary{grid-template-columns:1fr 1fr}}
        @@media(max-width:560px){.sb-public-container{padding-left:14px;padding-right:14px}.sb-article-grid,.sb-product-grid{grid-template-columns:1fr}.sb-job-card summary{grid-template-columns:1fr}.component-pagination a,.component-pagination span{min-width:30px;height:30px;line-height:30px;padding:0 7px}}
    </style>
</head>
<body>
    <div class="page-wrapper" data-current-path="@currentPath">
        <header class="site-global-header">
            @{ chromeModel.Document = headerDocument; }
            @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Document.cshtml", chromeModel)
        </header>
        <main class="site-main">@RenderBody()</main>
        <footer class="site-global-footer">
            @{ chromeModel.Document = footerDocument; }
            @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Document.cshtml", chromeModel)
        </footer>
    </div>
    <script src="~/site/js/site.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
