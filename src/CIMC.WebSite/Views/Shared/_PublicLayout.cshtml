@using System.Collections.Generic
@using MySite.Web.Models
@{
    var siteConfig = ViewBag.SiteConfig as SiteConfigModel;
    var navigation = ViewBag.NavigationList as List<NavigationModel> ?? new List<NavigationModel>();
    var headerDocument = ViewBag.HeaderDocument as BuilderDocumentModel ?? new BuilderDocumentModel { Name = "Header" };
    var footerDocument = ViewBag.FooterDocument as BuilderDocumentModel ?? new BuilderDocumentModel { Name = "Footer" };
    var title = ViewData["Title"] as string ?? siteConfig?.BrowserTitle ?? siteConfig?.SiteName ?? "企业官网";
    var keywords = ViewData["Keywords"] as string ?? siteConfig?.Keywords;
    var description = ViewData["Description"] as string ?? siteConfig?.Description;
    var currentPath = Context.Request.Path.Value ?? "/";
    var chromeModel = new PageRenderModel { SiteConfig = siteConfig, Navigation = navigation, PagePath = currentPath };
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @if (!string.IsNullOrEmpty(keywords)) { <meta name="keywords" content="@keywords" /> }
    @if (!string.IsNullOrEmpty(description)) { <meta name="description" content="@description" /> }
    <link rel="stylesheet" href="~/site/css/site.css" />
    <link rel="stylesheet" href="~/site-builder/runtime.css?v=2026090511" />
</head>
<body>
    <div class="page-wrapper" data-current-path="@currentPath">
        <header class="site-global-header">
            @{ chromeModel.Document = headerDocument; }
            @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Document.cshtml", chromeModel)
        </header>
        <main class="site-main">@RenderBody()</main>
        <footer class="site-global-footer">
            @{ chromeModel.Document = footerDocument; }
            @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Document.cshtml", chromeModel)
        </footer>
    </div>
    @if (ViewBag.IsBuilderPreview == true)
    {
        <div class="builder-preview-notice">草稿预览 · 包含 Header / Footer 草稿，正式网站以各自发布版本为准</div>
    }
    <script src="~/site/js/site.js" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
