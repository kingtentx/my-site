@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name;
    var isEn = currentCulture.StartsWith("en");
    var title = ViewData["Title"] as string ?? "CIMC";
}
<!DOCTYPE html>
<html lang="@(isEn ? "en" : "zh-CN")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <link rel="stylesheet" href="~/syle/site.css" />
</head>
<body>
    <main>
        @RenderBody()
    </main>
    <script src="~/syle/site.js"></script>
    <script>
        function switchLang(culture) {
            document.cookie = '.AspNetCore.Culture=' + encodeURIComponent('c=' + culture + '|uic=' + culture) + ';path=/;max-age=' + (365 * 24 * 3600);
            window.location.reload();
        }
    </script>
</body>
</html>
