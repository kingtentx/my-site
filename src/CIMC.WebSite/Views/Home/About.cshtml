@model PublicAboutViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name;
    var isEn = currentCulture.StartsWith("en");
    ViewData["Title"] = Localizer["关于我们-标题"];
    var aboutModule = Model.Modules.FirstOrDefault(p => p.ModuleKey == "banner");
    var aboutSettingsJson = isEn && !string.IsNullOrWhiteSpace(aboutModule?.SettingsJson_EN) ? aboutModule.SettingsJson_EN : aboutModule?.SettingsJson;
    var aboutSettings = aboutSettingsJson != null ? Newtonsoft.Json.Linq.JObject.Parse(aboutSettingsJson) : null;
}

<section class="page-hero page-hero--slider" style="background-image:url('@Model.BannerImage')" data-page-hero>
    @foreach (var image in Model.BannerImages)
    {
        <div class="page-hero__slide @(image == Model.BannerImages.FirstOrDefault() ? "is-active" : "")" style="background-image:url('@image')"></div>
    }
    <div class="container reveal">
        <h1>@Model.BannerTitle</h1>
        <p>@Model.BannerSubTitle</p>
    </div>
</section>

<section class="section">
    <div class="container about-detail">
        <div class="about-detail__images reveal">
            @{
                var profileImages = aboutSettings?["profile"]?["images"];
                if (profileImages != null)
                {
                    foreach (var img in profileImages)
                    {
                        <img src="@img" alt="" />
                    }
                }
                else
                {
                    <img src="~/syle/images/43968452.jpg" alt="@(isEn ? "Shanghai CIMC Yangshan Logistics Equipment Co., Ltd." : "上海中集洋山物流装备有限公司")" />
                    <img src="~/syle/images/43968450.jpg" alt="@(isEn ? "Shanghai CIMC Yangshan Logistics Equipment Co., Ltd." : "上海中集洋山物流装备有限公司")" />
                }
            }
        </div>
        <div class="about-detail__copy reveal">
            <span class="eyebrow">@(aboutSettings?["profile"]?["eyebrow"]?.ToString() ?? "Company Profile")</span>
            <h2>@(aboutSettings?["profile"]?["title"]?.ToString() ?? "上海中集洋山物流装备有限公司")</h2>
            @{
                var paragraphs = aboutSettings?["profile"]?["paragraphs"];
                if (paragraphs != null)
                {
                    foreach (var p in paragraphs)
                    {
                        <p>@p</p>
                    }
                }
                else
                {
                    <p>@Localizer["公司简介默认P1"]</p>
                    <p>@Localizer["公司简介默认P2"]</p>
                    <p>@Localizer["公司简介默认P3"]</p>
                }
            }
        </div>
    </div>
</section>

<section class="section capability-band">
    <div class="container capability-grid">
        @{
            var capabilities = aboutSettings?["capabilities"];
            if (capabilities != null)
            {
                foreach (var cap in capabilities)
                {
                    <article class="reveal"><strong>@cap["title"]</strong><span>@cap["description"]</span></article>
                }
            }
            else
            {
                <article class="reveal"><strong>@Localizer["智能制造"]</strong><span>@Localizer["智能制造描述"]</span></article>
                <article class="reveal"><strong>@Localizer["数字工厂"]</strong><span>@Localizer["数字工厂描述"]</span></article>
                <article class="reveal"><strong>@Localizer["绿色制造"]</strong><span>@Localizer["绿色制造描述"]</span></article>
                <article class="reveal"><strong>@Localizer["全球服务"]</strong><span>@Localizer["全球服务描述"]</span></article>
            }
        }
    </div>
</section>

<section class="section cert-section">
    <div class="section-title reveal">
        <span>Certificates</span>
        <h2>@Localizer["资质证书"]</h2>
    </div>
    <div class="container cert-carousel reveal" data-cert-carousel>
        <button class="cert-arrow cert-arrow-left" type="button" aria-label="@Localizer["上一页"]">‹</button>
        <div class="cert-viewport">
            <div class="cert-track">
                @foreach (var cert in Model.Certificates)
                {
                    <article class="cert-card">
                        <div class="cert-card__image">
                            <img src="@cert.ImageUrl" alt="@(isEn && !string.IsNullOrWhiteSpace(cert.Title_EN) ? cert.Title_EN : cert.Title)" />
                        </div>
                        <h3>@(isEn && !string.IsNullOrWhiteSpace(cert.Title_EN) ? cert.Title_EN : cert.Title)</h3>
                    </article>
                }
            </div>
        </div>
        <button class="cert-arrow cert-arrow-right" type="button" aria-label="@Localizer["下一页"]">›</button>
    </div>
</section>

<section class="section">
    <div class="section-title reveal">
        <span>@(aboutSettings?["partnersEyebrow"]?.ToString() ?? "Partners")</span>
        <h2>@(aboutSettings?["partnersTitle"]?.ToString() ?? Localizer["客户与合作"].Value)</h2>
    </div>
    <div class="container logo-wall reveal">
        <img src="~/syle/images/43968717.png" alt="" />
        <img src="~/syle/images/43968718.png" alt="" />
        <img src="~/syle/images/43968719.png" alt="" />
        <img src="~/syle/images/43968720.png" alt="" />
        <img src="~/syle/images/43968721.png" alt="" />
        <img src="~/syle/images/43968723.png" alt="" />
        <img src="~/syle/images/43968725.png" alt="" />
        <img src="~/syle/images/43968726.png" alt="" />
        <img src="~/syle/images/43968727.png" alt="" />
        <img src="~/syle/images/43968763.png" alt="" />
        <img src="~/syle/images/43969204.png" alt="" />
        <img src="~/syle/images/43968756.png" alt="" />
    </div>
</section>