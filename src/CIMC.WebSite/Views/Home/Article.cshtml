@using CIMC.Data
@model Article
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = Model.Title;
}

<article class="article-detail">
    <div class="container">
        <div class="article-header">
            <h1 class="article-title">@Model.Title</h1>
            <div class="article-meta">
                @if (!string.IsNullOrEmpty(Model.Author))
                {
                    <span class="meta-item">作者：@Model.Author</span>
                }
                @if (Model.CreationTime.HasValue)
                {
                    <span class="meta-item">发布时间：@Model.CreationTime.Value.ToString("yyyy-MM-dd")</span>
                }
                <span class="meta-item">浏览：@Model.ViewCount</span>
            </div>
        </div>
        <div class="article-body">
            @Html.Raw(Model.Detail)
        </div>
        <div class="article-footer-nav">
            <a href="/news" class="back-btn">&lsaquo; 返回列表</a>
        </div>
    </div>
</article>
