@using MySite.Web.Models
@model ComponentModel
@{
    var navList = ViewBag.NavigationList as List<NavigationModel> ?? new List<NavigationModel>();
    var siteConfig = ViewBag.SiteConfig as SiteConfigModel;
    var currentPath = Context.Request.Path.Value ?? "/";

    string bgColor = "#ffffff", textColor = "#333333", activeColor = "#1e9fff";
    bool isFixedTop = false;
    if (Model.Props != null)
    {
        if (Model.Props.TryGetValue("bgColor", out var bg) && bg != null) bgColor = bg.ToString();
        if (Model.Props.TryGetValue("textColor", out var tc) && tc != null) textColor = tc.ToString();
        if (Model.Props.TryGetValue("activeColor", out var ac) && ac != null) activeColor = ac.ToString();
        if (Model.Props.TryGetValue("isFixedTop", out var ft) && ft != null && bool.TryParse(ft.ToString(), out var fixedParsed)) isFixedTop = fixedParsed;
    }

    var topLevel = navList.Where(n => n.Pid == 0).OrderBy(n => n.Sort).ToList();
    var logo = siteConfig?.Logo;
    var siteName = siteConfig?.SiteName ?? "企业官网";
}
<header class="site-header @(isFixedTop ? "is-fixed" : "")" style="background-color:@bgColor; color:@textColor;">
    <div class="container header-inner">
        <a href="/" class="logo">
            @if (!string.IsNullOrEmpty(logo))
            {
                <img src="@logo" alt="@siteName" />
            }
            else
            {
                <span class="logo-text">@siteName</span>
            }
        </a>
        <button type="button" class="nav-toggle" aria-label="切换菜单" data-nav-toggle>
            <span></span><span></span><span></span>
        </button>
        <nav class="main-nav" data-nav-menu>
            <ul>
                @foreach (var nav in topLevel)
                {
                    var children = navList.Where(n => n.Pid == nav.Id).OrderBy(n => n.Sort).ToList();
                    var isActive = currentPath.Equals(nav.Path, StringComparison.OrdinalIgnoreCase)
                                || (nav.Path != "/" && currentPath.StartsWith(nav.Path, StringComparison.OrdinalIgnoreCase));
                    <li class="nav-item @(children.Count > 0 ? "has-children" : "") @(isActive ? "active" : "")">
                        @if (nav.Target == 1)
                        {
                            <a href="@nav.Path" target="_blank" rel="noopener" style="color:@(isActive ? activeColor : textColor);">@nav.Title</a>
                        }
                        else
                        {
                            <a href="@nav.Path" style="color:@(isActive ? activeColor : textColor);">@nav.Title</a>
                        }
                        @if (children.Count > 0)
                        {
                            <ul class="sub-menu">
                                @foreach (var child in children)
                                {
                                    <li>
                                        @if (child.Target == 1)
                                        {
                                            <a href="@child.Path" target="_blank" rel="noopener">@child.Title</a>
                                        }
                                        else
                                        {
                                            <a href="@child.Path">@child.Title</a>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </nav>
    </div>
</header>
