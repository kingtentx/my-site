@using Newtonsoft.Json.Linq
@model MySite.Web.Models.ComponentModel
@{
    int height = 400;
    bool autoplay = true;
    int interval = 5000;
    string textColor = "#ffffff";
    int overlayOpacity = 0;
    JArray items = new JArray();

    if (Model.Props != null)
    {
        if (Model.Props.TryGetValue("height", out var h) && h != null && int.TryParse(h.ToString(), out var hp)) height = hp;
        if (Model.Props.TryGetValue("autoplay", out var ap) && ap != null && bool.TryParse(ap.ToString(), out var apv)) autoplay = apv;
        if (Model.Props.TryGetValue("interval", out var iv) && iv != null && int.TryParse(iv.ToString(), out var ivp)) interval = ivp;
        if (Model.Props.TryGetValue("textColor", out var tc) && tc != null) textColor = tc.ToString();
        if (Model.Props.TryGetValue("overlayOpacity", out var oo) && oo != null && int.TryParse(oo.ToString(), out var oop)) overlayOpacity = oop;
        if (Model.Props.TryGetValue("items", out var it) && it != null)
        {
            try { items = JArray.FromObject(it); } catch { }
        }
    }
}
@if (items.Count == 0)
{
    <section class="banner banner-empty" style="height:@(height)px;">
        <div class="container">
            <p>尚未配置 Banner</p>
        </div>
    </section>
}
else
{
    <section class="banner" data-banner data-autoplay="@autoplay.ToString().ToLower()" data-interval="@interval" style="height:@(height)px;color:@textColor;">
        <div class="banner-slides">
            @for (int i = 0; i < items.Count; i++)
            {
                var item = items[i];
                var image = item["image"]?.ToString() ?? "";
                var title = item["title"]?.ToString() ?? "";
                var subtitle = item["subtitle"]?.ToString() ?? "";
                var buttonText = item["buttonText"]?.ToString() ?? "";
                var buttonLink = item["buttonLink"]?.ToString() ?? "";
                <div class="banner-slide @(i == 0 ? "active" : "")" style="background-image:url('@image');">
                    @if (overlayOpacity > 0)
                    {
                        <div class="banner-overlay" style="background:rgba(0,0,0,@(overlayOpacity / 100.0));"></div>
                    }
                    <div class="banner-content container">
                        @if (!string.IsNullOrEmpty(title)) { <h2 class="banner-title">@title</h2> }
                        @if (!string.IsNullOrEmpty(subtitle)) { <p class="banner-subtitle">@subtitle</p> }
                        @if (!string.IsNullOrEmpty(buttonText) && !string.IsNullOrEmpty(buttonLink))
                        {
                            <a href="@buttonLink" class="banner-btn">@buttonText</a>
                        }
                    </div>
                </div>
            }
        </div>
        @if (items.Count > 1)
        {
            <button type="button" class="banner-arrow prev" data-banner-prev aria-label="上一张">&lsaquo;</button>
            <button type="button" class="banner-arrow next" data-banner-next aria-label="下一张">&rsaquo;</button>
            <div class="banner-dots" data-banner-dots>
                @for (int i = 0; i < items.Count; i++)
                {
                    <span class="banner-dot @(i == 0 ? "active" : "")" data-index="@i"></span>
                }
            </div>
        }
    </section>
}
