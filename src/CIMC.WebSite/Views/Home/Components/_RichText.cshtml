@model MySite.Web.Models.ComponentModel
@{
    string html = "";
    int paddingTop = 20, paddingBottom = 20;

    if (Model.Props != null)
    {
        if (Model.Props.TryGetValue("html", out var h) && h != null) html = h.ToString();
        if (Model.Props.TryGetValue("paddingTop", out var pt) && pt != null && int.TryParse(pt.ToString(), out var ptp)) paddingTop = ptp;
        if (Model.Props.TryGetValue("paddingBottom", out var pb) && pb != null && int.TryParse(pb.ToString(), out var pbp)) paddingBottom = pbp;
    }
}
<section class="rich-text-section" style="padding-top:@(paddingTop)px; padding-bottom:@(paddingBottom)px;">
    <div class="container rich-text-content">
        @Html.Raw(html)
    </div>
</section>
