@model MySite.Web.Models.ComponentModel
@{
    string color = "#e8e8e8", lineStyle = "solid";
    int width = 1, marginTop = 20, marginBottom = 20;
    if (Model.Props != null)
    {
        if (Model.Props.TryGetValue("color", out var c) && c != null) color = c.ToString();
        if (Model.Props.TryGetValue("lineStyle", out var ls) && ls != null) lineStyle = ls.ToString();
        if (Model.Props.TryGetValue("width", out var w) && int.TryParse(w?.ToString(), out var wi)) width = Math.Max(1, wi);
        if (Model.Props.TryGetValue("marginTop", out var mt) && int.TryParse(mt?.ToString(), out var top)) marginTop = Math.Max(0, top);
        if (Model.Props.TryGetValue("marginBottom", out var mb) && int.TryParse(mb?.ToString(), out var bottom)) marginBottom = Math.Max(0, bottom);
    }
}
<div class="container"><hr class="site-component-divider" style="border-top:@(width)px @lineStyle @color;margin-top:@(marginTop)px;margin-bottom:@(marginBottom)px" /></div>
