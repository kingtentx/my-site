@using Newtonsoft.Json.Linq
@using MySite.Web.Models
@model ComponentModel
@{
    var footer = ViewBag.Footer as FooterModel ?? new FooterModel();
    var navList = ViewBag.NavigationList as List<NavigationModel> ?? new List<NavigationModel>();

    string bgColor = footer.BgColor ?? "#2c3e50";
    string textColor = footer.TextColor ?? "#ffffff";
    if (Model.Props != null)
    {
        if (Model.Props.TryGetValue("bgColor", out var bg) && bg != null) bgColor = bg.ToString();
        if (Model.Props.TryGetValue("textColor", out var tc) && tc != null) textColor = tc.ToString();
    }

    var friendLinks = new List<JObject>();
    if (!string.IsNullOrEmpty(footer.FriendLinks))
    {
        try { friendLinks = JArray.Parse(footer.FriendLinks).Select(t => (JObject)t).ToList(); } catch { }
    }
}
<footer class="site-footer" style="background-color:@bgColor; color:@textColor;">
    <div class="container footer-grid">
        <div class="footer-col footer-info">
            @if (!string.IsNullOrEmpty(footer.Logo))
            {
                <img src="@footer.Logo" alt="@footer.CompanyName" class="footer-logo" />
            }
            <h3 class="footer-company">@footer.CompanyName</h3>
            @if (!string.IsNullOrEmpty(footer.Intro))
            {
                <p class="footer-intro">@footer.Intro</p>
            }
        </div>
        <div class="footer-col footer-contact">
            <h4>联系方式</h4>
            @if (!string.IsNullOrEmpty(footer.Phone)) { <p>电话：@footer.Phone</p> }
            @if (!string.IsNullOrEmpty(footer.Email)) { <p>邮箱：@footer.Email</p> }
            @if (!string.IsNullOrEmpty(footer.Address)) { <p>地址：@footer.Address</p> }
        </div>
        <div class="footer-col footer-nav">
            <h4>快捷导航</h4>
            <ul>
                @foreach (var nav in navList.Where(n => n.Pid == 0).OrderBy(n => n.Sort))
                {
                    <li><a href="@nav.Path" style="color:@textColor;">@nav.Title</a></li>
                }
            </ul>
        </div>
        @if (!string.IsNullOrEmpty(footer.Qrcode))
        {
            <div class="footer-col footer-qrcode">
                <h4>关注我们</h4>
                <img src="@footer.Qrcode" alt="二维码" class="footer-qrcode-img" />
            </div>
        }
    </div>
    @if (friendLinks.Count > 0)
    {
        <div class="container footer-links">
            <span>友情链接：</span>
            @for (int i = 0; i < friendLinks.Count; i++)
            {
                var link = friendLinks[i];
                var name = link["name"]?.ToString() ?? "";
                var url = link["url"]?.ToString() ?? "#";
                if (i > 0) { <text> | </text> }
                <a href="@url" target="_blank" rel="noopener" style="color:@textColor;">@name</a>
            }
        </div>
    }
    <div class="container footer-copyright">
        @if (!string.IsNullOrEmpty(footer.Copyright)) { <span>@footer.Copyright</span> }
        @if (!string.IsNullOrEmpty(footer.IcpNo)) { <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener" style="color:@textColor;">@footer.IcpNo</a> }
        @if (!string.IsNullOrEmpty(footer.PoliceNo)) { <span>@footer.PoliceNo</span> }
    </div>
</footer>
