@using CIMC.Data
@using CIMC.EntityFramework
@using System.Net
@using System.Linq
@model MySite.Web.Models.ComponentModel
@inject IRepository<ContentJob> JobRepository
@inject IRepository<ContentProductCategory> CategoryRepository
@{
    int pageSize = 10, categoryId = 0;
    bool showLocation = true, showSalary = true, showCount = true, showPublishTime = true, enablePagination = true;
    if (Model.Props != null)
    {
        if (Model.Props.TryGetValue("pageSize", out var ps) && int.TryParse(ps?.ToString(), out var n)) pageSize = Math.Max(1, Math.Min(100, n));
        if (Model.Props.TryGetValue("categoryId", out var ci) && int.TryParse(ci?.ToString(), out var c)) categoryId = c;
        if (Model.Props.TryGetValue("showLocation", out var sl) && bool.TryParse(sl?.ToString(), out var b1)) showLocation = b1;
        if (Model.Props.TryGetValue("showSalary", out var ss) && bool.TryParse(ss?.ToString(), out var b2)) showSalary = b2;
        if (Model.Props.TryGetValue("showCount", out var sc) && bool.TryParse(sc?.ToString(), out var b3)) showCount = b3;
        if (Model.Props.TryGetValue("showPublishTime", out var sp) && bool.TryParse(sp?.ToString(), out var b4)) showPublishTime = b4;
        if (Model.Props.TryGetValue("enablePagination", out var ep) && bool.TryParse(ep?.ToString(), out var b5)) enablePagination = b5;
    }

    var categoryIds = categoryId > 0 ? MySite.Web.ContentCategoryHelper.GetDescendantIds(CategoryRepository, categoryId, true) : new List<int>();
    var allItems = JobRepository.GetList(j => !j.IsDelete && j.IsActive, j => j.Sort, true)
        .Where(j => categoryId <= 0 || categoryIds.Contains(j.CategoryId)).ToList();

    var request = ViewContext.HttpContext.Request;
    var componentKey = new string((Model.Id ?? "job").Where(char.IsLetterOrDigit).ToArray());
    if (string.IsNullOrWhiteSpace(componentKey)) componentKey = "job";
    var componentDomId = "job-component-" + componentKey;
    var pageParam = "page_" + componentKey;
    var currentPage = 1;
    if (enablePagination && int.TryParse(request.Query[pageParam].ToString(), out var requestedPage)) currentPage = Math.Max(1, requestedPage);
    var totalPages = Math.Max(1, (int)Math.Ceiling(allItems.Count / (double)pageSize));
    currentPage = Math.Min(currentPage, totalPages);
    var items = enablePagination ? allItems.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList() : allItems.Take(pageSize).ToList();
    var columnCount = 2 + (showLocation ? 1 : 0) + (showSalary ? 1 : 0) + (showCount ? 1 : 0) + (showPublishTime ? 1 : 0);

    string BuildPageUrl(int pageNumber)
    {
        var parts = new List<string>();
        foreach (var pair in request.Query)
        {
            if (string.Equals(pair.Key, pageParam, StringComparison.OrdinalIgnoreCase)) continue;
            foreach (var value in pair.Value) parts.Add(WebUtility.UrlEncode(pair.Key) + "=" + WebUtility.UrlEncode(value));
        }
        parts.Add(WebUtility.UrlEncode(pageParam) + "=" + pageNumber);
        return $"{request.PathBase}{request.Path}?{string.Join("&", parts)}";
    }
}
<style>
    #@componentDomId .job-summary-row { cursor: pointer; transition: background-color .2s ease; }
    #@componentDomId .job-summary-row:hover,
    #@componentDomId .job-summary-row:focus { background: #f5f9ff; outline: none; }
    #@componentDomId .job-summary-row.is-expanded { background: #f0f7ff; }
    #@componentDomId .job-toggle { display: inline-flex; align-items: center; gap: 10px; padding: 0; border: 0; background: transparent; color: #1683ff; font: inherit; cursor: pointer; text-align: left; }
    #@componentDomId .job-toggle:hover { color: #006fe6; }
    #@componentDomId .job-toggle-icon { width: 9px; height: 9px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); transition: transform .25s ease; flex: 0 0 auto; margin-top: -4px; }
    #@componentDomId .job-summary-row.is-expanded .job-toggle-icon { transform: rotate(225deg); margin-top: 4px; }
    #@componentDomId .job-detail-row > td { padding: 0 !important; border-top: 0 !important; background: #fbfdff; }
    #@componentDomId .job-detail-panel { max-height: 0; overflow: hidden; opacity: 0; transform: translateY(-8px); transition: max-height .38s ease, opacity .25s ease, transform .3s ease; }
    #@componentDomId .job-detail-row.is-open .job-detail-panel { max-height: 1400px; opacity: 1; transform: translateY(0); }
    #@componentDomId .job-detail-inner { padding: 24px 28px 26px; border-top: 1px solid #e6eef8; }
    #@componentDomId .job-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }
    #@componentDomId .job-meta span { padding: 5px 12px; border-radius: 16px; background: #edf5ff; color: #376a9f; font-size: 13px; }
    #@componentDomId .job-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
    #@componentDomId .job-detail-section h3 { margin: 0 0 12px; padding-left: 10px; border-left: 3px solid #1683ff; font-size: 17px; color: #222; }
    #@componentDomId .job-detail-content { color: #555; line-height: 1.85; word-break: break-word; }
    #@componentDomId .job-detail-content p:first-child { margin-top: 0; }
    #@componentDomId .job-contact { margin-top: 22px; padding: 15px 18px; background: #f5f8fc; border-radius: 6px; color: #555; }
    #@componentDomId .job-contact strong { color: #222; margin-right: 12px; }
    #@componentDomId .job-contact a { color: #1683ff; margin-right: 20px; }
    @@media (max-width: 768px) {
        #@componentDomId .job-table { min-width: 760px; }
        #@componentDomId .job-detail-grid { grid-template-columns: 1fr; gap: 18px; }
        #@componentDomId .job-detail-inner { padding: 18px; }
    }
</style>
<section id="@componentDomId" class="job-section content-component" data-component-id="@Model.Id">
    <div class="container">
        <div class="section-header"><h2 class="section-title">@(string.IsNullOrWhiteSpace(Model.Name) ? "人才招聘" : Model.Name)</h2></div>
        @if (items.Count == 0)
        {
            <p class="empty-tip">暂无招聘职位</p>
        }
        else
        {
            <div class="job-table-wrap">
                <table class="job-table">
                    <thead><tr><th>职位名称</th><th>部门</th>@if(showLocation){<th>工作地点</th>}@if(showSalary){<th>薪资范围</th>}@if(showCount){<th>招聘人数</th>}@if(showPublishTime){<th>发布时间</th>}</tr></thead>
                    <tbody>
                    @foreach (var job in items)
                    {
                        var detailId = $"job-detail-{componentKey}-{job.Id}";
                        <tr class="job-summary-row" tabindex="0" data-detail-id="@detailId" aria-controls="@detailId">
                            <td class="job-title">
                                <button type="button" class="job-toggle" aria-expanded="false" aria-controls="@detailId">
                                    <span>@job.JobTitle</span><span class="job-toggle-icon" aria-hidden="true"></span>
                                </button>
                            </td>
                            <td>@(job.Department ?? "-")</td>
                            @if(showLocation){<td>@(job.WorkLocation ?? "-")</td>}
                            @if(showSalary){<td>@(job.SalaryRange ?? "面议")</td>}
                            @if(showCount){<td>@job.RecruitCount</td>}
                            @if(showPublishTime){<td>@(job.PublishTime.HasValue ? job.PublishTime.Value.ToString("yyyy-MM-dd") : "-")</td>}
                        </tr>
                        <tr id="@detailId" class="job-detail-row">
                            <td colspan="@columnCount">
                                <div class="job-detail-panel">
                                    <div class="job-detail-inner">
                                        <div class="job-meta">
                                            @if (!string.IsNullOrWhiteSpace(job.JobType)) { <span>工作性质：@job.JobType</span> }
                                            @if (!string.IsNullOrWhiteSpace(job.Department)) { <span>所属部门：@job.Department</span> }
                                            @if (!string.IsNullOrWhiteSpace(job.WorkLocation)) { <span>工作地点：@job.WorkLocation</span> }
                                            <span>招聘人数：@job.RecruitCount 人</span>
                                            <span>薪资范围：@(string.IsNullOrWhiteSpace(job.SalaryRange) ? "面议" : job.SalaryRange)</span>
                                        </div>
                                        <div class="job-detail-grid">
                                            <div class="job-detail-section">
                                                <h3>岗位职责</h3>
                                                <div class="job-detail-content">@Html.Raw(string.IsNullOrWhiteSpace(job.Responsibilities) ? "<p>暂无岗位职责说明</p>" : job.Responsibilities)</div>
                                            </div>
                                            <div class="job-detail-section">
                                                <h3>任职要求</h3>
                                                <div class="job-detail-content">@Html.Raw(string.IsNullOrWhiteSpace(job.Requirements) ? "<p>暂无任职要求说明</p>" : job.Requirements)</div>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(job.ContactName) || !string.IsNullOrWhiteSpace(job.ContactPhone) || !string.IsNullOrWhiteSpace(job.ContactEmail))
                                        {
                                            <div class="job-contact">
                                                <strong>应聘联系</strong>
                                                @if (!string.IsNullOrWhiteSpace(job.ContactName)) { <span>@job.ContactName</span> }
                                                @if (!string.IsNullOrWhiteSpace(job.ContactPhone)) { <a href="tel:@job.ContactPhone">@job.ContactPhone</a> }
                                                @if (!string.IsNullOrWhiteSpace(job.ContactEmail)) { <a href="mailto:@job.ContactEmail">@job.ContactEmail</a> }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (enablePagination && totalPages > 1)
            {
                <nav class="component-pagination" aria-label="招聘分页">
                    @if (currentPage > 1) { <a href="@BuildPageUrl(currentPage - 1)">上一页</a> }
                    @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                    {
                        if (pageNumber == currentPage) { <span class="active">@(pageNumber)</span> } else { <a href="@BuildPageUrl(pageNumber)">@(pageNumber)</a> }
                    }
                    @if (currentPage < totalPages) { <a href="@BuildPageUrl(currentPage + 1)">下一页</a> }
                </nav>
            }
        }
    </div>
</section>
<script>
(function () {
    var root = document.getElementById('@componentDomId');
    if (!root) return;

    function closeRow(row) {
        if (!row) return;
        var detail = document.getElementById(row.getAttribute('data-detail-id'));
        row.classList.remove('is-expanded');
        if (detail) detail.classList.remove('is-open');
        var button = row.querySelector('.job-toggle');
        if (button) button.setAttribute('aria-expanded', 'false');
    }

    function toggleRow(row) {
        if (!row) return;
        var willOpen = !row.classList.contains('is-expanded');
        root.querySelectorAll('.job-summary-row.is-expanded').forEach(function (openedRow) {
            if (openedRow !== row) closeRow(openedRow);
        });

        if (!willOpen) {
            closeRow(row);
            return;
        }

        var detail = document.getElementById(row.getAttribute('data-detail-id'));
        row.classList.add('is-expanded');
        if (detail) detail.classList.add('is-open');
        var button = row.querySelector('.job-toggle');
        if (button) button.setAttribute('aria-expanded', 'true');
    }

    root.addEventListener('click', function (event) {
        var button = event.target.closest('.job-toggle');
        if (button) {
            event.preventDefault();
            toggleRow(button.closest('.job-summary-row'));
            return;
        }

        var row = event.target.closest('.job-summary-row');
        if (row) toggleRow(row);
    });

    root.addEventListener('keydown', function (event) {
        var row = event.target.closest('.job-summary-row');
        if (!row || event.target.closest('.job-toggle')) return;
        if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            toggleRow(row);
        }
    });
})();
</script>
