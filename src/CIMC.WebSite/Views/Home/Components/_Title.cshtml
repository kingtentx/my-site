@model MySite.Web.Models.ComponentModel
@{
    string text = "标题", align = "center", color = "#333333";
    int level = 2;
    int paddingTop = 20, paddingBottom = 10;

    if (Model.Props != null)
    {
        if (Model.Props.TryGetValue("text", out var t) && t != null) text = t.ToString();
        if (Model.Props.TryGetValue("align", out var a) && a != null) align = a.ToString();
        if (Model.Props.TryGetValue("color", out var c) && c != null) color = c.ToString();
        if (Model.Props.TryGetValue("level", out var l) && l != null && int.TryParse(l.ToString(), out var lp)) level = Math.Max(1, Math.Min(6, lp));
        if (Model.Props.TryGetValue("paddingTop", out var pt) && pt != null && int.TryParse(pt.ToString(), out var ptp)) paddingTop = ptp;
        if (Model.Props.TryGetValue("paddingBottom", out var pb) && pb != null && int.TryParse(pb.ToString(), out var pbp)) paddingBottom = pbp;
    }

    var tag = "h" + level;
}
<section class="title-section" style="text-align:@align; padding-top:@(paddingTop)px; padding-bottom:@(paddingBottom)px;">
    <div class="container">
        <@tag class="title-component" style="color:@color;">@text</@tag>
    </div>
</section>
