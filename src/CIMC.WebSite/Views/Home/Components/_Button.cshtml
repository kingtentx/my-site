@model MySite.Web.Models.ComponentModel
@{
    string text = "了解更多", link = "#", align = "center", size = "medium", styleType = "primary";
    bool newWindow = false;
    if (Model.Props != null)
    {
        if (Model.Props.TryGetValue("text", out var t) && t != null) text = t.ToString();
        if (Model.Props.TryGetValue("link", out var l) && l != null) link = l.ToString();
        if (Model.Props.TryGetValue("align", out var a) && a != null) align = a.ToString();
        if (Model.Props.TryGetValue("size", out var s) && s != null) size = s.ToString();
        if (Model.Props.TryGetValue("styleType", out var st) && st != null) styleType = st.ToString();
        if (Model.Props.TryGetValue("newWindow", out var nw) && bool.TryParse(nw?.ToString(), out var b)) newWindow = b;
    }
}
<section class="generic-component button-component" style="text-align:@align">
    <div class="container">
        <a class="site-component-button @size @styleType" href="@link" target="@(newWindow ? "_blank" : null)" rel="@(newWindow ? "noopener" : null)">@text</a>
    </div>
</section>
