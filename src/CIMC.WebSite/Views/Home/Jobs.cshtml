@model PublicSiteListViewModel<Job>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name;
    var isEn = currentCulture.StartsWith("en");
    ViewData["Title"] = Localizer["人才招聘-标题"];
    var jobsModule = ViewData["JobsModule"] as SiteModule;
    var jobsSettingsJson = isEn && !string.IsNullOrWhiteSpace(jobsModule?.SettingsJson_EN) ? jobsModule.SettingsJson_EN : jobsModule?.SettingsJson;
    var jobsSettings = jobsSettingsJson != null ? Newtonsoft.Json.Linq.JObject.Parse(jobsSettingsJson) : ViewData["JobsSettings"] as Newtonsoft.Json.Linq.JObject;
}

<section class="page-hero page-hero--slider" style="background-image:url('@Model.BannerImage')" data-page-hero>
    @foreach (var image in Model.BannerImages)
    {
        <div class="page-hero__slide @(image == Model.BannerImages.FirstOrDefault() ? "is-active" : "")" style="background-image:url('@image')"></div>
    }
    <div class="container reveal">
        <h1>@Model.Title</h1>
        <p>@Model.SubTitle</p>
    </div>
</section>

<section class="section jobs-section">
    <div class="container jobs-layout">
        <aside class="jobs-intro reveal">
            @{
                var intro = jobsSettings?["intro"] as Newtonsoft.Json.Linq.JObject;
                var introTitle = intro?["title"]?.ToString() ?? Localizer["招聘职位"].Value;
                var introDesc = intro?["description"]?.ToString() ?? Localizer["招聘默认介绍"].Value;
                var introContact = intro?["contactInfo"]?.ToString() ?? Localizer["招聘默认联系人"].Value;
            }
            <h2>@introTitle</h2>
            <p>@introDesc</p>
            <p>@Html.Raw(introContact)</p>
        </aside>
        <div class="job-list">
            @foreach (var item in Model.Items)
            {
                <article class="job-item reveal" id="job-@item.Id">
                    <button class="job-item__title" type="button" data-accordion>
                        <span>@(isEn && !string.IsNullOrWhiteSpace(item.JobName_EN) ? item.JobName_EN : item.JobName)</span>
                        <em>@Localizer["展开"]</em>
                    </button>
                    <div class="job-item__body">
                        @Html.Raw(isEn && !string.IsNullOrWhiteSpace(item.Detail_EN) ? item.Detail_EN : item.Detail)
                    </div>
                </article>
            }
        </div>
    </div>
</section>