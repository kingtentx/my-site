@using CIMC.Data
@model Album
@{ Layout="_PublicLayout"; ViewData["Title"]=Model.Title; var category=ViewBag.ProductCategory as Tag; }
<section class="product-detail"><div class="container product-detail-grid"><div class="product-gallery">@if(!string.IsNullOrWhiteSpace(Model.ImageUrl)){<div class="product-main-image"><img src="@Model.ImageUrl" alt="@Model.Title"></div>}</div><div class="product-info">@if(category!=null){<div class="product-breadcrumb"><a href="/">首页</a> &rsaquo; <a href="/products">产品中心</a> &rsaquo; <span>@category.TagName</span></div>}<h1 class="product-title">@Model.Title</h1>@if(!string.IsNullOrWhiteSpace(Model.Description)){<div class="product-summary">@Model.Description</div>}</div></div>@if(!string.IsNullOrWhiteSpace(Model.Detail)){<div class="container product-section"><h2 class="section-title">产品详情</h2><div class="product-description">@Html.Raw(Model.Detail)</div></div>}<div class="container product-footer-nav"><a href="/products" class="back-btn">&lsaquo; 返回列表</a></div></section>
