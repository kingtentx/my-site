@model PublicProductDetailViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name;
    var isEn = currentCulture.StartsWith("en");
    ViewData["Title"] = (isEn && !string.IsNullOrWhiteSpace(Model.Product.Title_EN) ? Model.Product.Title_EN : Model.Product.Title) + Localizer["产品中心标题后缀"];
}

<section class="page-hero page-hero--compact" style="background-image:url('/syle/images/56781343.jpg')">
    <div class="container reveal">
        <h1>@Localizer["产品服务"]</h1>
        <p>@Model.CategoryTitle</p>
    </div>
</section>

<nav class="breadcrumb-bar">
    <div class="container">
        <a href="/">@Localizer["首页"]</a>
        <span>/</span>
        <a href="@Url.Action("Products", "Home", new { category = Model.CategoryType })">@Localizer["产品中心"]</a>
        <span>/</span>
        <a href="@Url.Action("Products", "Home", new { category = Model.CategoryType })">@Model.CategoryTitle</a>
        <span>/</span>
        <em>@(isEn && !string.IsNullOrWhiteSpace(Model.Product.Title_EN) ? Model.Product.Title_EN : Model.Product.Title)</em>
    </div>
</nav>

<section class="section product-detail">
    <div class="container product-detail__top reveal">
        <div class="product-detail__image">
            <img src="@Model.Product.ImageUrl" alt="@(isEn && !string.IsNullOrWhiteSpace(Model.Product.Title_EN) ? Model.Product.Title_EN : Model.Product.Title)" />
        </div>
        <div class="product-detail__summary">
            <span class="eyebrow">@Model.CategoryTitle</span>
            <h1>@(isEn && !string.IsNullOrWhiteSpace(Model.Product.Title_EN) ? Model.Product.Title_EN : Model.Product.Title)</h1>
            <p>@(isEn && !string.IsNullOrWhiteSpace(Model.Product.Description_EN) ? Model.Product.Description_EN : Model.Product.Description)</p>
            <a class="btn btn-primary" href="@Url.Action("Contact", "Home")">@Localizer["联系我们"]</a>
        </div>
    </div>

    <div class="container product-detail__content reveal">
        <h2>@Localizer["箱型参数"]</h2>
        @Html.Raw(isEn && !string.IsNullOrWhiteSpace(Model.Product.Detail_EN) ? Model.Product.Detail_EN : Model.Product.Detail)
    </div>

    @if (Model.RelatedProducts.Any())
    {
        <div class="container related-products reveal">
            <h2>@Localizer["相关箱型"]</h2>
            <div class="product-grid">
                @foreach (var item in Model.RelatedProducts)
                {
                    <article class="product-card">
                        <a class="product-card__media" href="/products/detail-@(item.Id).html">
                            <img src="@item.ImageUrl" alt="@(isEn && !string.IsNullOrWhiteSpace(item.Title_EN) ? item.Title_EN : item.Title)" />
                        </a>
                        <div>
                            <h3><a href="/products/detail-@(item.Id).html">@(isEn && !string.IsNullOrWhiteSpace(item.Title_EN) ? item.Title_EN : item.Title)</a></h3>
                            <p>@(isEn && !string.IsNullOrWhiteSpace(item.Description_EN) ? item.Description_EN : item.Description)</p>
                        </div>
                    </article>
                }
            </div>
        </div>
    }
</section>