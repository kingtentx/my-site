@model MySite.Web.Models.PageRenderModel
@{
    Layout = "_PublicLayout";
}

<div class="page-content">
    @if (Model?.Document?.Nodes != null && Model.Document.Nodes.Count > 0)
    {
        @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Document.cshtml", Model)
    }
    else
    {
        <section class="empty-page">
            <div class="sb-public-container">
                <h2>页面暂无内容</h2>
                <p>请在后台使用新版 Site Builder 完成页面设计并发布。</p>
            </div>
        </section>
    }
</div>