@model PublicSiteHomeViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name;
    var isEn = currentCulture.StartsWith("en");
    ViewData["Title"] = (isEn ? (Model.SiteInfo?.CompanyName_EN ?? "Shanghai CIMC Yangshan Logistics Equipment CO., LTD.") : (Model.SiteInfo?.CompanyName ?? "上海中集洋山物流装备有限公司")) + Localizer["首页标题"];
    var company = isEn ? (Model.SiteInfo?.CompanyName_EN ?? "Shanghai CIMC Yangshan Logistics Equipment CO., LTD.") : (Model.SiteInfo?.CompanyName ?? "上海中集洋山物流装备有限公司");
    SiteModule module(string key) => Model.Modules.FirstOrDefault(p => p.ModuleKey == key);
    var aboutModule = module("about");

    string ModuleTitle(SiteModule m) => isEn && !string.IsNullOrWhiteSpace(m?.Title_EN) ? m.Title_EN : m?.Title;
    string ModuleSubTitle(SiteModule m) => isEn && !string.IsNullOrWhiteSpace(m?.SubTitle_EN) ? m.SubTitle_EN : m?.SubTitle;
    string ModuleSettingsJson(SiteModule m) => isEn && !string.IsNullOrWhiteSpace(m?.SettingsJson_EN) ? m.SettingsJson_EN : m?.SettingsJson;
}
@functions {
    private Newtonsoft.Json.Linq.JObject TryParseSettings(string json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            return Newtonsoft.Json.Linq.JObject.Parse(json);
        }
        catch
        {
            return null;
        }
    }

    private string SettingText(Newtonsoft.Json.Linq.JObject settings, string key, string fallback = "")
    {
        return settings != null && settings[key] != null ? settings[key].ToString() : fallback;
    }
}
<style>
    .builder-generic-section { padding: 80px 0; background: #fff; }
    .builder-generic-section:nth-of-type(even) { background: #f7f9fc; }
    .builder-rich-text .container { color: #4b5563; font-size: 16px; line-height: 1.9; }
    .builder-feature-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
    .builder-feature-card { padding: 28px; border-radius: 18px; background: #fff; box-shadow: 0 14px 40px rgba(15, 23, 42, .08); }
    .builder-feature-card strong { display: inline-flex; width: 38px; height: 38px; align-items: center; justify-content: center; border-radius: 50%; background: #eef6ff; color: #0b5cad; margin-bottom: 14px; }
    .builder-feature-card h3 { margin: 0 0 10px; font-size: 20px; }
    .builder-feature-card p { margin: 0; color: #64748b; line-height: 1.7; }
    .builder-image-text { display: grid; grid-template-columns: 1fr 1fr; gap: 46px; align-items: center; }
    .builder-image-text.is-reverse .builder-image-text__image { order: 2; }
    .builder-image-text__image img { width: 100%; border-radius: 22px; box-shadow: 0 20px 50px rgba(15, 23, 42, .15); }
    .builder-image-text__copy p { color: #64748b; line-height: 1.9; }
    .builder-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
    .builder-stat-card { text-align: center; padding: 28px 18px; border-radius: 16px; background: #fff; box-shadow: 0 12px 34px rgba(15, 23, 42, .08); }
    .builder-stat-card strong { display: block; font-size: 34px; color: #0b5cad; margin-bottom: 8px; }
    .builder-cta { color: #fff; text-align: center; border-radius: 24px; padding: 54px 36px; background: linear-gradient(135deg, #0b2b5c, #16baaa); }
    .builder-cta h2 { color: #fff; margin: 0 0 14px; }
    .builder-cta p { opacity: .88; margin-bottom: 24px; }
    @@media (max-width: 900px) {
        .builder-feature-grid, .builder-image-text, .builder-stats { grid-template-columns: 1fr; }
        .builder-image-text.is-reverse .builder-image-text__image { order: 0; }
    }
</style>

@if (Model.HeroModule != null && Model.HeroImages.Any())
{
    <section class="hero" data-hero>
        @for (var i = 0; i < Model.HeroImages.Count; i++)
        {
            <div class="hero__slide @(i == 0 ? "is-active" : "")" style="background-image:url('@Model.HeroImages[i]')"></div>
        }
        <div class="hero__shade"></div>
        <div class="container hero__content reveal">
            <h1>@(string.IsNullOrWhiteSpace(ModuleTitle(Model.HeroModule)) ? company : ModuleTitle(Model.HeroModule))</h1>
            <p>@(string.IsNullOrWhiteSpace(ModuleSubTitle(Model.HeroModule)) ? Localizer["专业从事标准干货集装箱、特种集装箱及新能源装备的设计、生产与制造，打造智能化、精益化绿色集装箱制造基地。"].Value : ModuleSubTitle(Model.HeroModule))</p>
            <div class="hero__actions">
                @if (!string.IsNullOrWhiteSpace(Model.HeroModule.LinkUrl))
                {
                    <a class="btn btn-primary" href="@Model.HeroModule.LinkUrl">@Localizer["产品服务"]</a>
                }
                @if (!string.IsNullOrWhiteSpace(aboutModule?.LinkUrl))
                {
                    <a class="btn btn-ghost" href="@aboutModule.LinkUrl">@Localizer["了解中集洋山"]</a>
                }
            </div>
        </div>
        @if (Model.HeroImages.Count > 1)
        {
            <div class="hero__pager" data-hero-pager>
                @for (var i = 0; i < Model.HeroImages.Count; i++)
                {
                    <button class="@(i == 0 ? "is-active" : "")" type="button" aria-label="第@(i + 1)张"></button>
                }
            </div>
        }
    </section>
}

@foreach (var currentModule in Model.Modules.Where(p => p.ModuleKey != "hero").OrderBy(p => p.Sort))
{
    var settings = TryParseSettings(ModuleSettingsJson(currentModule));
    var moduleTitle = ModuleTitle(currentModule);
    var moduleSubTitle = ModuleSubTitle(currentModule);

    if (currentModule.ModuleKey == "products")
    {
        <section class="section section-products">
            <div class="section-title reveal">
                <span>@(string.IsNullOrWhiteSpace(moduleSubTitle) ? "Product Service" : moduleSubTitle)</span>
                <h2>@(string.IsNullOrWhiteSpace(moduleTitle) ? Localizer["产品服务_模块"] : moduleTitle)</h2>
            </div>
            <div class="container product-lines">
                @if (settings != null && settings["items"] != null)
                {
                    foreach (var item in settings["items"])
                    {
                        <article class="product-line reveal">
                            <img src="@item["image"]" alt="@item["title"]" />
                            <div>
                                <h3>@item["title"]</h3>
                                <p>@item["description"]</p>
                                <a href="@item["link"]">@Localizer["查看详情"]</a>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <article class="product-line reveal">
                        <img src="~/syle/images/43974676.png" alt="@Localizer["传统业务线"]" />
                        <div>
                            <h3>@Localizer["传统业务线"]</h3>
                            <p>@Localizer["传统业务线描述"]</p>
                            <a href="/products/traditional">@Localizer["查看详情"]</a>
                        </div>
                    </article>
                    <article class="product-line reveal">
                        <img src="~/syle/images/43974836.png" alt="@Localizer["特种业务线"]" />
                        <div>
                            <h3>@Localizer["特种业务线"]</h3>
                            <p>@Localizer["特种业务线描述"]</p>
                            <a href="/products/special">@Localizer["查看详情"]</a>
                        </div>
                    </article>
                    <article class="product-line reveal">
                        <img src="~/syle/images/45999504.png" alt="@Localizer["新业务线"]" />
                        <div>
                            <h3>@Localizer["新业务线"]</h3>
                            <p>@Localizer["新业务线描述"]</p>
                            <a href="/products/new">@Localizer["查看详情"]</a>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
    else if (currentModule.ModuleKey == "about")
    {
        <section class="section about-band">
            <div class="container about-grid">
                <div class="about-copy reveal">
                    <span class="eyebrow">@(string.IsNullOrWhiteSpace(moduleSubTitle) ? "About SYLE" : moduleSubTitle)</span>
                    <h2>@(string.IsNullOrWhiteSpace(moduleTitle) ? company : moduleTitle)</h2>
                    <p>@(settings != null && settings["description"] != null ? settings["description"].ToString() : Localizer["关于我们默认描述"].Value)</p>
                    @if (!string.IsNullOrWhiteSpace(currentModule.LinkUrl))
                    {
                        <a class="text-link" href="@currentModule.LinkUrl">@Localizer["探索企业实力"]</a>
                    }
                </div>
                <div class="metric-panel reveal">
                    @if (settings != null && settings["metrics"] != null)
                    {
                        foreach (var metric in settings["metrics"])
                        {
                            <div><strong>@metric["value"]</strong><span>@metric["label"]</span></div>
                        }
                    }
                    else
                    {
                        <div><strong>25万</strong><span>@Localizer["TEU 设计年产能"]</span></div>
                        <div><strong>33.41万㎡</strong><span>@Localizer["总占地面积"]</span></div>
                        <div><strong>3条</strong><span>@Localizer["完整生产线"]</span></div>
                    }
                </div>
            </div>
        </section>
    }
    else if (currentModule.ModuleKey == "partners")
    {
        if (Model.Partners.Any())
        {
            <section class="section partners-section">
                <div class="section-title reveal">
                    <span>@(string.IsNullOrWhiteSpace(moduleSubTitle) ? "Partners" : moduleSubTitle)</span>
                    <h2>@(string.IsNullOrWhiteSpace(moduleTitle) ? Localizer["合作客户"] : moduleTitle)</h2>
                </div>
                <div class="container partner-grid reveal">
                    @foreach (var partner in Model.Partners)
                    {
                        <div class="partner-logo">
                            <img src="@partner.ImageUrl" alt="@(isEn && !string.IsNullOrWhiteSpace(partner.Title_EN) ? partner.Title_EN : partner.Title)" />
                        </div>
                    }
                </div>
            </section>
        }
    }
    else if (currentModule.ModuleKey == "news")
    {
        <section class="section">
            <div class="section-title reveal">
                <span>@(string.IsNullOrWhiteSpace(moduleSubTitle) ? "News" : moduleSubTitle)</span>
                <h2>@(string.IsNullOrWhiteSpace(moduleTitle) ? Localizer["新闻资讯_模块"] : moduleTitle)</h2>
            </div>
            <div class="container news-grid">
                @foreach (var item in Model.News)
                {
                    <article class="news-card reveal">
                        <a href="/news/info-@(item.Id).html">
                            <img src="@item.ImageUrl" alt="@(isEn && !string.IsNullOrWhiteSpace(item.Title_EN) ? item.Title_EN : item.Title)" />
                            <div>
                                <time>@item.CreationTime?.ToString("yyyy-MM-dd")</time>
                                <h3>@(isEn && !string.IsNullOrWhiteSpace(item.Title_EN) ? item.Title_EN : item.Title)</h3>
                                <p>@(isEn && !string.IsNullOrWhiteSpace(item.Description_EN) ? item.Description_EN : item.Description)</p>
                            </div>
                        </a>
                    </article>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(currentModule.LinkUrl))
            {
                <div class="section-more">
                    <a class="btn btn-outline" href="@currentModule.LinkUrl">@Localizer["更多新闻"]</a>
                </div>
            }
        </section>
    }
    else if (currentModule.ModuleKey == "careers")
    {
        <section class="section careers-band">
            <div class="container careers-grid">
                <div class="reveal">
                    <span class="eyebrow">@(string.IsNullOrWhiteSpace(moduleSubTitle) ? "Join Us" : moduleSubTitle)</span>
                    <h2>@(string.IsNullOrWhiteSpace(moduleTitle) ? Localizer["人才招聘_模块"] : moduleTitle)</h2>
                    <p>@(settings != null && settings["description"] != null ? settings["description"].ToString() : Localizer["招聘默认描述"].Value)</p>
                    @if (!string.IsNullOrWhiteSpace(currentModule.LinkUrl))
                    {
                        <a class="btn btn-primary" href="@currentModule.LinkUrl">@Localizer["查看岗位"]</a>
                    }
                </div>
                <div class="job-mini-list reveal">
                    @foreach (var job in Model.Jobs)
                    {
                        <a href="@Url.Action("Jobs", "Home")#job-@job.Id">
                            <span>@(isEn && !string.IsNullOrWhiteSpace(job.JobName_EN) ? job.JobName_EN : job.JobName)</span>
                            <em>@Localizer["查看详情_招聘"]</em>
                        </a>
                    }
                </div>
            </div>
        </section>
    }
    else if (currentModule.ModuleType == "rich-text" || currentModule.ModuleKey == "rich-text")
    {
        <section class="builder-generic-section builder-rich-text">
            <div class="section-title reveal">
                <span>@moduleSubTitle</span>
                <h2>@moduleTitle</h2>
            </div>
            <div class="container reveal">
                @Html.Raw(SettingText(settings, "html", currentModule.SubTitle))
            </div>
        </section>
    }
    else if (currentModule.ModuleType == "grid" || currentModule.ModuleKey == "feature-grid")
    {
        var columns = SettingText(settings, "columns", "3");
        <section class="builder-generic-section">
            <div class="section-title reveal">
                <span>@moduleSubTitle</span>
                <h2>@moduleTitle</h2>
            </div>
            <div class="container builder-feature-grid reveal" style="grid-template-columns: repeat(@columns, minmax(0, 1fr));">
                @if (settings != null && settings["items"] != null)
                {
                    var i = 1;
                    foreach (var item in settings["items"])
                    {
                        <article class="builder-feature-card">
                            <strong>@(item["icon"] ?? i.ToString("00"))</strong>
                            <h3>@item["title"]</h3>
                            <p>@item["description"]</p>
                        </article>
                        i++;
                    }
                }
            </div>
        </section>
    }
    else if (currentModule.ModuleType == "image-text" || currentModule.ModuleKey == "image-text")
    {
        var image = SettingText(settings, "image", (currentModule.ImageUrl ?? "").Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault());
        var reverse = string.Equals(SettingText(settings, "reverse", "false"), "true", StringComparison.OrdinalIgnoreCase);
        <section class="builder-generic-section">
            <div class="container builder-image-text @(reverse ? "is-reverse" : "")">
                <div class="builder-image-text__image reveal">
                    @if (!string.IsNullOrWhiteSpace(image))
                    {
                        <img src="@image" alt="@moduleTitle" />
                    }
                </div>
                <div class="builder-image-text__copy reveal">
                    <span class="eyebrow">@moduleSubTitle</span>
                    <h2>@moduleTitle</h2>
                    <p>@SettingText(settings, "description", currentModule.SubTitle)</p>
                    @if (!string.IsNullOrWhiteSpace(currentModule.LinkUrl))
                    {
                        <a class="btn btn-outline" href="@currentModule.LinkUrl">@SettingText(settings, "buttonText", "查看详情")</a>
                    }
                </div>
            </div>
        </section>
    }
    else if (currentModule.ModuleType == "stats" || currentModule.ModuleKey == "stats")
    {
        <section class="builder-generic-section">
            <div class="section-title reveal">
                <span>@moduleSubTitle</span>
                <h2>@moduleTitle</h2>
            </div>
            <div class="container builder-stats reveal">
                @if (settings != null && settings["items"] != null)
                {
                    foreach (var item in settings["items"])
                    {
                        <div class="builder-stat-card">
                            <strong>@item["value"]</strong>
                            <span>@item["label"]</span>
                        </div>
                    }
                }
            </div>
        </section>
    }
    else if (currentModule.ModuleType == "cta" || currentModule.ModuleKey == "cta")
    {
        var background = SettingText(settings, "background", "#0b2b5c");
        <section class="builder-generic-section">
            <div class="container">
                <div class="builder-cta reveal" style="background:@background;">
                    <h2>@moduleTitle</h2>
                    <p>@moduleSubTitle</p>
                    @if (!string.IsNullOrWhiteSpace(currentModule.LinkUrl))
                    {
                        <a class="btn btn-primary" href="@currentModule.LinkUrl">@SettingText(settings, "buttonText", "联系我们")</a>
                    }
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="builder-generic-section">
            <div class="section-title reveal">
                <span>@moduleSubTitle</span>
                <h2>@moduleTitle</h2>
            </div>
            <div class="container reveal">
                @if (!string.IsNullOrWhiteSpace(currentModule.ImageUrl))
                {
                    <img src="@currentModule.ImageUrl.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()" alt="@moduleTitle" style="max-width:100%;border-radius:16px;margin-bottom:24px;" />
                }
                <p>@SettingText(settings, "description", currentModule.SubTitle)</p>
                @if (!string.IsNullOrWhiteSpace(currentModule.LinkUrl))
                {
                    <a class="btn btn-outline" href="@currentModule.LinkUrl">查看详情</a>
                }
            </div>
        </section>
    }
}