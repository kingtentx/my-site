@model PublicSiteHomeViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name;
    var isEn = currentCulture.StartsWith("en");
    ViewData["Title"] = (isEn ? (Model.SiteInfo?.CompanyName_EN ?? "Shanghai CIMC Yangshan Logistics Equipment CO., LTD.") : (Model.SiteInfo?.CompanyName ?? "上海中集洋山物流装备有限公司")) + Localizer["首页标题"];
    var company = isEn ? (Model.SiteInfo?.CompanyName_EN ?? "Shanghai CIMC Yangshan Logistics Equipment CO., LTD.") : (Model.SiteInfo?.CompanyName ?? "上海中集洋山物流装备有限公司");
    SiteModule module(string key) => Model.Modules.FirstOrDefault(p => p.ModuleKey == key);
    var productsModule = module("products");
    var aboutModule = module("about");
    var partnersModule = module("partners");
    var newsModule = module("news");
    var careersModule = module("careers");
    var productsSettingsJson = isEn && !string.IsNullOrWhiteSpace(productsModule?.SettingsJson_EN) ? productsModule.SettingsJson_EN : productsModule?.SettingsJson;
    var aboutSettingsJson = isEn && !string.IsNullOrWhiteSpace(aboutModule?.SettingsJson_EN) ? aboutModule.SettingsJson_EN : aboutModule?.SettingsJson;
    var careersSettingsJson = isEn && !string.IsNullOrWhiteSpace(careersModule?.SettingsJson_EN) ? careersModule.SettingsJson_EN : careersModule?.SettingsJson;
    var productsSettings = productsSettingsJson != null ? Newtonsoft.Json.Linq.JObject.Parse(productsSettingsJson) : null;
    var aboutSettings = aboutSettingsJson != null ? Newtonsoft.Json.Linq.JObject.Parse(aboutSettingsJson) : null;
    var careersSettings = careersSettingsJson != null ? Newtonsoft.Json.Linq.JObject.Parse(careersSettingsJson) : null;

    string ModuleTitle(SiteModule m) => isEn && !string.IsNullOrWhiteSpace(m?.Title_EN) ? m.Title_EN : m?.Title;
    string ModuleSubTitle(SiteModule m) => isEn && !string.IsNullOrWhiteSpace(m?.SubTitle_EN) ? m.SubTitle_EN : m?.SubTitle;
}

@if (Model.HeroModule != null && Model.HeroImages.Any())
{
    <section class="hero" data-hero>
        @for (var i = 0; i < Model.HeroImages.Count; i++)
        {
            <div class="hero__slide @(i == 0 ? "is-active" : "")" style="background-image:url('@Model.HeroImages[i]')"></div>
        }
        <div class="hero__shade"></div>
        <div class="container hero__content reveal">
            <h1>@(string.IsNullOrWhiteSpace(ModuleTitle(Model.HeroModule)) ? company : ModuleTitle(Model.HeroModule))</h1>
            <p>@(string.IsNullOrWhiteSpace(ModuleSubTitle(Model.HeroModule)) ? Localizer["专业从事标准干货集装箱、特种集装箱及新能源装备的设计、生产与制造，打造智能化、精益化绿色集装箱制造基地。"].Value : ModuleSubTitle(Model.HeroModule))</p>
            <div class="hero__actions">
                @if (!string.IsNullOrWhiteSpace(Model.HeroModule.LinkUrl))
                {
                    <a class="btn btn-primary" href="@Model.HeroModule.LinkUrl">@Localizer["产品服务"]</a>
                }
                @if (!string.IsNullOrWhiteSpace(aboutModule?.LinkUrl))
                {
                    <a class="btn btn-ghost" href="@aboutModule.LinkUrl">@Localizer["了解中集洋山"]</a>
                }
            </div>
        </div>
        @if (Model.HeroImages.Count > 1)
        {
            <div class="hero__pager" data-hero-pager>
                @for (var i = 0; i < Model.HeroImages.Count; i++)
                {
                    <button class="@(i == 0 ? "is-active" : "")" type="button" aria-label="第@(i + 1)张"></button>
                }
            </div>
        }
    </section>
}

@if (productsModule != null)
{
    <section class="section section-products">
        <div class="section-title reveal">
            <span>@(string.IsNullOrWhiteSpace(ModuleSubTitle(productsModule)) ? "Product Service" : ModuleSubTitle(productsModule))</span>
            <h2>@(string.IsNullOrWhiteSpace(ModuleTitle(productsModule)) ? Localizer["产品服务_模块"] : ModuleTitle(productsModule))</h2>
        </div>
        <div class="container product-lines">
            @if (productsSettings != null && productsSettings["items"] != null)
            {
                foreach (var item in productsSettings["items"])
                {
                    <article class="product-line reveal">
                        <img src="@item["image"]" alt="@item["title"]" />
                        <div>
                            <h3>@item["title"]</h3>
                            <p>@item["description"]</p>
                            <a href="@item["link"]">@Localizer["查看详情"]</a>
                        </div>
                    </article>
                }
            }
            else
            {
                <article class="product-line reveal">
                    <img src="~/syle/images/43974676.png" alt="@Localizer["传统业务线"]" />
                    <div>
                        <h3>@Localizer["传统业务线"]</h3>
                        <p>@Localizer["传统业务线描述"]</p>
                        <a href="/products/traditional">@Localizer["查看详情"]</a>
                    </div>
                </article>
                <article class="product-line reveal">
                    <img src="~/syle/images/43974836.png" alt="@Localizer["特种业务线"]" />
                    <div>
                        <h3>@Localizer["特种业务线"]</h3>
                        <p>@Localizer["特种业务线描述"]</p>
                        <a href="/products/special">@Localizer["查看详情"]</a>
                    </div>
                </article>
                <article class="product-line reveal">
                    <img src="~/syle/images/45999504.png" alt="@Localizer["新业务线"]" />
                    <div>
                        <h3>@Localizer["新业务线"]</h3>
                        <p>@Localizer["新业务线描述"]</p>
                        <a href="/products/new">@Localizer["查看详情"]</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (aboutModule != null)
{
    <section class="section about-band">
        <div class="container about-grid">
            <div class="about-copy reveal">
                <span class="eyebrow">@(string.IsNullOrWhiteSpace(ModuleSubTitle(aboutModule)) ? "About SYLE" : ModuleSubTitle(aboutModule))</span>
                <h2>@(string.IsNullOrWhiteSpace(ModuleTitle(aboutModule)) ? company : ModuleTitle(aboutModule))</h2>
                <p>@(aboutSettings != null && aboutSettings["description"] != null ? aboutSettings["description"].ToString() : Localizer["关于我们默认描述"].Value)</p>
                @if (!string.IsNullOrWhiteSpace(aboutModule.LinkUrl))
                {
                    <a class="text-link" href="@aboutModule.LinkUrl">@Localizer["探索企业实力"]</a>
                }
            </div>
            <div class="metric-panel reveal">
                @if (aboutSettings != null && aboutSettings["metrics"] != null)
                {
                    foreach (var metric in aboutSettings["metrics"])
                    {
                        <div><strong>@metric["value"]</strong><span>@metric["label"]</span></div>
                    }
                }
                else
                {
                    <div><strong>25万</strong><span>@Localizer["TEU 设计年产能"]</span></div>
                    <div><strong>33.41万㎡</strong><span>@Localizer["总占地面积"]</span></div>
                    <div><strong>3条</strong><span>@Localizer["完整生产线"]</span></div>
                }
            </div>
        </div>
    </section>
}

@if (partnersModule != null && Model.Partners.Any())
{
    <section class="section partners-section">
        <div class="section-title reveal">
            <span>@(string.IsNullOrWhiteSpace(ModuleSubTitle(partnersModule)) ? "Partners" : ModuleSubTitle(partnersModule))</span>
            <h2>@(string.IsNullOrWhiteSpace(ModuleTitle(partnersModule)) ? Localizer["合作客户"] : ModuleTitle(partnersModule))</h2>
        </div>
        <div class="container partner-grid reveal">
            @foreach (var partner in Model.Partners)
            {
                <div class="partner-logo">
                    <img src="@partner.ImageUrl" alt="@(isEn && !string.IsNullOrWhiteSpace(partner.Title_EN) ? partner.Title_EN : partner.Title)" />
                </div>
            }
        </div>
    </section>
}

@if (newsModule != null)
{
    <section class="section">
        <div class="section-title reveal">
            <span>@(string.IsNullOrWhiteSpace(ModuleSubTitle(newsModule)) ? "News" : ModuleSubTitle(newsModule))</span>
            <h2>@(string.IsNullOrWhiteSpace(ModuleTitle(newsModule)) ? Localizer["新闻资讯_模块"] : ModuleTitle(newsModule))</h2>
        </div>
        <div class="container news-grid">
            @foreach (var item in Model.News)
            {
                <article class="news-card reveal">
                    <a href="/news/info-@(item.Id).html">
                        <img src="@item.ImageUrl" alt="@(isEn && !string.IsNullOrWhiteSpace(item.Title_EN) ? item.Title_EN : item.Title)" />
                        <div>
                            <time>@item.CreationTime?.ToString("yyyy-MM-dd")</time>
                            <h3>@(isEn && !string.IsNullOrWhiteSpace(item.Title_EN) ? item.Title_EN : item.Title)</h3>
                            <p>@(isEn && !string.IsNullOrWhiteSpace(item.Description_EN) ? item.Description_EN : item.Description)</p>
                        </div>
                    </a>
                </article>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(newsModule.LinkUrl))
        {
            <div class="section-more">
                <a class="btn btn-outline" href="@newsModule.LinkUrl">@Localizer["更多新闻"]</a>
            </div>
        }
    </section>
}

@if (careersModule != null)
{
    <section class="section careers-band">
        <div class="container careers-grid">
            <div class="reveal">
                <span class="eyebrow">@(string.IsNullOrWhiteSpace(ModuleSubTitle(careersModule)) ? "Join Us" : ModuleSubTitle(careersModule))</span>
                <h2>@(string.IsNullOrWhiteSpace(ModuleTitle(careersModule)) ? Localizer["人才招聘_模块"] : ModuleTitle(careersModule))</h2>
                <p>@(careersSettings != null && careersSettings["description"] != null ? careersSettings["description"].ToString() : Localizer["招聘默认描述"].Value)</p>
                @if (!string.IsNullOrWhiteSpace(careersModule.LinkUrl))
                {
                    <a class="btn btn-primary" href="@careersModule.LinkUrl">@Localizer["查看岗位"]</a>
                }
            </div>
            <div class="job-mini-list reveal">
                @foreach (var job in Model.Jobs)
                {
                    <a href="@Url.Action("Jobs", "Home")#job-@job.Id">
                        <span>@(isEn && !string.IsNullOrWhiteSpace(job.JobName_EN) ? job.JobName_EN : job.JobName)</span>
                        <em>@Localizer["查看详情_招聘"]</em>
                    </a>
                }
            </div>
        </div>
    </section>
}