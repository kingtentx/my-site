@{
    Layout = null;
}
@model FooterModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>底部信息</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
    <link rel="stylesheet" href="~/resource/css/site.css" media="all">
    <style>
        .upload-card {
            width: 160px;
            height: 160px;
            border: 2px dashed #d2d2d2;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            background: #f9f9f9;
            transition: all .25s;
            overflow: hidden;
        }
        .upload-card:hover {
            border-color: #009688;
            background: #f0faf8;
        }
        .upload-card i {
            font-size: 36px;
            color: #c2c2c2;
            margin-bottom: 8px;
            transition: color .25s;
        }
        .upload-card:hover i {
            color: #009688;
        }
        .upload-card span {
            font-size: 13px;
            color: #999;
        }
        .upload-preview {
            width: 160px;
            height: 160px;
            border-radius: 6px;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,.12);
            position: relative;
        }
        .upload-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .upload-preview .mask {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background .2s;
            opacity: 0;
        }
        .upload-preview:hover .mask {
            background: rgba(0,0,0,.45);
            opacity: 1;
        }
        .mask .mask-btn {
            width: 32px;
            height: 32px;
            line-height: 32px;
            text-align: center;
            background: rgba(255,255,255,.9);
            border-radius: 50%;
            cursor: pointer;
            color: #666;
            font-size: 16px;
            transition: all .2s;
            border: 0;
        }
        .mask .mask-btn:hover {
            background: #fff;
            color: #ff5722;
        }
        .img_info {
            margin-bottom: 15px;
        }
    </style>
</head>
<body>
    <div class="layui-fluid">
        <form class="layui-form" lay-filter="form-group">
            <div class="layui-card">
                <div class="layui-card-header">底部信息</div>
                <div class="layui-card-body" style="padding: 15px;">
                    <div class="img_info">
                        <label class="layui-form-label">二维码图片</label>
                        <div class="layui-input-block">
                            <div id="imgUploadWrap">
                                @if (!string.IsNullOrWhiteSpace(Model.ImageA))
                                {
                                    <div class="upload-preview">
                                        <img src="@Model.ImageA" alt="二维码" />
                                        <div class="mask">
                                            <button type="button" class="mask-btn" data-action="remove" title="删除"><i class="layui-icon layui-icon-delete"></i></button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="upload-card">
                                        <i class="layui-icon layui-icon-upload-drag"></i>
                                        <span>点击选择图片</span>
                                    </div>
                                }
                            </div>
                            <input type="hidden" name="ImageA" value="@Html.Raw(Model.ImageA)">
                            <div class="layui-form-mid layui-word-aux">请上传分辨率300*300的图片</div>
                        </div>
                    </div>
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">公司简介</label>
                        <div class="layui-input-block">
                            <textarea name="CompanyInfo" placeholder="请输入公司简介" class="layui-textarea">@Html.Raw(Model.CompanyInfo)</textarea>
                        </div>
                    </div>
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">公司简介(EN)</label>
                        <div class="layui-input-block">
                            <textarea name="CompanyInfo_EN" placeholder="Please enter company info" class="layui-textarea">@Html.Raw(Model.CompanyInfo_EN)</textarea>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">地址</label>
                        <div class="layui-input-block">
                            <input type="text" name="Address" lay-verify="required" placeholder="请输入地址" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.Address)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">地址(EN)</label>
                        <div class="layui-input-block">
                            <input type="text" name="Address_EN" placeholder="Please enter address" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.Address_EN)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">电话</label>
                        <div class="layui-input-block">
                            <input type="text" name="Phone" lay-verify="tellphone" placeholder="请输入电话" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.Phone)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">邮箱</label>
                        <div class="layui-input-block">
                            <input type="text" name="Email" lay-verify="email" placeholder="请输入邮箱" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.Email)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">版权信息</label>
                        <div class="layui-input-block">
                            <input type="text" name="Copyright" lay-verify="required" placeholder="请输入版权信息" autocomplete="off" class="layui-input" value="@Html.Raw(Model.Copyright)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">版权信息(EN)</label>
                        <div class="layui-input-block">
                            <input type="text" name="Copyright_EN" placeholder="Please enter copyright" autocomplete="off" class="layui-input" value="@Html.Raw(Model.Copyright_EN)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">备案号</label>
                        <div class="layui-input-block">
                            <input type="text" name="RecordNo" lay-verify="required" placeholder="请输入网站备案号" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.RecordNo)">
                        </div>
                    </div>
                </div>
                <div class="layui-form-item layui-layout-admin">
                    <div class="layui-input-block">
                        <div class="layui-footer" style="left: 0;">
                            <button class="layui-btn" lay-submit="" lay-filter="form-page">立即保存</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['form'], function () {
            var $ = layui.$
                , layer = layui.layer
                , form = layui.form;

            form.render();

            function openImageSelector(wrapId, inputName) {
                window._imgSelectorWrap = wrapId;
                window._imgSelectorInput = inputName;
                layer.open({ type: 2, title: '选择图片', area: ['900px', '680px'], content: '/Admin/ImageSelector' });
            }

            $('#imgUploadWrap').on('click', '.upload-card, .upload-preview', function (e) {
                if ($(e.target).closest('[data-action="remove"]').length) return;
                openImageSelector('imgUploadWrap', 'ImageA');
            }).on('click', '[data-action="remove"]', function () {
                layer.confirm("确认删除吗？", function (i) {
                    $('#imgUploadWrap').html('<div class="upload-card"><i class="layui-icon layui-icon-upload-drag"></i><span>点击选择图片</span></div>');
                    $('input[name="ImageA"]').val('');
                    layer.close(i);
                });
            });

            window.addEventListener('message', function (e) {
                if (e.data && e.data.type === 'imageSelected') {
                    var url = e.data.url;
                    $('#' + window._imgSelectorWrap).html('<div class="upload-preview"><img src="' + url + '" alt="二维码"><div class="mask"><button type="button" class="mask-btn" data-action="remove" title="删除"><i class="layui-icon layui-icon-delete"></i></button></div></div>');
                    $('input[name="' + window._imgSelectorInput + '"]').val(url);
                }
            });

            /* 自定义验证规则 */
            var mobile = /^1[3456789]\d{9}$/, phone = /^\d{3,4}-\d{7,8}$/;
            form.verify({
                required: function (value) {
                    if (value.length < 1) {
                        return '必填项不能为空';
                    }
                },
                tellphone: function (value) {
                    if ((!phone.test(value) && !mobile.test(value))) {
                        return '请输入正确座机号码或手机号';
                    }
                }
            });

            ///* 监听提交 */
            form.on('submit(form-page)', function (data) {
                console.log(data.field);
                if (data.field.ImageA == '') {
                    layer.msg('至少上传一张图片', { icon: 5 });
                    return false;
                }
                layer.confirm('确认保存信息吗？', function (index) {
                    $.ajax({
                        type: "post",
                        url: '/Admin/FooterInfo',
                        data: data.field,
                        dataType: "json",
                        success: function (res) {
                            layer.close(index);
                            if (res.code == 200) {
                                layer.msg(res.message);
                            }
                            else {
                                layer.msg(res.msg, { icon: 5 });
                            }
                        }
                    });

                });
                //阻止表单跳转。如果需要表单跳转，去掉这段即可。
                return false;
            });
        });
    </script>
</body>
</html>

