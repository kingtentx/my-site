<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>分类管理</title><style>body{margin:0;font-family:Arial,'Microsoft YaHei';background:#f5f7fb}.top{height:56px;background:#111827;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 22px}.top a{color:#dbeafe;margin-left:12px;text-decoration:none}.wrap{padding:22px}.card{background:white;border-radius:10px;padding:18px;box-shadow:0 4px 18px #0001}button{border:0;border-radius:6px;background:#2563eb;color:white;padding:8px 12px;cursor:pointer}button.red{background:#dc2626}button.gray{background:#6b7280}.active{background:#111827}input,select{border:1px solid #d1d5db;border-radius:6px;padding:8px}table{width:100%;border-collapse:collapse;margin-top:14px}td,th{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left}</style></head><body><div class="top"><b>分类管理</b><div><a href="/WebsiteBuilder/Contents">内容管理</a><a href="/WebsiteBuilder/Pages">页面</a><a href="/website" target="_blank">前台</a></div></div><div class="wrap"><div class="card"><p><button id="bnews" class="active" onclick="sw('news')">新闻分类</button> <button id="bproduct" onclick="sw('product')">产品分类</button></p><input id="categoryName" placeholder="分类名称"><input id="categoryCode" placeholder="分类编码"><input id="sort" type="number" placeholder="排序"><select id="isEnabled"><option value="true">启用</option><option value="false">停用</option></select><button onclick="save()">保存</button><table><thead><tr><th>ID</th><th>名称</th><th>编码</th><th>排序</th><th>状态</th><th>操作</th></tr></thead><tbody id="rows"></tbody></table></div></div><script>let type='news',id=0;function url(){return type==='news'?'/api/news-categories':'/api/product-categories'}async function api(u,o){let r=await fetch(u,Object.assign({headers:{'Content-Type':'application/json'}},o||{}));if(!r.ok){let m='请求失败';try{m=(await r.json()).message||m}catch(e){}throw Error(m)}return await r.json()}function sw(t){type=t;id=0;bnews.className=t==='news'?'active':'';bproduct.className=t==='product'?'active':'';clearForm();load()}async function load(){let d=await api(url());rows.innerHTML=d.map(x=>`<tr><td>${x.id}</td><td>${x.categoryName}</td><td>${x.categoryCode||''}</td><td>${x.sort}</td><td>${x.isEnabled?'启用':'停用'}</td><td><button class="gray" onclick='edit(${JSON.stringify(x)})'>编辑</button> <button class="red" onclick="del(${x.id})">删除</button></td></tr>`).join('')}function edit(x){id=x.id;categoryName.value=x.categoryName||'';categoryCode.value=x.categoryCode||'';sort.value=x.sort||0;isEnabled.value=x.isEnabled?'true':'false'}function clearForm(){id=0;categoryName.value=categoryCode.value=sort.value='';isEnabled.value='true'}async function save(){await api(id?url()+'/'+id:url(),{method:id?'PUT':'POST',body:JSON.stringify({categoryName:categoryName.value,categoryCode:categoryCode.value,sort:Number(sort.value||0),isEnabled:isEnabled.value==='true'})});clearForm();load()}async function del(i){if(confirm('确定删除？')){await api(url()+'/'+i,{method:'DELETE'});load()}}load().catch(e=>alert(e.message));</script></body></html>