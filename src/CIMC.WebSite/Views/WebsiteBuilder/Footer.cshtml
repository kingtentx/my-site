@{ Layout = null; }
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>页脚设置</title><style>body{margin:0;font-family:Arial,'Microsoft YaHei';background:#f5f7fb}.top{height:56px;background:#111827;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 22px}.top a{color:#dbeafe;margin-left:12px;text-decoration:none}.wrap{padding:22px}.card{background:white;border-radius:10px;padding:18px;box-shadow:0 4px 18px #0001}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.full{grid-column:1/-1}input,textarea{border:1px solid #d1d5db;border-radius:6px;padding:8px;width:100%;box-sizing:border-box}button{border:0;border-radius:6px;background:#2563eb;color:white;padding:9px 14px}</style></head><body><div class="top"><b>页脚设置</b><div><a href="/WebsiteBuilder/Navigation">导航</a><a href="/WebsiteBuilder/Banners">Banner</a><a href="/WebsiteBuilder/Materials">素材</a><a href="/website" target="_blank">前台</a></div></div><div class="wrap"><div class="card"><div class="grid"><input id="companyName" placeholder="公司名称"><input id="logo" placeholder="Logo URL"><textarea class="full" id="description" rows="3" placeholder="公司简介"></textarea><input id="tel" placeholder="电话"><input id="email" placeholder="邮箱"><input class="full" id="address" placeholder="地址"><input id="qrCode" placeholder="二维码图片URL"><input id="icpNo" placeholder="ICP备案号"><input id="policeNo" placeholder="公安备案号"><input id="copyright" placeholder="版权信息"><input id="backgroundColor" placeholder="背景颜色 #111827"><input id="textColor" placeholder="文字颜色 #ffffff"><textarea class="full" id="friendLinksJson" rows="4" placeholder='友情链接JSON，如 [{"title":"官网","url":"https://example.com"}]'></textarea></div><p><button onclick="save()">保存页脚</button></p></div></div><script>let id=0;async function api(u,o){let r=await fetch(u,Object.assign({headers:{'Content-Type':'application/json'}},o||{}));if(!r.ok)throw Error('请求失败');return await r.json()}async function load(){let x=await api('/api/footer');id=x.id||0;for(let k of ['companyName','logo','description','tel','email','address','qrCode','icpNo','policeNo','copyright','backgroundColor','textColor','friendLinksJson'])document.getElementById(k).value=x[k]||''}async function save(){let m={id};for(let k of ['companyName','logo','description','tel','email','address','qrCode','icpNo','policeNo','copyright','backgroundColor','textColor','friendLinksJson'])m[k]=document.getElementById(k).value;await api('/api/footer',{method:'PUT',body:JSON.stringify(m)});alert('保存成功')}load().catch(e=>alert(e.message));</script></body></html>