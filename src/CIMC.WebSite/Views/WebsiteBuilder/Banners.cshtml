@{ Layout = null; }
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>Banner管理</title><style>body{margin:0;font-family:Arial,'Microsoft YaHei';background:#f5f7fb}.top{height:56px;background:#111827;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 22px}.top a{color:#dbeafe;margin-left:12px;text-decoration:none}.wrap{padding:22px}.card{background:white;border-radius:10px;padding:18px;box-shadow:0 4px 18px #0001}input,textarea,select{border:1px solid #d1d5db;border-radius:6px;padding:8px;width:100%;box-sizing:border-box}button{border:0;border-radius:6px;background:#2563eb;color:white;padding:8px 12px;cursor:pointer}button.red{background:#dc2626}button.gray{background:#6b7280}.form{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.full{grid-column:1/-1}table{width:100%;border-collapse:collapse;margin-top:14px}td,th{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left}</style></head><body><div class="top"><b>Banner管理</b><div><a href="/WebsiteBuilder/Navigation">导航</a><a href="/WebsiteBuilder/Footer">页脚</a><a href="/WebsiteBuilder/Materials">素材</a><a href="/website" target="_blank">前台</a></div></div><div class="wrap"><div class="card"><div class="form"><input id="title" placeholder="标题"><input id="subtitle" placeholder="副标题"><input id="imageUrl" placeholder="图片URL"><input id="videoUrl" placeholder="视频URL"><input id="buttonText" placeholder="按钮文字"><input id="buttonLink" placeholder="按钮链接"><input id="height" type="number" placeholder="高度"><input id="sort" type="number" placeholder="排序"><select id="isEnabled"><option value="true">启用</option><option value="false">停用</option></select><button onclick="save()">保存</button><button class="gray" onclick="clearForm()">清空</button></div><table><thead><tr><th>ID</th><th>标题</th><th>图片</th><th>高度</th><th>排序</th><th>状态</th><th>操作</th></tr></thead><tbody id="rows"></tbody></table></div></div><script>let id=0;async function api(u,o){let r=await fetch(u,Object.assign({headers:{'Content-Type':'application/json'}},o||{}));if(!r.ok){let m='请求失败';try{m=(await r.json()).message||m}catch(e){}throw Error(m)}return await r.json()}async function load(){let d=await api('/api/banners');rows.innerHTML=d.map(x=>`<tr><td>${x.id}</td><td>${x.title||''}</td><td>${x.imageUrl?'<img src="'+x.imageUrl+'" style="height:42px">':''}</td><td>${x.height}</td><td>${x.sort}</td><td>${x.isEnabled?'启用':'停用'}</td><td><button class="gray" onclick='edit(${JSON.stringify(x)})'>编辑</button> <button class="red" onclick="del(${x.id})">删除</button></td></tr>`).join('')}function edit(x){id=x.id;for(let k of ['title','subtitle','imageUrl','videoUrl','buttonText','buttonLink','height','sort'])document.getElementById(k).value=x[k]||'';isEnabled.value=x.isEnabled?'true':'false'}function clearForm(){id=0;for(let k of ['title','subtitle','imageUrl','videoUrl','buttonText','buttonLink','height','sort'])document.getElementById(k).value='';isEnabled.value='true'}async function save(){let m={};for(let k of ['title','subtitle','imageUrl','videoUrl','buttonText','buttonLink'])m[k]=document.getElementById(k).value;m.height=Number(height.value||520);m.sort=Number(sort.value||0);m.isEnabled=isEnabled.value==='true';await api(id?'/api/banners/'+id:'/api/banners',{method:id?'PUT':'POST',body:JSON.stringify(m)});clearForm();load()}async function del(i){if(confirm('确定删除？')){await api('/api/banners/'+i,{method:'DELETE'});load()}}load().catch(e=>alert(e.message));</script></body></html>