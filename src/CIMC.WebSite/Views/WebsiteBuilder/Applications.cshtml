@{ Layout = null; }
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>简历投递</title><style>body{margin:0;font-family:Arial,'Microsoft YaHei';background:#f5f7fb}.top{height:56px;background:#111827;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 22px}.top a{color:#dbeafe;margin-left:12px;text-decoration:none}.wrap{padding:22px}.card{background:white;border-radius:10px;padding:18px;box-shadow:0 4px 18px #0001}button{border:0;border-radius:6px;background:#2563eb;color:white;padding:8px 12px;cursor:pointer}table{width:100%;border-collapse:collapse;margin-top:14px}td,th{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left}select{border:1px solid #d1d5db;border-radius:6px;padding:6px}</style></head><body><div class="top"><b>简历投递</b><div><a href="/WebsiteBuilder/Contents">招聘管理</a><a href="/WebsiteBuilder/Pages">页面</a><a href="/website" target="_blank">前台</a></div></div><div class="wrap"><div class="card"><button onclick="load()">刷新</button><table><thead><tr><th>ID</th><th>岗位ID</th><th>姓名</th><th>电话</th><th>邮箱</th><th>简历</th><th>备注</th><th>时间</th><th>状态</th></tr></thead><tbody id="rows"></tbody></table></div></div><script>async function api(u,o){let r=await fetch(u,Object.assign({headers:{'Content-Type':'application/json'}},o||{}));if(!r.ok)throw Error('请求失败');return await r.json()}async function load(){let d=await api('/api/job-applies');rows.innerHTML=d.map(x=>`<tr><td>${x.id}</td><td>${x.jobId}</td><td>${x.applicantName||''}</td><td>${x.phone||''}</td><td>${x.email||''}</td><td>${x.resumeFile?`<a href="${x.resumeFile}" target="_blank">查看</a>`:''}</td><td>${x.remark||''}</td><td>${x.createTime||''}</td><td><select onchange="status(${x.id},this.value)"><option value="0" ${x.status==0?'selected':''}>待处理</option><option value="1" ${x.status==1?'selected':''}>已联系</option><option value="2" ${x.status==2?'selected':''}>不合适</option></select></td></tr>`).join('')}async function status(id,s){await api('/api/job-applies/'+id+'/status/'+s,{method:'PUT'});load()}load().catch(e=>alert(e.message));</script></body></html>