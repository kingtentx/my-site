@{ Layout = null; }
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>内容管理</title><style>body{margin:0;font-family:Arial,'Microsoft YaHei';background:#f5f7fb}.top{height:56px;background:#111827;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 22px}.top a{color:#dbeafe;margin-left:14px;text-decoration:none}.wrap{padding:22px}.card{background:white;border-radius:10px;padding:18px;box-shadow:0 4px 18px #0001}button{border:0;border-radius:6px;background:#2563eb;color:white;padding:8px 12px;cursor:pointer}button.red{background:#dc2626}button.green{background:#16a34a}button.gray{background:#6b7280}.active{background:#111827}input,textarea{border:1px solid #d1d5db;border-radius:6px;padding:8px;box-sizing:border-box;width:100%}.edit{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:12px;background:#f8fafc;padding:12px;border-radius:10px}.full{grid-column:1/-1}table{width:100%;border-collapse:collapse;margin-top:12px}td,th{border-bottom:1px solid #e5e7eb;padding:10px;text-align:left}</style></head><body><div class="top"><b>内容管理</b><div><a href="/WebsiteBuilder/Site">站点设置</a><a href="/WebsiteBuilder/Pages">页面管理</a><a href="/website" target="_blank">前台</a></div></div><div class="wrap"><div class="card"><p><button id="bnews" class="active" onclick="sw('news')">新闻</button> <button id="bproducts" onclick="sw('products')">产品</button> <button id="bjobs" onclick="sw('jobs')">招聘</button></p><div class="edit"><input id="title" placeholder="标题/名称"><input id="summary" placeholder="摘要/部门"><input id="extra" placeholder="封面/地点"><textarea id="content" class="full" rows="4" placeholder="详情内容"></textarea><button onclick="save()">保存</button><button class="gray" onclick="clearForm()">清空</button></div><table><thead><tr><th>名称</th><th>摘要</th><th>状态</th><th>操作</th></tr></thead><tbody id="rows"></tbody></table></div></div><script>let type='news',id=0;async function api(u,o){let r=await fetch(u,Object.assign({headers:{'Content-Type':'application/json'}},o||{}));if(!r.ok){let m='请求失败';try{m=(await r.json()).message||m}catch(e){}throw Error(m)}return await r.json()}function sw(t){type=t;id=0;for(let x of ['news','products','jobs'])document.getElementById('b'+x).className=x===t?'active':'';clearForm();load()}async function load(){let d=await api('/api/'+type+'?pageSize=100');rows.innerHTML=d.items.map(x=>{let n=x.title||x.productName||x.jobTitle||'';let s=x.summary||x.department||x.workLocation||'';return `<tr><td>${n}</td><td>${s}</td><td>${x.status===1?'已发布':'草稿'}</td><td><button onclick="edit(${x.id})">编辑</button> <button class="green" onclick="pub(${x.id})">发布</button> <button class="red" onclick="del(${x.id})">删除</button></td></tr>`}).join('')}async function edit(i){let x=await api('/api/'+type+'/'+i);id=i;title.value=x.title||x.productName||x.jobTitle||'';summary.value=x.summary||x.department||'';extra.value=x.coverImage||x.workLocation||'';content.value=x.content||x.description||x.responsibilities||''}function model(){if(type==='news')return{title:title.value,summary:summary.value,coverImage:extra.value,content:content.value};if(type==='products')return{productName:title.value,summary:summary.value,coverImage:extra.value,description:content.value};return{jobTitle:title.value,department:summary.value,workLocation:extra.value,responsibilities:content.value,recruitCount:1}}async function save(){await api(id?'/api/'+type+'/'+id:'/api/'+type,{method:id?'PUT':'POST',body:JSON.stringify(model())});clearForm();load()}async function pub(i){await api('/api/'+type+'/'+i+'/'+(type==='products'?'online':'publish'),{method:'POST'});load()}async function del(i){if(confirm('确定删除？')){await api('/api/'+type+'/'+i,{method:'DELETE'});load()}}function clearForm(){id=0;title.value=summary.value=extra.value=content.value=''}load().catch(e=>alert(e.message));</script></body></html>