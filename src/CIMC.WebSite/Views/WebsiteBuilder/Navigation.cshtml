@{ Layout = null; }
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>导航管理</title><style>body{margin:0;font-family:Arial,'Microsoft YaHei';background:#f5f7fb}.top{height:56px;background:#111827;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 22px}.top a{color:#dbeafe;margin-left:12px;text-decoration:none}.wrap{padding:22px}.card{background:white;border-radius:10px;padding:18px;box-shadow:0 4px 18px #0001}input,select{border:1px solid #d1d5db;border-radius:6px;padding:8px}button{border:0;border-radius:6px;background:#2563eb;color:white;padding:8px 12px;cursor:pointer}button.red{background:#dc2626}button.gray{background:#6b7280}table{width:100%;border-collapse:collapse;margin-top:14px}td,th{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left}.form{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}</style></head><body><div class="top"><b>导航管理</b><div><a href="/WebsiteBuilder/Pages">页面</a><a href="/WebsiteBuilder/Banners">Banner</a><a href="/WebsiteBuilder/Footer">页脚</a><a href="/WebsiteBuilder/Materials">素材</a><a href="/website" target="_blank">前台</a></div></div><div class="wrap"><div class="card"><div class="form"><input id="title" placeholder="导航名称"><input id="linkUrl" placeholder="链接，如 /about"><input id="sort" type="number" placeholder="排序"><select id="target"><option value="_self">当前窗口</option><option value="_blank">新窗口</option></select><select id="isEnabled"><option value="true">启用</option><option value="false">停用</option></select><button onclick="save()">保存</button></div><table><thead><tr><th>ID</th><th>名称</th><th>链接</th><th>排序</th><th>状态</th><th>操作</th></tr></thead><tbody id="rows"></tbody></table></div></div><script>let id=0;async function api(u,o){let r=await fetch(u,Object.assign({headers:{'Content-Type':'application/json'}},o||{}));if(!r.ok){let m='请求失败';try{m=(await r.json()).message||m}catch(e){}throw Error(m)}return await r.json()}async function load(){let d=await api('/api/navigation');rows.innerHTML=d.map(x=>`<tr><td>${x.id}</td><td>${x.title||''}</td><td>${x.linkUrl||''}</td><td>${x.sort}</td><td>${x.isEnabled?'启用':'停用'}</td><td><button class="gray" onclick='edit(${JSON.stringify(x)})'>编辑</button> <button class="red" onclick="del(${x.id})">删除</button></td></tr>`).join('')}function edit(x){id=x.id;title.value=x.title||'';linkUrl.value=x.linkUrl||'';sort.value=x.sort||0;target.value=x.target||'_self';isEnabled.value=x.isEnabled?'true':'false'}function clear(){id=0;title.value=linkUrl.value=sort.value='';target.value='_self';isEnabled.value='true'}async function save(){await api(id?'/api/navigation/'+id:'/api/navigation',{method:id?'PUT':'POST',body:JSON.stringify({title:title.value,linkType:'page',linkUrl:linkUrl.value,sort:Number(sort.value||0),target:target.value,isEnabled:isEnabled.value==='true'})});clear();load()}async function del(i){if(confirm('确定删除？')){await api('/api/navigation/'+i,{method:'DELETE'});load()}}load().catch(e=>alert(e.message));</script></body></html>