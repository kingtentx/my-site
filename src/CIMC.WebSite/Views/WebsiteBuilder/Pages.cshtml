@{ Layout = null; }
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>页面管理</title><style>body{margin:0;font-family:Arial,'Microsoft YaHei';background:#f5f7fb}.top{height:56px;background:#111827;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 22px}.top a{color:#dbeafe;margin-left:14px;text-decoration:none}.wrap{padding:22px}.card{background:white;border-radius:10px;padding:18px;box-shadow:0 4px 18px #0001}button{border:0;border-radius:6px;background:#2563eb;color:white;padding:8px 12px;cursor:pointer}button.gray{background:#6b7280}button.red{background:#dc2626}button.green{background:#16a34a}input,textarea,select{border:1px solid #d1d5db;border-radius:6px;padding:8px;width:100%;box-sizing:border-box}table{width:100%;border-collapse:collapse;margin-top:14px}th,td{padding:10px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:14px}.bar{display:flex;gap:8px;justify-content:space-between}.modal{display:none;position:fixed;inset:0;background:#0006;align-items:center;justify-content:center}.box{background:white;border-radius:12px;padding:20px;width:680px;max-width:94vw}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.full{grid-column:1/-1}.badge{border-radius:999px;padding:3px 8px;font-size:12px;background:#fef3c7}.ok{background:#dcfce7;color:#166534}</style></head><body><div class="top"><b>拖拉拽企业建站后台</b><div><a href="/WebsiteBuilder/Site">站点设置</a><a href="/WebsiteBuilder/Pages">页面管理</a><a href="/WebsiteBuilder/Contents">内容管理</a><a target="_blank" href="/website">前台</a></div></div><div class="wrap"><div class="card"><div class="bar"><div><input id="kw" style="width:240px" placeholder="页面名称/路径"><button onclick="load()">查询</button></div><button onclick="openEdit()">新增页面</button></div><table><thead><tr><th>ID</th><th>名称</th><th>路径</th><th>标题</th><th>状态</th><th>首页</th><th>操作</th></tr></thead><tbody id="rows"></tbody></table></div></div><div id="modal" class="modal"><div class="box"><h3 id="mt">新增页面</h3><div class="grid"><input id="pageName" placeholder="页面名称"><input id="pageCode" placeholder="页面编码"><input id="pagePath" placeholder="访问路径，如 /about"><input id="pageTitle" placeholder="页面标题"><input id="sort" type="number" placeholder="排序"><select id="isHome"><option value="false">非首页</option><option value="true">设为首页</option></select><input class="full" id="seoKeywords" placeholder="SEO关键词"><textarea class="full" id="seoDescription" rows="3" placeholder="SEO描述"></textarea></div><p style="text-align:right"><button class="gray" onclick="closeEdit()">取消</button> <button onclick="save()">保存</button></p></div></div><script>let editId=0;async function api(u,o){let r=await fetch(u,Object.assign({headers:{'Content-Type':'application/json'}},o||{}));if(!r.ok){let m='请求失败';try{m=(await r.json()).message||m}catch(e){}throw Error(m)}return await r.json()}function st(v){return v===1?'<span class="badge ok">已发布</span>':'<span class="badge">草稿</span>'}async function load(){let d=await api('/api/pages?keyword='+encodeURIComponent(kw.value||'')+'&pageSize=100');rows.innerHTML=d.items.map(x=>`<tr><td>${x.id}</td><td>${x.pageName||''}</td><td>${x.pagePath||''}</td><td>${x.pageTitle||''}</td><td>${st(x.status)}</td><td>${x.isHome?'是':'否'}</td><td><button onclick="location.href='/WebsiteBuilder/Designer/${x.id}'">装修</button> <button class="green" onclick="pub(${x.id})">发布</button> <button class="gray" onclick="window.open('/website/preview/${x.id}')">预览</button> <button class="gray" onclick="edit(${x.id})">编辑</button> <button class="red" onclick="del(${x.id})">删除</button></td></tr>`).join('')}function openEdit(){editId=0;mt.innerText='新增页面';['pageName','pageCode','pagePath','pageTitle','sort','seoKeywords','seoDescription'].forEach(i=>document.getElementById(i).value='');isHome.value='false';modal.style.display='flex'}function closeEdit(){modal.style.display='none'}async function edit(id){let x=await api('/api/pages/'+id);editId=id;mt.innerText='编辑页面';for(let k of ['pageName','pageCode','pagePath','pageTitle','sort','seoKeywords','seoDescription'])document.getElementById(k).value=x[k]||'';isHome.value=x.isHome?'true':'false';modal.style.display='flex'}async function save(){let m={};for(let k of ['pageName','pageCode','pagePath','pageTitle','seoKeywords','seoDescription'])m[k]=document.getElementById(k).value;m.sort=Number(sort.value||0);m.isHome=isHome.value==='true';await api(editId?'/api/pages/'+editId:'/api/pages',{method:editId?'PUT':'POST',body:JSON.stringify(m)});closeEdit();load()}async function pub(id){await api('/api/pages/'+id+'/publish',{method:'POST'});alert('发布成功');load()}async function del(id){if(confirm('确定删除？')){await api('/api/pages/'+id,{method:'DELETE'});load()}}load().catch(e=>alert(e.message));</script></body></html>