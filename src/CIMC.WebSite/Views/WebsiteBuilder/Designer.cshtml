@{ Layout = null; var pageId = ViewData["PageId"] ?? 0; }
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>页面装修</title><style>body{margin:0;font-family:Arial,'Microsoft YaHei';background:#eef2f7}.top{height:56px;background:#111827;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 18px}.top a{color:#dbeafe;text-decoration:none}.main{height:calc(100vh - 56px);display:grid;grid-template-columns:230px 1fr 340px}.panel{background:white;border-right:1px solid #e5e7eb;overflow:auto}.right{border-left:1px solid #e5e7eb;border-right:0}.panel h3{margin:0;padding:14px;border-bottom:1px solid #e5e7eb}.lib{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px}.lib div{border:1px dashed #94a3b8;border-radius:8px;padding:10px;text-align:center;cursor:grab;background:#f8fafc}.canvas{padding:18px;overflow:auto}.page{background:white;min-height:70vh;border-radius:12px;padding:16px;box-shadow:0 4px 18px #0001}.block{border:2px solid transparent;background:#f8fafc;border-radius:10px;margin-bottom:10px}.sel{border-color:#2563eb}.head{display:flex;justify-content:space-between;align-items:center;background:#e5e7eb;padding:8px 10px;cursor:move}.body{padding:12px}.field{padding:12px;border-bottom:1px solid #e5e7eb}textarea,input{width:100%;box-sizing:border-box;border:1px solid #d1d5db;border-radius:6px;padding:8px}button{border:0;border-radius:6px;background:#2563eb;color:white;padding:8px 12px;cursor:pointer}button.gray{background:#6b7280}button.red{background:#dc2626}button.green{background:#16a34a}</style></head><body><div class="top"><div><a href="/WebsiteBuilder/Pages">← 页面管理</a> <b id="title">页面装修</b></div><div><button onclick="save()">保存草稿</button> <button class="gray" onclick="preview()">预览</button> <button class="green" onclick="publish()">发布</button></div></div><div class="main"><div class="panel"><h3>组件库</h3><div id="lib" class="lib"></div></div><div class="canvas"><div id="path"></div><div id="canvas" class="page" ondragover="event.preventDefault()" ondrop="dropNew(event)"></div></div><div class="panel right"><h3>属性面板</h3><div id="props"><div class="field">请选择组件</div></div></div></div><script>const pageId=Number('@pageId');const defs=[['navigation','顶部导航',{siteName:'企业官网'}],['banner','Banner',{height:420,title:'Banner标题',subtitle:'副标题',buttonText:'了解更多',buttonLink:'/about'}],['richText','富文本',{title:'标题',content:'内容'}],['news','新闻列表',{title:'新闻中心',count:6,showMore:true,moreLink:'/news'}],['product','产品列表',{title:'产品中心',count:6,columns:3,showMore:true,moreLink:'/products'}],['job','招聘列表',{title:'招聘信息',count:4,showApply:true}],['footer','页脚',{companyName:'企业官网',copyright:'Copyright © 企业官网'}]];let page={},items=[],sel='',dragIndex=-1;async function api(u,o){let r=await fetch(u,Object.assign({headers:{'Content-Type':'application/json'}},o||{}));if(!r.ok){let m='请求失败';try{m=(await r.json()).message||m}catch(e){}throw Error(m)}return await r.json()}function init(){lib.innerHTML=defs.map((d,i)=>`<div draggable="true" ondragstart="event.dataTransfer.setData('new',${i})">${d[1]}</div>`).join('')}async function load(){page=await api('/api/pages/'+pageId);title.innerText='页面装修：'+page.pageName;path.innerText='路径：'+page.pagePath;try{items=JSON.parse(page.componentJson||'[]')}catch(e){items=[]}render()}function add(i){let d=defs[i];items.push({id:d[0]+'_'+Date.now(),type:d[0],name:d[1],sort:items.length+1,visible:true,locked:false,props:JSON.parse(JSON.stringify(d[2])),style:{backgroundColor:'#ffffff',paddingTop:40,paddingBottom:40}});sel=items[items.length-1].id;render()}function dropNew(e){e.preventDefault();let i=e.dataTransfer.getData('new');if(i!=='')add(Number(i))}function moveDrop(e,i){e.preventDefault();let s=Number(e.dataTransfer.getData('move'));if(Number.isNaN(s)||s===i)return;let x=items.splice(s,1)[0];items.splice(i,0,x);render()}function render(){items.forEach((x,i)=>x.sort=i+1);canvas.innerHTML=items.length?items.map((x,i)=>`<section class="block ${x.id===sel?'sel':''}" onclick="sel='${x.id}';render()" draggable="true" ondragstart="event.dataTransfer.setData('move',${i})" ondragover="event.preventDefault()" ondrop="moveDrop(event,${i})"><div class="head"><b>${i+1}. ${x.name} (${x.type})</b><span><button class="gray" onclick="event.stopPropagation();up(${i})">上移</button> <button class="gray" onclick="event.stopPropagation();down(${i})">下移</button> <button class="red" onclick="event.stopPropagation();del(${i})">删除</button></span></div><div class="body">${preview(x)}</div></section>`).join(''):'从左侧拖入组件开始装修';renderProps()}function preview(x){let p=x.props||{};if(x.type==='banner')return `<h2>${p.title||''}</h2><p>${p.subtitle||''}</p>`;if(x.type==='navigation')return '导航：'+(p.siteName||'企业官网');if(x.type==='richText')return `<h3>${p.title||''}</h3><p>${p.content||''}</p>`;if(x.type==='footer')return '页脚：'+(p.companyName||'');return (p.title||x.name)+' 数据组件'}function renderProps(){let x=items.find(a=>a.id===sel);props.innerHTML=x?`<div class="field"><label>组件名称</label><input id="name" value="${esc(x.name)}" oninput="xname(this.value)"></div><div class="field"><label>属性JSON</label><textarea id="pj" rows="12" onblur="xjson('props',this.value)">${esc(JSON.stringify(x.props||{},null,2))}</textarea></div><div class="field"><label>样式JSON</label><textarea id="sj" rows="8" onblur="xjson('style',this.value)">${esc(JSON.stringify(x.style||{},null,2))}</textarea></div>`:'<div class="field">请选择组件</div>'}function xname(v){let x=items.find(a=>a.id===sel);x.name=v;render()}function xjson(k,v){try{items.find(a=>a.id===sel)[k]=JSON.parse(v||'{}');render()}catch(e){alert('JSON格式错误')}}function up(i){if(i>0){[items[i-1],items[i]]=[items[i],items[i-1]];render()}}function down(i){if(i<items.length-1){[items[i+1],items[i]]=[items[i],items[i+1]];render()}}function del(i){items.splice(i,1);sel='';render()}function pageJson(){return{pageId:page.id,pageName:page.pageName,pagePath:page.pagePath,layout:{width:'full',theme:'default'},components:items}}async function save(){await api('/api/pages/'+pageId+'/design',{method:'PUT',body:JSON.stringify({layoutJson:JSON.stringify({width:'full',theme:'default'}),componentJson:JSON.stringify(items),draftJson:JSON.stringify(pageJson())})});alert('已保存草稿')}async function publish(){await save();await api('/api/pages/'+pageId+'/publish',{method:'POST'});alert('发布成功')}function preview(){window.open('/website/preview/'+pageId)}function esc(s){return String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}init();load().catch(e=>alert(e.message));</script></body></html>