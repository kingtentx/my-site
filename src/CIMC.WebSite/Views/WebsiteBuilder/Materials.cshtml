@{ Layout = null; }
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>素材管理</title><style>body{margin:0;font-family:Arial,'Microsoft YaHei';background:#f5f7fb}.top{height:56px;background:#111827;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 22px}.top a{color:#dbeafe;margin-left:12px;text-decoration:none}.wrap{padding:22px}.card{background:white;border-radius:10px;padding:18px;box-shadow:0 4px 18px #0001}button{border:0;border-radius:6px;background:#2563eb;color:white;padding:8px 12px;cursor:pointer}button.red{background:#dc2626}input{border:1px solid #d1d5db;border-radius:6px;padding:8px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-top:18px}.item{border:1px solid #e5e7eb;border-radius:10px;padding:10px;background:#fff}.thumb{height:110px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:8px}.thumb img{max-width:100%;max-height:100%}.name{font-size:13px;word-break:break-all;margin:8px 0}</style></head><body><div class="top"><b>素材管理</b><div><a href="/WebsiteBuilder/Navigation">导航</a><a href="/WebsiteBuilder/Banners">Banner</a><a href="/WebsiteBuilder/Footer">页脚</a><a href="/website" target="_blank">前台</a></div></div><div class="wrap"><div class="card"><input id="file" type="file"><input id="category" placeholder="分类，如 image/banner/file"><button onclick="upload()">上传</button><div id="rows" class="grid"></div></div></div><script>async function api(u,o){let r=await fetch(u,o||{});if(!r.ok){let m='请求失败';try{m=(await r.json()).message||m}catch(e){}throw Error(m)}return await r.json()}async function load(){let d=await api('/api/materials');rows.innerHTML=d.map(x=>`<div class="item"><div class="thumb">${['jpg','jpeg','png','webp','gif','svg'].includes((x.fileType||'').toLowerCase())?`<img src="${x.fileUrl}">`:x.fileType}</div><div class="name">${x.fileName}</div><input value="${x.fileUrl}" onclick="this.select()" readonly style="width:100%;box-sizing:border-box"><p><button class="red" onclick="del(${x.id})">删除</button></p></div>`).join('')}async function upload(){if(!file.files.length){alert('请选择文件');return}let fd=new FormData();fd.append('file',file.files[0]);fd.append('category',category.value||'');await api('/api/materials/upload',{method:'POST',body:fd});file.value='';load()}async function del(id){if(confirm('确定删除？')){await api('/api/materials/'+id,{method:'DELETE'});load()}}load().catch(e=>alert(e.message));</script></body></html>