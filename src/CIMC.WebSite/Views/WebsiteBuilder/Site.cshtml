@{ Layout = null; }
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><title>站点设置</title><style>body{margin:0;font-family:Arial,'Microsoft YaHei';background:#f5f7fb}.top{height:56px;background:#111827;color:white;display:flex;align-items:center;justify-content:space-between;padding:0 22px}.top a{color:#dbeafe;margin-left:14px;text-decoration:none}.wrap{padding:22px}.card{background:white;border-radius:10px;padding:18px;max-width:900px;box-shadow:0 4px 18px #0001}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.full{grid-column:1/-1}input,textarea,select{width:100%;box-sizing:border-box;border:1px solid #d1d5db;border-radius:6px;padding:8px}button{border:0;border-radius:6px;background:#2563eb;color:white;padding:9px 14px}</style></head><body><div class="top"><b>站点设置</b><div><a href="/WebsiteBuilder/Pages">页面管理</a><a href="/WebsiteBuilder/Contents">内容管理</a><a target="_blank" href="/website">前台</a></div></div><div class="wrap"><div class="card"><div class="grid"><input id="siteName" placeholder="站点名称"><input id="logo" placeholder="Logo URL"><input id="browserTitle" placeholder="浏览器标题"><input id="theme" placeholder="主题 default"><input class="full" id="keywords" placeholder="关键词"><textarea class="full" id="description" rows="3" placeholder="网站描述"></textarea><input id="icpNo" placeholder="备案号"><input id="tel" placeholder="电话"><input id="email" placeholder="邮箱"><input id="language" placeholder="zh-CN"><input class="full" id="address" placeholder="地址"><input class="full" id="copyright" placeholder="版权信息"><select id="isEnabled"><option value="true">启用</option><option value="false">停用</option></select></div><p><button onclick="save()">保存设置</button></p></div></div><script>let id=0;async function api(u,o){let r=await fetch(u,Object.assign({headers:{'Content-Type':'application/json'}},o||{}));if(!r.ok)throw Error('请求失败');return await r.json()}async function load(){let c=await api('/api/site/config');id=c.id||0;for(let k of ['siteName','logo','browserTitle','keywords','description','icpNo','tel','email','address','copyright','theme','language'])document.getElementById(k).value=c[k]||'';isEnabled.value=c.isEnabled===false?'false':'true'}async function save(){let c={id};for(let k of ['siteName','logo','browserTitle','keywords','description','icpNo','tel','email','address','copyright','theme','language'])c[k]=document.getElementById(k).value;c.isEnabled=isEnabled.value==='true';await api('/api/site/config',{method:'PUT',body:JSON.stringify(c)});alert('保存成功')}load().catch(e=>alert(e.message));</script></body></html>