@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>招聘管理</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-form layui-card-header layuiadmin-card-header-auto">
            <div class="layui-form-item">
                <div class="layui-inline">
                    <label class="layui-form-label">岗位/部门</label>
                    <div class="layui-input-inline"><input type="text" name="keywords" placeholder="请输入" autocomplete="off" class="layui-input"></div>
                </div>
                <div class="layui-inline">
                    <label class="layui-form-label">招聘分类</label>
                    <div class="layui-input-inline" style="width:200px;"><select name="categoryId" id="selCategory"><option value="0">全部招聘</option></select></div>
                </div>
                <div class="layui-inline"><button class="layui-btn" lay-submit lay-filter="app-search"><i class="layui-icon layui-icon-search"></i> 查询</button></div>
            </div>
        </div>
        <div class="layui-card-body">
            <div style="padding-bottom:10px;">
                @if ((bool)ViewData[PageCode.PAGE_Button_Add]) { <a class="layui-btn" href="/job/edit">添加岗位</a> }
                @if ((bool)ViewData[PageCode.PAGE_Button_Delete]) { <button class="layui-btn layui-btn-danger" id="batchdel">批量删除</button> }
            </div>
            <table class="layui-hide" id="app-table" lay-filter="app-table"></table>
            <script type="text/html" id="activeTpl">{{# if(d.isActive){ }}<span class="layui-badge layui-bg-green">已发布</span>{{# } else { }}<span class="layui-badge layui-bg-gray">未发布</span>{{# } }}</script>
            <script type="text/html" id="barTpl">
                @if ((bool)ViewData[PageCode.PAGE_Button_Edit]) { <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="edit">编辑</a> }
                @if ((bool)ViewData[PageCode.PAGE_Button_Delete]) { <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a> }
            </script>
        </div>
    </div>
</div>
<script src="~/resource/layuiadmin/layui/layui.js"></script>
<script>
layui.config({base:'@Url.Content("~")/resource/layuiadmin/'}).extend({index:'lib/index'}).use(['index','table','form'],function(){
    var $=layui.$,form=layui.form,table=layui.table,layer=layui.layer;
    $.get('/ContentCategory/GetOptions',{contentType:'job'},function(res){
        if(res.code!==200||!res.data)return;var html='<option value="0">'+(res.data.allText||'全部招聘')+'</option>';
        (res.data.options||[]).forEach(function(item){html+='<option value="'+item.value+'">'+item.text+'</option>';});
        $('#selCategory').html(html);form.render('select');
    },'json');

    table.render({
        elem:'#app-table',url:'/Job/GetList',response:{statusName:'code',statusCode:200,msgName:'message',countName:'count',dataName:'data'},
        cols:[[
            {type:'checkbox'},{field:'id',width:60,title:'ID'},{field:'jobTitle',minWidth:170,title:'岗位名称'},
            {field:'categoryName',width:130,title:'招聘分类'},{field:'department',width:130,title:'部门'},
            {field:'workLocation',width:110,title:'地点'},{field:'salaryRange',width:120,title:'薪资'},
            {field:'recruitCount',width:75,title:'人数'},{field:'jobType',width:80,title:'类型'},
            {field:'sort',width:70,title:'排序'},{field:'isActive',width:90,align:'center',title:'状态',templet:'#activeTpl'},
            {field:'publishTime',width:165,title:'发布时间'},{width:150,align:'center',title:'操作',toolbar:'#barTpl'}
        ]],
        request:{pageName:'pageIndex',limitName:'pageSize'},page:true,limit:10,limits:[10,20,50]
    });

    table.on('tool(app-table)',function(obj){var data=obj.data;
        if(obj.event==='edit')location.href='/job/edit/'+data.id;
        else if(obj.event==='del')layer.confirm('确认删除？',function(index){$.post('/Job/Delete',{id:data.id},function(res){layer.close(index);if(res.code===200){layer.msg(res.message);obj.del();}else layer.msg(res.message,{icon:5});},'json');
    });

    $('#batchdel').on('click',function(){var rows=table.checkStatus('app-table').data;if(!rows.length){layer.msg('请至少选择一项');return;}layer.confirm('确认删除选中的 '+rows.length+' 条数据？',function(index){$.ajax({type:'post',url:'/job/delete?isAll=1',data:{ids:rows.map(function(x){return x.id;})},traditional:true,dataType:'json',success:function(res){layer.close(index);if(res.code===200){layer.msg(res.message);table.reload('app-table');}else layer.msg(res.message,{icon:5});}});});});
    form.on('submit(app-search)',function(data){table.reload('app-table',{page:{curr:1},where:data.field});return false;});
});
</script>
</body>
</html>
