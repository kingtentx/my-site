@using CIMC.Data
@{
    Layout = null;
    var categories = ViewBag.Categories as List<ContentProductCategory> ?? new List<ContentProductCategory>();
}
@model MySite.Web.Models.JobModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>招聘编辑</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-header">@(Model.Id > 0 ? "修改岗位" : "添加岗位")</div>
        <div class="layui-card-body" style="padding:15px;">
            <form class="layui-form">
                <div class="layui-form-item">
                    <label class="layui-form-label">岗位名称</label>
                    <div class="layui-input-inline" style="width:300px;"><input type="text" name="JobTitle" lay-verify="required" class="layui-input" value="@Html.Raw(Model.JobTitle)"></div>
                    <label class="layui-form-label">招聘分类</label>
                    <div class="layui-input-inline" style="width:240px;">
                        <select name="CategoryId">
                            <option value="0">未分类</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id" selected="@(category.Id == Model.CategoryId ? "selected" : null)">@category.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">所属部门</label>
                    <div class="layui-input-inline" style="width:240px;"><input type="text" name="Department" class="layui-input" value="@Html.Raw(Model.Department)"></div>
                    <label class="layui-form-label">工作地点</label>
                    <div class="layui-input-inline" style="width:220px;"><input type="text" name="WorkLocation" class="layui-input" value="@Html.Raw(Model.WorkLocation)"></div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">薪资范围</label>
                    <div class="layui-input-inline" style="width:240px;"><input type="text" name="SalaryRange" placeholder="如 10k-20k" class="layui-input" value="@Html.Raw(Model.SalaryRange)"></div>
                    <label class="layui-form-label">招聘人数</label>
                    <div class="layui-input-inline" style="width:100px;"><input type="number" name="RecruitCount" class="layui-input" value="@Model.RecruitCount"></div>
                    <label class="layui-form-label">工作类型</label>
                    <div class="layui-input-inline" style="width:140px;">
                        <select name="JobType">
                            <option value="全职" selected="@(Model.JobType == "全职" ? "selected" : null)">全职</option>
                            <option value="兼职" selected="@(Model.JobType == "兼职" ? "selected" : null)">兼职</option>
                            <option value="实习" selected="@(Model.JobType == "实习" ? "selected" : null)">实习</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item layui-form-text">
                    <label class="layui-form-label">岗位职责</label>
                    <div class="layui-input-block"><div id="txtResponsibilities">@Html.Raw(Model.Responsibilities)</div></div>
                </div>
                <div class="layui-form-item layui-form-text">
                    <label class="layui-form-label">任职要求</label>
                    <div class="layui-input-block"><div id="txtRequirements">@Html.Raw(Model.Requirements)</div></div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">联系人</label>
                    <div class="layui-input-inline" style="width:180px;"><input type="text" name="ContactName" class="layui-input" value="@Html.Raw(Model.ContactName)"></div>
                    <label class="layui-form-label">联系电话</label>
                    <div class="layui-input-inline" style="width:200px;"><input type="text" name="ContactPhone" class="layui-input" value="@Html.Raw(Model.ContactPhone)"></div>
                    <label class="layui-form-label">联系邮箱</label>
                    <div class="layui-input-inline" style="width:240px;"><input type="text" name="ContactEmail" class="layui-input" value="@Html.Raw(Model.ContactEmail)"></div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">排序</label>
                    <div class="layui-input-inline" style="width:100px;"><input type="number" name="Sort" class="layui-input" value="@Model.Sort"></div>
                    <label class="layui-form-label">是否发布</label>
                    <div class="layui-input-inline" style="width:220px;">
                        <input type="radio" name="IsActive" value="true" title="发布" @Html.Raw(Model.IsActive ? " checked" : "")>
                        <input type="radio" name="IsActive" value="false" title="下架" @Html.Raw(!Model.IsActive ? " checked" : "")>
                    </div>
                </div>
                <div class="layui-form-item"><div class="layui-input-block"><button class="layui-btn" lay-submit lay-filter="save">保存</button><a href="/job/index" class="layui-btn layui-btn-primary">返回列表</a></div></div>
            </form>
        </div>
    </div>
</div>
<script src="~/resource/layuiadmin/layui/layui.js"></script>
<script src="~/resource/js/jquery-1.12.4.min.js"></script>
<script src="~/resource/wangeditor-4.7.9/wangEditor.min.js"></script>
<script>
layui.config({base:'@Url.Content("~")/resource/layuiadmin/'}).extend({index:'lib/index'}).use(['index','form'],function(){
    var $=layui.$,form=layui.form,layer=layui.layer,E=window.wangEditor;
    function createEditor(selector){var e=new E(selector);e.config.uploadFileName='file';e.config.uploadImgServer='/Upload/UploadImage';e.config.uploadImgHooks={customInsert:function(insertImg,result){if(result&&result.url)insertImg(result.url);}};e.create();return e;}
    var responsibilities=createEditor('#txtResponsibilities'), requirements=createEditor('#txtRequirements');
    form.on('submit(save)',function(data){
        data.field.Responsibilities=responsibilities.txt.html();data.field.Requirements=requirements.txt.html();
        $.post('/job/edit?id=@Model.Id',data.field,function(res){if(res.code===200)layer.alert(res.message,function(){location.href='/job/index';});else layer.msg(res.message,{icon:5});},'json');
        return false;
    });
});
</script>
</body>
</html>
