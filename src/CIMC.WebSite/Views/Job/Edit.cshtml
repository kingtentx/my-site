@model MySite.Web.Models.JobModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>岗位编辑</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/static/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/static/layuiadmin/style/admin.css" media="all">
    <link rel="stylesheet" href="~/static/layuiadmin/css/site.css" media="all">
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-header">@(Model.Id > 0 ? "修改岗位" : "添加岗位")</div>
        <div class="layui-card-body" style="padding:15px;">
            <form class="layui-form" lay-filter="form-group">
                <div class="layui-form-item"><label class="layui-form-label">岗位名称</label><div class="layui-input-block"><input class="layui-input w300" name="JobName" lay-verify="required" autocomplete="off" placeholder="请输入岗位名称" value="@Html.Raw(Model.JobName)"></div></div>
                <div class="layui-form-item"><label class="layui-form-label">岗位名称(EN)</label><div class="layui-input-block"><input class="layui-input w300" name="JobName_EN" autocomplete="off" placeholder="Please enter job name" value="@Html.Raw(Model.JobName_EN)"></div></div>
                <div class="layui-form-item">
                    <label class="layui-form-label">招聘分类</label>
                    <div class="layui-input-block up_index w300">
                        <select name="TagId" lay-verify="required"><option value="">请选择</option>@foreach (var tag in Model.TagsList) { <option value="@tag.Id" selected="@(tag.Id == Model.TagId ? "selected" : null)">@tag.TagName</option> }</select>
                    </div>
                </div>
                <div class="layui-form-item"><label class="layui-form-label">发布日期</label><div class="layui-input-block"><input class="layui-input w300" id="updateTime" name="UpdateTime" lay-verify="datetime" autocomplete="off" placeholder="请输入发布日期" value="@Model.UpdateTime?.ToString("yyyy-MM-dd HH:mm:ss")"></div></div>
                <div class="layui-form-item"><label class="layui-form-label">发布人</label><div class="layui-input-block"><input class="layui-input w300" name="Author" autocomplete="off" placeholder="请输入发布人" value="@Model.Author"></div></div>
                <div class="layui-form-item"><label class="layui-form-label">是否发布</label><div class="layui-input-block"><input type="radio" name="IsActive" value="true" title="是" checked="@(Model.IsActive ? "checked" : null)"><input type="radio" name="IsActive" value="false" title="否" checked="@(!Model.IsActive ? "checked" : null)"></div></div>
                <div class="layui-form-item layui-form-text"><label class="layui-form-label">岗位内容</label><div class="layui-input-block"><div id="detail">@Html.Raw(Model.Detail)</div></div></div>
                <div class="layui-form-item layui-form-text"><label class="layui-form-label">岗位内容(EN)</label><div class="layui-input-block"><div id="detailEn">@Html.Raw(Model.Detail_EN)</div></div></div>
                <div class="layui-form-item layui-layout-admin"><div class="layui-input-block"><div class="layui-footer" style="left:0;z-index:20000"><button class="layui-btn" lay-submit lay-filter="save">立即保存</button><a class="layui-btn layui-btn-primary" href="/Job/Index">返回列表</a></div></div></div>
            </form>
        </div>
    </div>
</div>
<script src="~/static/layuiadmin/layui/layui.js"></script>
<script src="~/static/plugin/wangeditor-4.7.9/wangEditor.min.js"></script>
<script>
layui.config({base:'@Url.Content("~/static/layuiadmin/")'}).extend({index:'lib/index'}).use(['index','form','laydate'],function(){
    var $=layui.$,form=layui.form,layer=layui.layer,E=window.wangEditor;
    layui.laydate.render({elem:'#updateTime',type:'datetime'});
    form.verify({datetime:function(value){if(value&&!/^\d{4}-\d{2}-\d{2}/.test(value))return '请输入正确的发布日期';}});
    function createEditor(id){var editor=new E(id);editor.config.uploadFileName='file';editor.config.uploadImgServer='/Upload/UploadImage';editor.config.uploadImgHooks={customInsert:function(insert,res){if(res&&res.url)insert(res.url);}};editor.create();return editor;}
    var detail=createEditor('#detail'),detailEn=createEditor('#detailEn');
    form.on('submit(save)',function(data){data.field.Detail=detail.txt.html();data.field.Detail_EN=detailEn.txt.html();$.post('/Job/Edit?id=@Model.Id',data.field,function(res){if(res.code===200)layer.alert(res.message,function(){location.href='/Job/Index';});else layer.msg(res.message,{icon:5});},'json');return false;});
});
</script>
</body>
</html>
