@{
    Layout = null;
}
@model MySite.Web.Models.JobModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>招聘编辑</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">@(Model.Id > 0 ? "修改岗位" : "添加岗位")</div>
            <div class="layui-card-body" style="padding: 15px;">
                <form class="layui-form" lay-filter="form-group">
                    <div class="layui-form-item">
                        <label class="layui-form-label">岗位名称</label>
                        <div class="layui-input-inline" style="width:300px;">
                            <input type="text" name="JobTitle" lay-verify="required" autocomplete="off" placeholder="岗位名称" class="layui-input" value="@Html.Raw(Model.JobTitle)">
                        </div>
                        <label class="layui-form-label">所属部门</label>
                        <div class="layui-input-inline" style="width:200px;">
                            <input type="text" name="Department" autocomplete="off" class="layui-input" value="@Html.Raw(Model.Department)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">工作地点</label>
                        <div class="layui-input-inline" style="width:240px;">
                            <input type="text" name="WorkLocation" autocomplete="off" class="layui-input" value="@Html.Raw(Model.WorkLocation)">
                        </div>
                        <label class="layui-form-label">薪资范围</label>
                        <div class="layui-input-inline" style="width:200px;">
                            <input type="text" name="SalaryRange" autocomplete="off" placeholder="如 10k-20k" class="layui-input" value="@Html.Raw(Model.SalaryRange)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">招聘人数</label>
                        <div class="layui-input-inline" style="width:120px;">
                            <input type="number" name="RecruitCount" autocomplete="off" class="layui-input" value="@Model.RecruitCount">
                        </div>
                        <label class="layui-form-label">工作类型</label>
                        <div class="layui-input-inline" style="width:200px;">
                            <select name="JobType">
                                <option value="全职" @Html.Raw(Model.JobType == "全职" ? "selected" : "")>全职</option>
                                <option value="兼职" @Html.Raw(Model.JobType == "兼职" ? "selected" : "")>兼职</option>
                                <option value="实习" @Html.Raw(Model.JobType == "实习" ? "selected" : "")>实习</option>
                            </select>
                        </div>
                    </div>
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">岗位职责</label>
                        <div class="layui-input-block">
                            <div id="txtResponsibilities">@Html.Raw(Model.Responsibilities)</div>
                        </div>
                    </div>
                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">任职要求</label>
                        <div class="layui-input-block">
                            <div id="txtRequirements">@Html.Raw(Model.Requirements)</div>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">联系人</label>
                        <div class="layui-input-inline" style="width:200px;">
                            <input type="text" name="ContactName" autocomplete="off" class="layui-input" value="@Html.Raw(Model.ContactName)">
                        </div>
                        <label class="layui-form-label">联系电话</label>
                        <div class="layui-input-inline" style="width:200px;">
                            <input type="text" name="ContactPhone" autocomplete="off" class="layui-input" value="@Html.Raw(Model.ContactPhone)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">联系邮箱</label>
                        <div class="layui-input-inline" style="width:300px;">
                            <input type="text" name="ContactEmail" autocomplete="off" class="layui-input" value="@Html.Raw(Model.ContactEmail)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">排序</label>
                        <div class="layui-input-inline" style="width:120px;">
                            <input type="number" name="Sort" autocomplete="off" class="layui-input" value="@Model.Sort">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">是否发布</label>
                        <div class="layui-input-block">
                            <input type="radio" name="IsActive" value="true" title="发布" @Html.Raw(Model.IsActive ? " checked" : "")>
                            <input type="radio" name="IsActive" value="false" title="下架" @Html.Raw(!Model.IsActive ? " checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item layui-layout-admin">
                        <div class="layui-input-block">
                            <div class="layui-footer" style="left: 0; z-index: 20000">
                                <button class="layui-btn" lay-submit="" lay-filter="form-page">立即保存</button>
                                <a href="@Url.Content("~")/job/index" class="layui-btn layui-btn-primary">返回列表</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script src="~/resource/js/jquery-1.12.4.min.js"></script>
    <script src="~/resource/wangeditor-4.7.9/wangEditor.min.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['index', 'form'], function () {
            var $ = layui.$, form = layui.form, layer = layui.layer;

            var E = window.wangEditor;
            var editorResp = new E('#txtResponsibilities');
            editorResp.config.uploadFileName = 'file';
            editorResp.config.uploadImgServer = '/Upload/UploadImage';
            editorResp.config.uploadImgHooks = { customInsert: function (insertImg, result) { if (result.url) insertImg(result.url); } };
            editorResp.create();

            var editorReq = new E('#txtRequirements');
            editorReq.config.uploadFileName = 'file';
            editorReq.config.uploadImgServer = '/Upload/UploadImage';
            editorReq.config.uploadImgHooks = { customInsert: function (insertImg, result) { if (result.url) insertImg(result.url); } };
            editorReq.create();

            form.on('submit(form-page)', function (data) {
                data.field.Responsibilities = editorResp.txt.html();
                data.field.Requirements = editorReq.txt.html();
                $.ajax({
                    type: "post",
                    url: '/job/edit?id=@Model.Id',
                    data: data.field,
                    dataType: "json",
                    success: function (res) {
                        if (res.code == 200) {
                            layer.alert(res.message, function (index) {
                                window.location.href = '/job/index';
                                layer.close(index);
                            });
                        } else { layer.msg(res.message, { icon: 5 }); }
                    },
                    error: function () { layer.msg('保存失败', { icon: 5 }); }
                });
                return false;
            });
        });
    </script>
</body>
</html>
