@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>导航管理</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-form layui-card-header layuiadmin-card-header-auto">
                <div class="layui-inline">
                    <label class="layui-form-label">关键词</label>
                    <div class="layui-input-block">
                        <input type="text" name="keywords" placeholder="导航名称/路径" autocomplete="off" class="layui-input">
                    </div>
                </div>
                <div class="layui-inline">
                    <button class="layui-btn layuiadmin-btn-admin" lay-submit lay-filter="app-search">
                        <i class="layui-icon layui-icon-search layuiadmin-button-btn"></i>
                    </button>
                </div>
            </div>
            <div class="layui-card-body">
                <div style="padding-bottom: 10px;">
                    @if ((bool)ViewData[PageCode.PAGE_Button_Add])
                    {
                        <a class="layui-btn layuiadmin-btn-admin" href="/Navigation/Edit">添加导航</a>
                    }
                </div>
                <table id="tree-table" class="layui-table" lay-filter="tree-table"></table>
                <script type="text/html" id="status">
                    {{# if(d.isActive === true){ }}
                    <span class="layui-btn layui-btn-primary layui-btn-xs">启用</span>
                    {{# } else { }}
                    <span class="layui-btn layui-btn-warm layui-btn-xs">停用</span>
                    {{# } }}
                </script>
                <script type="text/html" id="tree-table-bar">
                       {{#if (d.pid === 0){ }}
                    @if ((bool)ViewData[PageCode.PAGE_Button_Add])
                    {
                            <button class="layui-btn layui-btn-normal layui-btn-xs" lay-event="addchild"><i class="layui-icon layui-icon-addition"></i>添加子导航</button>
                    }
                    <a class="layui-btn layui-btn-warm layui-btn-xs" href="/SiteModule/Index?navigationId={{=d.id}}"><i class="layui-icon layui-icon-app"></i>模块配置</a>
                    {{# } }}
                    @if ((bool)ViewData[PageCode.PAGE_Button_Edit])
                    {
                           <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="edit" href="/Navigation/Edit/{{=d.id}}"><i class="layui-icon layui-icon-edit"></i>编辑</a>
                    }
                    @if ((bool)ViewData[PageCode.PAGE_Button_Delete])
                    {
                          <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del"><i class="layui-icon layui-icon-delete"></i>删除</a>
                    }

                </script>
            </div>
        </div>
    </div>
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['index', 'table', 'treetable'], function () {
            var $ = layui.$, layer = layui.layer, table = layui.table, treetable = layui.treetable;

            var renderTable = function (data) {
                layer.load(2);
                treetable.render({
                    treeColIndex: 0,
                    treeSpid: 0,
                    treeIdName: 'id',
                    treePidName: 'pid',
                    treeDefaultClose: false,
                    treeLinkage: false,
                    elem: '#tree-table',
                    data: data,
                    page: false,
                    cols: [[
                        { field: 'navigationName', title: '导航名称' },
                        { field: 'rewriteName', width: 170, title: 'URL路径' },
                        { field: 'moduleCount', width: 90, title: '模块数量' },
                        { field: 'sort', width: 80, title: '排序' },
                        { field: 'isShow', width: 80, title: '显示', templet: '#status' },
                        { field: 'isActive', width: 80, title: '启用', templet: '#status' },
                        { align: 'center', width: 350, title: '操作', toolbar: '#tree-table-bar' }
                    ]],
                    done: function () {
                        layer.closeAll('loading');
                    }
                });
            };

            function loadData(keywords) {
                $.ajax({
                    type: 'get',
                    url: '/Navigation/GetList',
                    data: { keywords: keywords || '' },
                    dataType: 'json',
                    success: function (res) {
                        if (res.code == 200) {
                            renderTable(res.data);
                        }
                    }
                });
            }

            loadData();

            layui.form.on('submit(app-search)', function(data) {
                loadData(data.field.keywords);
                return false;
            });

            table.on("tool(tree-table)", function (obj) {
                var data = obj.data;
                if (obj.event === "del") {
                    layer.confirm("确认删除? 子导航也会受影响", function (index) {
                        var loading = layer.load(1, { shade: 0.3 });
                        $.ajax({
                            url: "/Navigation/Delete",
                            data: { 'id': data.id },
                            type: "post",
                            dataType: "json",
                            success: function (res) {
                                layer.close(loading);
                                if (res.code == 200) {
                                    layer.msg(res.message);
                                    layer.close(index);
                                    location.reload();
                                }
                                else {
                                    layer.msg(res.message);
                                }
                            },
                            error: function () {
                                layer.close(loading);
                            }
                        });
                    });
                }
                else if (obj.event === 'addchild') {
                    window.location.href = '/Navigation/Edit?pid=' + data.id;
                }
            });
        });
    </script>
</body>
</html>
