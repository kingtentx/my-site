@{
    Layout = null;
}
@model Navigation
@{
    var parentList = ViewData["ParentList"] as List<Navigation>;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>导航编辑</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">@(Model.Id > 0 ? "修改导航" : "添加导航")</div>
            <div class="layui-card-body" style="padding: 15px;">
                <form class="layui-form">
                    <div class="layui-form-item">
                        <label class="layui-form-label">父导航</label>
                        <div class="layui-input-inline">
                            <select name="Pid">
                                <option value="0">顶级导航</option>
                                @if (parentList != null)
                                {
                                    foreach (var p in parentList)
                                    {
                                        <option value="@p.Id" @(Model.Pid == p.Id ? "selected" : "")>@p.NavigationName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">导航名称</label>
                        <div class="layui-input-block">
                            <input type="text" name="NavigationName" lay-verify="required" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.NavigationName)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">导航名称(EN)</label>
                        <div class="layui-input-block">
                            <input type="text" name="NavigationName_EN" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.NavigationName_EN)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">URL路径</label>
                        <div class="layui-input-block">
                            <input type="text" name="RewriteName" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.RewriteName)">
                        </div>
                        <div class="layui-form-mid layui-word-aux">如 about、products、news</div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">描述</label>
                        <div class="layui-input-block">
                            <input type="text" name="Description" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.Description)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">启用外链</label>
                        <div class="layui-input-block">
                            <input type="checkbox" name="IsEnableLink" lay-skin="switch" lay-text="是|否" value="true" @(Model.IsEnableLink ? "checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">跳转链接</label>
                        <div class="layui-input-block">
                            <input type="text" name="LinkUrl" autocomplete="off" class="layui-input w500" value="@Html.Raw(Model.LinkUrl)">
                        </div>
                        <div class="layui-form-mid layui-word-aux">外链模式时填写完整URL</div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">排序</label>
                        <div class="layui-input-inline">
                            <input type="number" name="Sort" autocomplete="off" class="layui-input" value="@Model.Sort">
                        </div>
                        <label class="layui-form-label">是否首页</label>
                        <div class="layui-input-block">
                            <input type="checkbox" name="IsHomePage" lay-skin="switch" lay-text="是|否" value="true" @(Model.IsHomePage ? "checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">是否显示</label>
                        <div class="layui-input-block">
                            <input type="checkbox" name="IsShow" lay-skin="switch" lay-text="是|否" value="true" @(Model.IsShow ? "checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">是否启用</label>
                        <div class="layui-input-block">
                            <input type="checkbox" name="IsActive" lay-skin="switch" lay-text="是|否" value="true" @(Model.IsActive ? "checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item layui-layout-admin">
                        <div class="layui-input-block">
                            <div class="layui-footer" style="left: 0; z-index: 20000">
                                <button class="layui-btn" lay-submit lay-filter="form-page">立即保存</button>
                                <a href="/Navigation/Index" class="layui-btn layui-btn-primary">返回列表</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['form'], function() {
            var $ = layui.$, form = layui.form;
            form.on('submit(form-page)', function(data) {
                $.post('/Navigation/Edit/@Model.Id', data.field, function(res) {
                    if (res.code == 200) {
                        layer.alert(res.message, function() { window.location.href = '/Navigation/Index'; });
                    } else {
                        layer.msg(res.message, { icon: 5 });
                    }
                });
                return false;
            });
        });
    </script>
</body>
</html>
