@{
    Layout = null;
}
@model MySite.Web.Models.NavigationModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>导航编辑</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-card">
            <div class="layui-card-header">@(Model.Id > 0 ? "修改导航" : "添加导航")</div>
            <div class="layui-card-body" style="padding: 15px;">
                <form class="layui-form" lay-filter="form-group">
                    <div class="layui-form-item">
                        <label class="layui-form-label">父级导航</label>
                        <div class="layui-input-block">
                            <select name="Pid" id="selPid">
                                <option value="0">-- 顶级导航 --</option>
                            </select>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">标题</label>
                        <div class="layui-input-block">
                            <input type="text" name="Title" lay-verify="required" autocomplete="off" placeholder="导航标题" class="layui-input" value="@Html.Raw(Model.Title)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">路径</label>
                        <div class="layui-input-block">
                            <input type="text" name="Path" autocomplete="off" placeholder="/about 或 https://..." class="layui-input" value="@Html.Raw(Model.Path)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">图标</label>
                        <div class="layui-input-block">
                            <input type="text" name="Icon" autocomplete="off" placeholder="layui-icon-xxx（可选）" class="layui-input" value="@Html.Raw(Model.Icon)">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">跳转方式</label>
                        <div class="layui-input-block">
                            <input type="radio" name="Target" value="0" title="本窗口" @Html.Raw(Model.Target == 0 ? " checked" : "")>
                            <input type="radio" name="Target" value="1" title="新窗口" @Html.Raw(Model.Target == 1 ? " checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">排序</label>
                        <div class="layui-input-inline" style="width:120px;">
                            <input type="number" name="Sort" autocomplete="off" class="layui-input" value="@Model.Sort">
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">是否显示</label>
                        <div class="layui-input-block">
                            <input type="radio" name="IsShow" value="true" title="显示" @Html.Raw(Model.IsShow ? " checked" : "")>
                            <input type="radio" name="IsShow" value="false" title="隐藏" @Html.Raw(!Model.IsShow ? " checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item">
                        <label class="layui-form-label">是否启用</label>
                        <div class="layui-input-block">
                            <input type="radio" name="IsActive" value="true" title="启用" @Html.Raw(Model.IsActive ? " checked" : "")>
                            <input type="radio" name="IsActive" value="false" title="禁用" @Html.Raw(!Model.IsActive ? " checked" : "")>
                        </div>
                    </div>
                    <div class="layui-form-item layui-layout-admin">
                        <div class="layui-input-block">
                            <div class="layui-footer" style="left: 0; z-index: 20000">
                                <button class="layui-btn" lay-submit="" lay-filter="form-page">立即保存</button>
                                <a href="@Url.Content("~")/navigation/index" class="layui-btn layui-btn-primary">返回列表</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/resource/layuiadmin/layui/layui.js"></script>
    <script>
        layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index: 'lib/index' }).use(['index', 'form'], function () {
            var $ = layui.$, form = layui.form, layer = layui.layer;

            $.ajax({
                type: 'get', url: '@Url.Content("~")/Navigation/GetList', dataType: 'json',
                success: function (res) {
                    if (res.code == 200 && res.data) {
                        var list = res.data;
                        var html = '<option value="0">-- 顶级导航 --</option>';
                        for (var i = 0; i < list.length; i++) {
                            var item = list[i];
                            if (item.id === @Model.Id) continue;
                            if (item.pid !== 0) continue;
                            html += '<option value="' + item.id + '"' + (item.id === @Model.Pid ? ' selected' : '') + '>' + item.title + '</option>';
                        }
                        $('#selPid').html(html);
                        form.render('select');
                    }
                }
            });

            form.on('submit(form-page)', function (data) {
                $.ajax({
                    type: "post",
                    url: '/navigation/edit?id=@Model.Id',
                    data: data.field,
                    dataType: "json",
                    success: function (res) {
                        if (res.code == 200) {
                            layer.alert(res.message, function (index) {
                                window.location.href = '/navigation/index';
                                layer.close(index);
                            });
                        } else { layer.msg(res.message, { icon: 5 }); }
                    },
                    error: function () { layer.msg('保存失败', { icon: 5 }); }
                });
                return false;
            });
        });
    </script>
</body>
</html>
