@using Newtonsoft.Json
@using MySite.Web.Models
@{
    Layout = null;
    var documentJson = ViewBag.DocumentJson as string;
    var document = string.IsNullOrWhiteSpace(documentJson)
        ? new BuilderDocumentModel { Name = ViewBag.PageName as string }
        : JsonConvert.DeserializeObject<BuilderDocumentModel>(documentJson) ?? new BuilderDocumentModel();
    var renderModel = new PageRenderModel
    {
        PageId = ViewBag.PageId,
        PageName = ViewBag.PageName,
        PagePath = ViewBag.PagePath,
        Document = document
    };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>页面预览 - @ViewBag.PageName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/site/css/site.css" />
    <style>
        *{box-sizing:border-box}body{margin:0;font-family:-apple-system,"Microsoft YaHei",sans-serif;background:#eef1f5;color:#1f2937}.preview-toolbar{position:fixed;top:0;left:0;right:0;height:48px;background:#111827;color:#fff;display:flex;align-items:center;padding:0 16px;z-index:9999}.preview-toolbar .title{flex:1}.preview-toolbar button{border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.1);color:#fff;padding:6px 14px;border-radius:4px;cursor:pointer}.preview-canvas{margin:68px auto 20px;max-width:1280px;min-height:calc(100vh - 88px);background:#fff;box-shadow:0 2px 14px rgba(15,23,42,.08)}
        .sb-public-section{width:100%}.sb-public-container{width:100%;max-width:1200px;margin-left:auto;margin-right:auto;padding-left:20px;padding-right:20px}.sb-public-grid{display:grid;align-items:stretch}.sb-public-column{min-width:0}.sb-heading{line-height:1.25}.sb-text{line-height:1.8;white-space:pre-line}.sb-image{display:block;max-width:100%;height:auto}.sb-public-button{display:inline-block;padding:10px 20px;border-radius:5px;text-decoration:none}.sb-public-button-primary{background:#1677ff;color:#fff}.sb-public-button-outline{border:1px solid #1677ff;color:#1677ff}.sb-public-button-text{color:#1677ff}.sb-public-video{display:block;width:100%;background:#000}.sb-public-logo img{max-width:200px;max-height:56px}.sb-public-nav{display:flex;gap:24px}.sb-public-nav.is-vertical{flex-direction:column}.sb-article-grid,.sb-product-grid{display:grid;grid-template-columns:repeat(var(--sb-cols,3),minmax(0,1fr));gap:24px}.sb-content-card{border:1px solid #edf0f3;border-radius:8px;overflow:hidden}.sb-content-card img{width:100%;display:block}.sb-content-card-body{padding:18px}.sb-job-card{border:1px solid #e5e7eb;border-radius:7px;margin:10px 0;padding:4px 14px}.component-pagination{display:flex;justify-content:center;gap:7px;margin:28px 0}.component-pagination a,.component-pagination span{padding:7px 11px;border:1px solid #e5e7eb;border-radius:4px;text-decoration:none}.component-pagination .active{background:#1677ff;color:#fff}
        @@media(max-width:900px){.sb-public-grid{grid-template-columns:1fr!important}.sb-article-grid,.sb-product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@@media(max-width:560px){.sb-article-grid,.sb-product-grid{grid-template-columns:1fr}}
    </style>
</head>
<body>
<div class="preview-toolbar"><div class="title">预览：@ViewBag.PageName（@ViewBag.PagePath）</div><button onclick="history.back()">返回装修</button></div>
<div class="preview-canvas">
    @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Document.cshtml", renderModel)
</div>
</body>
</html>