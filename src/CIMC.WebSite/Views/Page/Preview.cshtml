@using Newtonsoft.Json
@using MySite.Web.Models
@{
    Layout = null;
    var documentJson = ViewBag.DocumentJson as string;
    var document = string.IsNullOrWhiteSpace(documentJson)
        ? new BuilderDocumentModel { Name = ViewBag.PageName as string }
        : JsonConvert.DeserializeObject<BuilderDocumentModel>(documentJson) ?? new BuilderDocumentModel();
    var renderModel = new PageRenderModel
    {
        PageId = ViewBag.PageId,
        PageName = ViewBag.PageName,
        PagePath = ViewBag.PagePath,
        Document = document
    };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>页面预览 - @ViewBag.PageName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/site/css/site.css" />
    <link rel="stylesheet" href="~/site-builder/runtime.css?v=2026090511" />
    <style>
        body{margin:0;background:#fff}.preview-toolbar{position:fixed;top:0;left:0;right:0;height:48px;background:#111827;color:#fff;display:flex;align-items:center;padding:0 16px;z-index:9999}.preview-toolbar .title{flex:1}.preview-toolbar button{border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.1);color:#fff;padding:6px 14px;border-radius:4px;cursor:pointer}.preview-canvas{padding-top:48px;width:100%;min-height:100vh;background:#fff}
    </style>
</head>
<body>
<div class="preview-toolbar"><div class="title">预览：@ViewBag.PageName（@ViewBag.PagePath）</div><button onclick="history.back()">返回装修</button></div>
<div class="preview-canvas">
    @await Html.PartialAsync("~/Views/Shared/SiteBuilder/_Document.cshtml", renderModel)
</div>
<script src="~/site/js/site.js" defer></script>
</body>
</html>
