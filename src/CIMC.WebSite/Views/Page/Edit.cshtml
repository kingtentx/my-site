@{
    Layout = null;
    var parentPages = ViewBag.ParentPages as List<MySite.Web.Models.PageModel> ?? new List<MySite.Web.Models.PageModel>();
}
@model MySite.Web.Models.PageModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>页面编辑</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css" media="all">
    <style>.form-tip{color:#999;font-size:12px;line-height:1.8}.section-title{font-weight:600;border-left:3px solid #1e9fff;padding-left:10px;margin:18px 0 14px}.notice{padding:10px 12px;background:#f8fafc;border:1px solid #e2e8f0;color:#475569;border-radius:5px;margin-bottom:15px}</style>
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-header">@(Model.Id > 0 ? "修改页面" : "新增页面")</div>
        <div class="layui-card-body" style="padding:15px;">
            <div class="notice">页面树就是网站导航树。父级页面决定导航层级，排序决定同级顺序；关闭“显示在网站导航”后页面仍可通过 URL 访问。Header/Footer 的布局与样式在【全局区域设计】中维护。</div>
            <form class="layui-form" lay-filter="page-form">
                <div class="section-title">页面与层级</div>
                <div class="layui-form-item">
                    <label class="layui-form-label">页面名称</label>
                    <div class="layui-input-inline" style="width:300px;"><input type="text" name="PageName" lay-verify="required" placeholder="如：首页" class="layui-input" value="@Html.Raw(Model.PageName)"></div>
                    <label class="layui-form-label">页面编码</label>
                    <div class="layui-input-inline" style="width:220px;"><input type="text" name="PageCode" placeholder="如：home" class="layui-input" value="@Html.Raw(Model.PageCode)"></div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">父级页面</label>
                    <div class="layui-input-block">
                        <select name="ParentId">
                            <option value="0">一级页面</option>
                            @foreach (var item in parentPages)
                            {
                                <option value="@item.Id" @Html.Raw(Model.ParentId == item.Id ? "selected" : "")>@item.PageName（@item.PagePath）</option>
                            }
                        </select>
                        <div class="form-tip">首页固定为一级页面；不能将页面移动到自身或自己的子页面下。</div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">页面路径</label>
                    <div class="layui-input-block"><input type="text" name="PagePath" lay-verify="required" placeholder="/、/about、/about/company" class="layui-input" value="@Html.Raw(Model.PagePath)"><div class="form-tip">路径必须唯一。普通自定义路径会由动态页面路由直接打开对应装修页面。</div></div>
                </div>

                <div class="section-title">网站导航</div>
                <div class="layui-form-item">
                    <label class="layui-form-label">显示在导航</label>
                    <div class="layui-input-inline" style="width:180px;"><input type="checkbox" name="ShowInNavigation" value="true" lay-skin="switch" lay-text="显示|隐藏" @Html.Raw(Model.ShowInNavigation ? " checked" : "")></div>
                    <label class="layui-form-label">打开方式</label>
                    <div class="layui-input-inline" style="width:220px;">
                        <select name="NavigationTarget">
                            <option value="0" @Html.Raw(Model.NavigationTarget == 0 ? "selected" : "")>当前窗口</option>
                            <option value="1" @Html.Raw(Model.NavigationTarget == 1 ? "selected" : "")>新窗口</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">导航标题</label>
                    <div class="layui-input-inline" style="width:300px;"><input type="text" name="NavigationTitle" placeholder="为空时使用页面名称" class="layui-input" value="@Html.Raw(Model.NavigationTitle)"></div>
                    <label class="layui-form-label">导航图标</label>
                    <div class="layui-input-inline" style="width:300px;"><input type="text" name="NavigationIcon" placeholder="可选，如 layui-icon-home" class="layui-input" value="@Html.Raw(Model.NavigationIcon)"></div>
                </div>

                <div class="section-title">SEO</div>
                <div class="layui-form-item"><label class="layui-form-label">浏览器标题</label><div class="layui-input-block"><input type="text" name="PageTitle" placeholder="SEO 浏览器标题" class="layui-input" value="@Html.Raw(Model.PageTitle)"></div></div>
                <div class="layui-form-item"><label class="layui-form-label">SEO关键词</label><div class="layui-input-block"><input type="text" name="SeoKeywords" placeholder="多个关键词用逗号分隔" class="layui-input" value="@Html.Raw(Model.SeoKeywords)"></div></div>
                <div class="layui-form-item layui-form-text"><label class="layui-form-label">SEO描述</label><div class="layui-input-block"><textarea name="SeoDescription" class="layui-textarea">@Html.Raw(Model.SeoDescription)</textarea></div></div>

                <div class="section-title">状态</div>
                <div class="layui-form-item">
                    <label class="layui-form-label">排序</label><div class="layui-input-inline" style="width:120px;"><input type="number" name="Sort" class="layui-input" value="@Model.Sort"></div>
                    <label class="layui-form-label">是否首页</label><div class="layui-input-inline" style="width:160px;"><input type="checkbox" name="IsHome" value="true" lay-skin="switch" lay-text="是|否" @Html.Raw(Model.IsHome ? " checked" : "")></div>
                    <label class="layui-form-label">是否启用</label><div class="layui-input-inline" style="width:220px;"><input type="radio" name="IsActive" value="true" title="启用" @Html.Raw(Model.IsActive ? " checked" : "")><input type="radio" name="IsActive" value="false" title="禁用" @Html.Raw(!Model.IsActive ? " checked" : "")></div>
                </div>
                <div class="layui-form-item layui-layout-admin"><div class="layui-input-block"><div class="layui-footer" style="left:0;z-index:20000"><button class="layui-btn" lay-submit lay-filter="form-page">保存页面</button><a href="/page/index" class="layui-btn layui-btn-primary">返回列表</a></div></div></div>
            </form>
        </div>
    </div>
</div>
<script src="~/resource/layuiadmin/layui/layui.js"></script>
<script>
layui.config({ base: '@Url.Content("~")/resource/layuiadmin/' }).extend({ index:'lib/index' }).use(['index','form'], function () {
    var $=layui.$, form=layui.form, layer=layui.layer, pageId=@Model.Id;
    form.on('submit(form-page)', function (data) {
        var loading=layer.load(1,{shade:.25}), payload=$.extend({},data.field);
        payload.IsHome=$('input[name="IsHome"]').prop('checked');
        payload.ShowInNavigation=$('input[name="ShowInNavigation"]').prop('checked');
        payload.IsActive=$('input[name="IsActive"]:checked').val()==='true';
        $.ajax({type:'post',url:'/page/edit?id='+pageId,data:payload,dataType:'json',success:function(res){layer.close(loading);if(res.code===200)layer.alert(res.message,function(){location.href='/page/index';});else layer.msg(res.message||'保存失败',{icon:5});},error:function(){layer.close(loading);layer.msg('页面保存失败',{icon:5});}});
        return false;
    });
});
</script>
</body>
</html>
