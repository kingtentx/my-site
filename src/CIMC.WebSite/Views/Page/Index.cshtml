@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>页面管理</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/static/layuiadmin/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="~/static/layuiadmin/style/admin.css" media="all">
    <style>
        .nav-hidden{color:#999}.page-tip{margin-left:8px;color:#6b7280}
        .treeTable .page-home-icon{margin-left:6px;color:#1e9fff;font-size:14px}
    </style>
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-form layui-card-header layuiadmin-card-header-auto">
            <div class="layui-form-item">
                <div class="layui-inline"><label class="layui-form-label">名称/路径</label><div class="layui-input-inline" style="width:260px;"><input type="text" name="keywords" placeholder="页面名称、导航名称或路径" autocomplete="off" class="layui-input"></div></div>
                <div class="layui-inline"><button class="layui-btn" lay-submit lay-filter="app-search"><i class="layui-icon layui-icon-search"></i> 查询</button><button type="button" class="layui-btn layui-btn-primary" id="btnReset">重置</button></div>
            </div>
        </div>
        <div class="layui-card-body">
            <div style="padding-bottom:12px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                @if ((bool)ViewData[PageCode.PAGE_Button_Add]) { <a class="layui-btn" href="/page/edit"><i class="layui-icon layui-icon-addition"></i>新增一级页面</a> }
                @if ((bool)ViewData[PageCode.PAGE_Button_Design]) { <a class="layui-btn layui-btn-normal" href="/GlobalRegion/Index"><i class="layui-icon layui-icon-template"></i>全局 Header / Footer</a> }
                <button type="button" class="layui-btn layui-btn-primary" id="btnExpand">展开全部</button>
                <button type="button" class="layui-btn layui-btn-primary" id="btnFold">折叠全部</button>
                <span class="page-tip">有子页面的页面作为导航目录，不装修自身内容；点击目录会进入首个已发布的子页面。</span>
            </div>
            <table id="page-table" lay-filter="page-table"></table>

            <script type="text/html" id="navTpl">{{# if(d.showInNavigation){ }}<span class="layui-badge layui-bg-green">显示</span>{{# } else { }}<span class="nav-hidden">隐藏</span>{{# } }}</script>
            <script type="text/html" id="targetTpl">{{# if(d.navigationTarget===1){ }}新窗口{{# } else { }}当前窗口{{# } }}</script>
            <script type="text/html" id="statusTpl">{{# if(d.status === 1){ }}<span class="layui-badge layui-bg-green">已发布</span>{{# } else { }}<span class="layui-badge layui-bg-orange">草稿</span>{{# } }}</script>
            <script type="text/html" id="activeTpl">{{# if(d.isActive){ }}启用{{# } else { }}<span style="color:#ff5722;">禁用</span>{{# } }}</script>
            <script type="text/html" id="pageBar">
                @if ((bool)ViewData[PageCode.PAGE_Button_Add]) { <a class="layui-btn layui-btn-primary layui-btn-xs" lay-event="child">子页面</a> }
                @if ((bool)ViewData[PageCode.PAGE_Button_Design]) { <a class="layui-btn layui-btn-warm layui-btn-xs" lay-event="design" {{# if(d.hasChildren){ }}style="display:none"{{# } }}>装修</a> }
                @if ((bool)ViewData[PageCode.PAGE_Button_Preview]) { <a class="layui-btn layui-btn-normal layui-btn-xs" lay-event="preview" {{# if(d.hasChildren){ }}style="display:none"{{# } }}>预览</a> }
                @if ((bool)ViewData[PageCode.PAGE_Button_Publish]) { <a class="layui-btn layui-btn-xs" lay-event="publish">{{ d.hasChildren ? '发布目录' : '发布' }}</a> }
                @if ((bool)ViewData[PageCode.PAGE_Button_Edit]) { <a class="layui-btn layui-btn-primary layui-btn-xs" lay-event="edit">编辑</a><a class="layui-btn layui-btn-primary layui-btn-xs" lay-event="home">设首页</a> }
                @if ((bool)ViewData[PageCode.PAGE_Button_Delete]) { <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a> }
            </script>
        </div>
    </div>
</div>
<script src="~/static/layuiadmin/layui/layui.js"></script>
<script>
layui.config({base:'@Url.Content("~/static/layuiadmin/")'}).extend({index:'lib/index'}).use(['index','table','form','treetable'],function(){
    var $=layui.$,table=layui.table,form=layui.form,layer=layui.layer,treetable=layui.treetable;
    function escapeHtml(value){return String(value==null?'':value).replace(/[&<>"']/g,function(ch){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch];});}
    function renderTree(rows){
        var homeIds={};
        var data=(rows||[]).map(function(row){
            row.pid=row.level>0?row.parentId:0;
            row.treeLabel=escapeHtml(row.pageName);
            if(row.isHome)homeIds[row.id]=true;
            return row;
        });
        treetable.render({
            treeColIndex:0,treeSpid:0,treeIdName:'id',treePidName:'pid',
            treeDefaultClose:false,treeLinkage:false,
            elem:'#page-table',data:data,page:false,
            cols:[[
                {field:'treeLabel',minWidth:250,title:'页面树 / 导航结构'},
                {field:'pagePath',minWidth:170,title:'页面路径'},
                {field:'navigationTitle',minWidth:130,title:'导航标题'},
                {field:'showInNavigation',width:90,align:'center',title:'导航',templet:'#navTpl'},
                {field:'navigationTarget',width:95,align:'center',title:'打开方式',templet:'#targetTpl'},
                {field:'status',width:90,align:'center',title:'发布',templet:'#statusTpl'},
                {field:'sort',width:70,align:'center',title:'排序'},
                {field:'isActive',width:75,align:'center',title:'状态',templet:'#activeTpl'},
                {width:470,align:'center',title:'操作',toolbar:'#pageBar'}
            ]],
            done:function(){
                $('#page-table').next('.treeTable').find('.treeTable-icon').each(function(){
                    if(!homeIds[$(this).attr('lay-tid')])return;
                    $(this).append($('<i class="layui-icon layui-icon-home page-home-icon"></i>')
                        .attr({title:'首页','aria-label':'首页'}));
                });
            }
        });
    }
    function reload(){
        var loading=layer.load(1);
        $.ajax({url:'/Page/GetList',type:'get',dataType:'json',data:{keywords:$('input[name="keywords"]').val()||''}})
            .done(function(res){if(res.code===200)renderTree(res.data);else layer.msg(res.message||'页面列表加载失败',{icon:5});})
            .fail(function(){layer.msg('页面列表加载失败',{icon:5});})
            .always(function(){layer.close(loading);});
    }
    form.on('submit(app-search)',function(){reload();return false;});
    $('#btnReset').on('click',function(){$('input[name="keywords"]').val('');reload();});
    $('#btnExpand').on('click',function(){treetable.expandAll('#page-table');});
    $('#btnFold').on('click',function(){treetable.foldAll('#page-table');});
    table.on('tool(page-table)',function(obj){
        var d=obj.data;
        if(obj.event==='child')location.href='/Page/Edit?parentId='+d.id;
        else if(obj.event==='design')location.href='/Page/Design?id='+d.id;
        else if(obj.event==='preview')window.open('/Page/Preview?id='+d.id,'_blank');
        else if(obj.event==='edit')location.href='/Page/Edit?id='+d.id;
        else if(obj.event==='publish')layer.confirm('确认发布该页面？',function(i){$.post('/Page/Publish',{id:d.id},function(res){layer.close(i);if(res.code===200){layer.msg(res.message,{icon:1});reload();}else layer.msg(res.message,{icon:5});},'json');});
        else if(obj.event==='home')$.post('/Page/SetHome',{id:d.id},function(res){if(res.code===200){layer.msg(res.message,{icon:1});reload();}else layer.msg(res.message,{icon:5});},'json');
        else if(obj.event==='del')layer.confirm('删除页面不会自动删除子页面。确认继续？',function(i){$.post('/Page/Delete',{id:d.id},function(res){layer.close(i);if(res.code===200){layer.msg(res.message,{icon:1});reload();}else layer.msg(res.message,{icon:5});},'json');});
    });
    reload();
});
</script>
</body>
</html>
