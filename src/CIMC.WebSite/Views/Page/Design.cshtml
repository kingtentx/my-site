@using Newtonsoft.Json
@{
    Layout = null;
    var pageNameJson = JsonConvert.SerializeObject(ViewBag.PageName ?? string.Empty);
    var pagePathJson = JsonConvert.SerializeObject(ViewBag.PagePath ?? string.Empty);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>新版页面装修 - @ViewBag.PageName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css">
    <style>
        *{box-sizing:border-box}html,body{height:100%;margin:0;overflow:hidden;font-family:"Microsoft YaHei",sans-serif;background:#f3f5f7;color:#1f2937}
        button{font-family:inherit}.designer-layout{height:100vh;display:flex;flex-direction:column}.designer-toolbar{height:54px;background:#111827;color:#fff;display:flex;align-items:center;padding:0 14px;box-shadow:0 2px 7px rgba(0,0,0,.14);z-index:20}.designer-toolbar .title{flex:1;font-size:15px;margin-left:12px}.designer-toolbar .path{opacity:.55;margin-left:8px;font-size:12px}.designer-toolbar button{border:1px solid rgba(255,255,255,.16);border-radius:5px;padding:7px 12px;margin-left:7px;cursor:pointer;background:rgba(255,255,255,.08);color:#fff}.designer-toolbar button:hover{background:rgba(255,255,255,.16)}.designer-toolbar button:disabled{opacity:.35;cursor:not-allowed}.designer-toolbar .primary{background:#1677ff;border-color:#1677ff}
        .designer-main{flex:1;display:flex;min-height:0}.designer-lib{width:245px;background:#fff;border-right:1px solid #e5e7eb;overflow:auto;padding:12px}.lib-title{font-size:12px;color:#6b7280;margin:16px 3px 8px;font-weight:700}.lib-tip{font-size:12px;color:#475569;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:10px;line-height:1.65}.lib-item{width:100%;display:flex;align-items:center;gap:9px;padding:10px 11px;margin-bottom:6px;border:1px solid #e5e7eb;background:#fff;border-radius:6px;cursor:pointer;text-align:left;color:#374151}.lib-item:hover{border-color:#1677ff;background:#eff6ff;color:#1677ff}.lib-item i{font-size:16px;color:#1677ff}.lib-preset{background:#f8fafc}
        .designer-canvas-wrap{flex:1;overflow:auto;padding:22px;background:#eef1f5}.designer-canvas{min-height:calc(100vh - 98px);max-width:1280px;margin:0 auto;background:#fff;border-radius:7px;box-shadow:0 2px 14px rgba(15,23,42,.08);padding:10px}.designer-empty{padding:120px 20px;text-align:center;color:#94a3b8}.sb-root-drop{min-height:500px}.sb-node{position:relative;border:1px dashed #cbd5e1;margin:8px 0;border-radius:6px;background:#fff;transition:.15s}.sb-node:hover{border-color:#94a3b8}.sb-node.selected{border:2px solid #1677ff;box-shadow:0 0 0 3px rgba(22,119,255,.08)}.sb-node.is-hidden{opacity:.42}.sb-node-toolbar{height:34px;display:flex;align-items:center;padding:0 8px;background:#f8fafc;border-bottom:1px solid #eef2f7;font-size:12px}.sb-drag{cursor:move;font-weight:600;flex:1}.sb-drag i{color:#1677ff;margin-right:5px}.sb-node-type{font-size:10px;color:#94a3b8;margin-right:8px}.sb-node-actions{display:none;gap:4px}.sb-node:hover>.sb-node-toolbar .sb-node-actions,.sb-node.selected>.sb-node-toolbar .sb-node-actions{display:flex}.sb-node-actions button{border:1px solid #dbe1e8;background:#fff;border-radius:3px;padding:2px 5px;font-size:11px;cursor:pointer}.sb-node-actions button:hover{color:#1677ff;border-color:#1677ff}.sb-node-content{min-height:36px}.sb-container-node>.sb-node-content{padding:8px}.sb-children{min-height:46px;padding:4px}.sb-grid{display:grid;align-items:stretch}.sb-grid>.sb-node{margin:0}.sb-drop-empty{min-height:46px;border:1px dashed #dbe3ec;border-radius:4px;display:flex;align-items:center;justify-content:center;color:#a0aec0;font-size:12px;background:#fbfcfe}.sb-placeholder{padding:22px;text-align:center;color:#64748b;background:#f8fafc;border-radius:4px}.sb-spacer{background:repeating-linear-gradient(45deg,#fafafa,#fafafa 8px,#f1f5f9 8px,#f1f5f9 16px)}.sb-button{display:inline-block;padding:9px 18px;border-radius:5px;font-size:14px}.sb-button-primary{background:#1677ff;color:#fff}.sb-button-outline{border:1px solid #1677ff;color:#1677ff}.sb-button-text{color:#1677ff}.sb-nav-preview{display:flex;gap:20px;justify-content:center;padding:8px}.sb-search-preview{display:inline-flex;min-width:150px;justify-content:space-between;border:1px solid #d1d5db;border-radius:5px;padding:7px 10px;color:#64748b}.sb-muted{color:#94a3b8;font-size:12px;margin-top:5px}
        .designer-props{width:365px;background:#fff;border-left:1px solid #e5e7eb;overflow:auto;padding:15px}.props-title{display:flex;align-items:center;justify-content:space-between;font-size:15px;font-weight:700;padding-bottom:12px;border-bottom:1px solid #e5e7eb;margin-bottom:12px}.props-title small{font-size:10px;color:#94a3b8;font-weight:400}.props-empty{text-align:center;color:#94a3b8;padding:90px 0}.props-section-title{font-size:12px;font-weight:700;color:#475569;margin:18px 0 10px;border-left:3px solid #1677ff;padding-left:7px}.designer-props .layui-form-label{width:92px;padding:7px 5px;font-size:12px}.designer-props .layui-input-block{margin-left:94px}.designer-props .layui-form-item{margin-bottom:10px}.designer-props .layui-input{height:32px;font-size:12px}.designer-props .layui-textarea{min-height:76px;font-size:12px}.designer-props select{width:100%;height:32px;border:1px solid #d2d2d2;padding:0 8px;background:#fff}
    </style>
</head>
<body>
<div class="designer-layout">
    <div class="designer-toolbar">
        <button type="button" onclick="location.href='/page/index'"><i class="layui-icon layui-icon-left"></i> 返回</button>
        <div class="title">新版页面装修：@ViewBag.PageName <span class="path">@ViewBag.PagePath</span></div>
        <button type="button" id="btnUndo">撤销</button>
        <button type="button" id="btnRedo">重做</button>
        <button type="button" id="btnPreview">保存并预览</button>
        <button type="button" id="btnSaveDraft" class="primary">保存草稿</button>
        <button type="button" id="btnPublish" class="primary">发布</button>
    </div>
    <div class="designer-main">
        <aside class="designer-lib" id="componentLibrary"></aside>
        <main class="designer-canvas-wrap"><div class="designer-canvas" id="canvas"></div></main>
        <aside class="designer-props" id="propsPanel"><div class="props-empty">请选择一个组件</div></aside>
    </div>
</div>
<script src="~/resource/layuiadmin/layui/layui.js"></script>
<script src="~/resource/js/jquery-1.12.4.min.js"></script>
<script src="~/resource/js/Sortable.min.js"></script>
<script>
window.pageDesignerConfig = {
    pageId: @ViewBag.PageId,
    pageName: @Html.Raw(pageNameJson),
    pagePath: @Html.Raw(pagePathJson)
};
</script>
<script src="~/site-builder/core/registry.js"></script>
<script src="~/site-builder/core/tree.js"></script>
<script src="~/site-builder/core/store.js"></script>
<script src="~/site-builder/components/default-components.js"></script>
<script src="~/site-builder/renderer/designer-renderer.js"></script>
<script src="~/site-builder/inspector/inspector.js"></script>
<script src="~/site-builder/presets.js"></script>
<script src="~/site-builder/page-designer.js"></script>
</body>
</html>