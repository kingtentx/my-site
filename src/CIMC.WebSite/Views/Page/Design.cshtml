@using Newtonsoft.Json
@{
    Layout = null;
    var pageNameJson = JsonConvert.SerializeObject(ViewBag.PageName ?? string.Empty);
    var pagePathJson = JsonConvert.SerializeObject(ViewBag.PagePath ?? string.Empty);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>新版页面装修 - @ViewBag.PageName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css">
    <style>
        *{box-sizing:border-box}html,body{height:100%;margin:0;overflow:hidden;font-family:"Microsoft YaHei",sans-serif;background:#f3f5f7;color:#1f2937}
        button{font-family:inherit}.designer-layout{height:100vh;display:flex;flex-direction:column}.designer-toolbar{height:54px;background:#111827;color:#fff;display:flex;align-items:center;padding:0 14px;box-shadow:0 2px 7px rgba(0,0,0,.14);z-index:20}.designer-toolbar .title{flex:1;font-size:15px;margin-left:12px}.designer-toolbar .path{opacity:.55;margin-left:8px;font-size:12px}.designer-toolbar button{border:1px solid rgba(255,255,255,.16);border-radius:5px;padding:7px 12px;margin-left:7px;cursor:pointer;background:rgba(255,255,255,.08);color:#fff}.designer-toolbar button:hover{background:rgba(255,255,255,.16)}.designer-toolbar button:disabled{opacity:.35;cursor:not-allowed}.designer-toolbar .primary{background:#1677ff;border-color:#1677ff}
        .designer-main{flex:1;display:flex;min-height:0}.designer-lib{width:245px;min-width:245px;background:#fff;border-right:1px solid #e5e7eb;overflow:auto;padding:12px}.lib-title{font-size:12px;color:#6b7280;margin:16px 3px 8px;font-weight:700}.lib-tip{font-size:12px;color:#475569;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:10px;line-height:1.65}.lib-item{width:100%;display:flex!important;align-items:center;gap:9px;padding:10px 11px;margin-bottom:6px;border:1px solid #e5e7eb;background:#fff;border-radius:6px;cursor:pointer;text-align:left;color:#374151;visibility:visible!important;opacity:1!important}.lib-item:hover{border-color:#1677ff;background:#eff6ff;color:#1677ff}.lib-item i{font-size:16px;color:#1677ff}.lib-preset{background:#f8fafc}
        .designer-canvas-wrap{flex:1;overflow:auto;padding:22px;background:#eef1f5}.designer-canvas{min-height:calc(100vh - 98px);max-width:1280px;margin:0 auto;background:#fff;border-radius:7px;box-shadow:0 2px 14px rgba(15,23,42,.08);padding:10px}.designer-empty{padding:120px 20px;text-align:center;color:#94a3b8}.sb-root-drop{min-height:500px}.sb-node{position:relative;border:1px dashed #cbd5e1;margin:8px 0;border-radius:6px;background:#fff;transition:.15s}.sb-node:hover{border-color:#94a3b8}.sb-node.selected{border:2px solid #1677ff;box-shadow:0 0 0 3px rgba(22,119,255,.08)}.sb-node.is-hidden{opacity:.42}.sb-node-toolbar{height:34px;display:flex;align-items:center;padding:0 8px;background:#f8fafc;border-bottom:1px solid #eef2f7;font-size:12px}.sb-drag{cursor:grab;font-weight:600;flex:1;user-select:none}.sb-drag:active{cursor:grabbing}.sb-drag i{color:#1677ff;margin-right:5px}.sb-node-type{font-size:10px;color:#94a3b8;margin-right:8px}.sb-node-actions{display:none;gap:4px}.sb-node:hover>.sb-node-toolbar .sb-node-actions,.sb-node.selected>.sb-node-toolbar .sb-node-actions{display:flex}.sb-node-actions button{border:1px solid #dbe1e8;background:#fff;border-radius:3px;padding:2px 5px;font-size:11px;cursor:pointer}.sb-node-actions button:hover{color:#1677ff;border-color:#1677ff}.sb-node-content{min-height:36px}.sb-container-node>.sb-node-content{padding:8px}.sb-children{min-height:46px;padding:4px}.sb-grid{display:grid;align-items:stretch}.sb-grid>.sb-node{margin:0}.sb-drop-empty{min-height:46px;border:1px dashed #dbe3ec;border-radius:4px;display:flex;align-items:center;justify-content:center;color:#a0aec0;font-size:12px;background:#fbfcfe}.sb-placeholder{padding:22px;text-align:center;color:#64748b;background:#f8fafc;border-radius:4px}.sb-spacer{background:repeating-linear-gradient(45deg,#fafafa,#fafafa 8px,#f1f5f9 8px,#f1f5f9 16px)}.sb-button{display:inline-block;padding:9px 18px;border-radius:5px;font-size:14px}.sb-button-primary{background:#1677ff;color:#fff}.sb-button-outline{border:1px solid #1677ff;color:#1677ff}.sb-button-text{color:#1677ff}.sb-nav-preview{display:flex;gap:20px;justify-content:center;padding:8px}.sb-search-preview{display:inline-flex;min-width:150px;justify-content:space-between;border:1px solid #d1d5db;border-radius:5px;padding:7px 10px;color:#64748b}.sb-muted{color:#94a3b8;font-size:12px;margin-top:5px}.sb-banner-preview{position:relative;overflow:hidden;border-radius:4px;background:#f1f5f9}.sb-banner-badge{position:absolute;top:10px;right:10px;padding:4px 9px;border-radius:12px;background:rgba(15,23,42,.72);color:#fff;font-size:11px}.sb-banner-dots{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);display:flex;gap:6px}.sb-banner-dots i{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.55)}.sb-banner-dots i.active{background:#fff}
        .sb-sort-ghost{opacity:.25!important;border:2px dashed #1677ff!important;background:#eaf3ff!important}.sb-sort-chosen{box-shadow:0 0 0 3px rgba(22,119,255,.16)!important}.sb-sort-drag{opacity:.95!important;box-shadow:0 12px 34px rgba(15,23,42,.2)!important}.sb-is-dragging .sb-drop-empty{border-color:#1677ff;background:#eff6ff}.sb-is-dragging .sb-drag{cursor:grabbing}
        .designer-props{width:365px;background:#fff;border-left:1px solid #e5e7eb;overflow:auto;padding:15px}.props-title{display:flex;align-items:center;justify-content:space-between;font-size:15px;font-weight:700;padding-bottom:12px;border-bottom:1px solid #e5e7eb;margin-bottom:12px}.props-title small{font-size:10px;color:#94a3b8;font-weight:400}.props-empty{text-align:center;color:#94a3b8;padding:90px 0}.props-section-title{font-size:12px;font-weight:700;color:#475569;margin:18px 0 10px;border-left:3px solid #1677ff;padding-left:7px}.designer-props .layui-form-label{width:92px;padding:7px 5px;font-size:12px}.designer-props .layui-input-block{margin-left:94px}.designer-props .layui-form-item{margin-bottom:10px}.designer-props .layui-input{height:32px;font-size:12px}.designer-props .layui-textarea{min-height:76px;font-size:12px}.designer-props select{width:100%;height:32px;border:1px solid #d2d2d2;padding:0 8px;background:#fff}.sb-image-input-row{display:flex;gap:6px}.sb-image-input-row .layui-input{min-width:0;flex:1}.sb-image-pick-btn{height:32px;white-space:nowrap;border:1px solid #1677ff;border-radius:4px;background:#fff;color:#1677ff;padding:0 10px;cursor:pointer}.sb-image-pick-btn:hover{background:#1677ff;color:#fff}.sb-image-preview{margin-top:8px;padding:6px;border:1px solid #e5e7eb;border-radius:5px;background:#f8fafc}.sb-image-preview img{display:block;width:100%;max-height:150px;object-fit:contain}.sb-image-list-toolbar{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.sb-image-list-clear{height:32px;border:1px solid #ef4444;border-radius:4px;background:#fff;color:#ef4444;padding:0 9px;cursor:pointer}.sb-image-list-count{font-size:11px;color:#64748b}.sb-image-list-empty{margin-top:8px;padding:10px;border:1px dashed #cbd5e1;border-radius:5px;background:#f8fafc;color:#94a3b8;font-size:11px;line-height:1.6}.sb-image-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:9px}.sb-image-list-item{min-width:0;border:1px solid #e5e7eb;border-radius:5px;overflow:hidden;background:#fff}.sb-image-list-item>img{width:100%;height:76px;object-fit:cover}.sb-image-list-meta{display:flex;align-items:center;justify-content:space-between;padding:4px 5px;font-size:10px;color:#64748b}.sb-image-list-meta>div{display:flex;gap:3px}.sb-image-list-meta button{border:1px solid #dbe1e8;background:#fff;border-radius:3px;font-size:10px;padding:1px 4px;cursor:pointer}.sb-image-list-meta button:disabled{opacity:.35;cursor:not-allowed}
        .sb-material-mask{position:fixed;inset:0;z-index:100000;background:rgba(15,23,42,.48);display:flex;align-items:center;justify-content:center;padding:28px}.sb-material-dialog{width:min(980px,92vw);height:min(720px,86vh);display:flex;flex-direction:column;background:#fff;border-radius:10px;box-shadow:0 24px 70px rgba(0,0,0,.28);overflow:hidden}.sb-material-head{height:54px;display:flex;align-items:center;padding:0 18px;border-bottom:1px solid #e5e7eb}.sb-material-head strong{flex:1;font-size:16px}.sb-material-head button{width:34px;height:34px;border:0;background:transparent;font-size:25px;color:#64748b;cursor:pointer}.sb-material-tools{display:flex;gap:8px;padding:12px 16px;border-bottom:1px solid #eef2f7}.sb-material-tools input{flex:1;height:36px;border:1px solid #d1d5db;border-radius:5px;padding:0 10px;outline:none}.sb-material-tools input:focus{border-color:#1677ff}.sb-material-tools button,.sb-material-foot button{height:34px;border:1px solid #d1d5db;border-radius:5px;background:#fff;padding:0 14px;cursor:pointer}.sb-material-tools button{background:#1677ff;border-color:#1677ff;color:#fff}.sb-material-body{flex:1;overflow:auto;padding:16px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;align-content:start}.sb-material-item{position:relative;display:flex;min-width:0;flex-direction:column;border:1px solid #e5e7eb;border-radius:7px;background:#fff;padding:0;overflow:hidden;cursor:pointer;text-align:left}.sb-material-item:hover{border-color:#1677ff;box-shadow:0 0 0 2px rgba(22,119,255,.08)}.sb-material-item.is-selected{border-color:#1677ff;box-shadow:0 0 0 2px rgba(22,119,255,.18)}.sb-material-check{display:none;position:absolute;right:7px;top:7px;z-index:2;width:23px;height:23px;border-radius:50%;background:#1677ff;color:#fff;text-align:center;line-height:23px;font-weight:700}.sb-material-item.is-selected .sb-material-check{display:block}.sb-material-thumb{display:flex;height:145px;align-items:center;justify-content:center;background:#f8fafc;border-bottom:1px solid #eef2f7}.sb-material-thumb img{width:100%;height:100%;object-fit:contain}.sb-material-name{display:block;padding:8px 10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px;color:#475569}.sb-material-empty{grid-column:1/-1;padding:90px 20px;text-align:center;color:#94a3b8}.sb-material-empty.is-error{color:#d4380d}.sb-material-foot{height:52px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;border-top:1px solid #e5e7eb;color:#64748b}.sb-material-foot>div{display:flex;align-items:center;gap:9px}.sb-material-foot button:disabled{opacity:.4;cursor:not-allowed}.sb-material-selected{font-size:12px;color:#1677ff}.sb-material-confirm{background:#1677ff!important;border-color:#1677ff!important;color:#fff!important}
        @@media(max-width:900px){.sb-material-body{grid-template-columns:repeat(3,minmax(0,1fr))}}@@media(max-width:640px){.sb-material-body{grid-template-columns:repeat(2,minmax(0,1fr))}.sb-material-mask{padding:10px}}
    </style>
</head>
<body>
<div class="designer-layout">
    <div class="designer-toolbar">
        <button type="button" onclick="location.href='/page/index'"><i class="layui-icon layui-icon-left"></i> 返回</button>
        <div class="title">新版页面装修：@ViewBag.PageName <span class="path">@ViewBag.PagePath</span></div>
        <button type="button" id="btnUndo">撤销</button>
        <button type="button" id="btnRedo">重做</button>
        <button type="button" id="btnPreview">保存并预览</button>
        <button type="button" id="btnSaveDraft" class="primary">保存草稿</button>
        <button type="button" id="btnPublish" class="primary">发布</button>
    </div>
    <div class="designer-main">
        <aside class="designer-lib" id="componentLibrary">
            <div class="lib-tip">组件库正在初始化。如果脚本加载失败，下列基础组件仍会保留显示，便于定位问题。</div>
            <div class="lib-title">布局组件</div>
            <button type="button" class="lib-item" data-type="section"><i class="layui-icon layui-icon-template-1"></i><span>区段</span></button>
            <button type="button" class="lib-item" data-type="container"><i class="layui-icon layui-icon-screen-full"></i><span>容器</span></button>
            <button type="button" class="lib-item" data-type="grid"><i class="layui-icon layui-icon-table"></i><span>网格</span></button>
            <button type="button" class="lib-item" data-type="column"><i class="layui-icon layui-icon-tabs"></i><span>列</span></button>
            <div class="lib-title">基础组件</div>
            <button type="button" class="lib-item" data-type="heading"><i class="layui-icon layui-icon-fonts-strong"></i><span>标题</span></button>
            <button type="button" class="lib-item" data-type="text"><i class="layui-icon layui-icon-edit"></i><span>文本</span></button>
            <button type="button" class="lib-item" data-type="image"><i class="layui-icon layui-icon-picture"></i><span>图片</span></button>
            <button type="button" class="lib-item" data-type="banner"><i class="layui-icon layui-icon-carousel"></i><span>Banner</span></button>
            <button type="button" class="lib-item" data-type="button"><i class="layui-icon layui-icon-link"></i><span>按钮</span></button>
            <button type="button" class="lib-item" data-type="icon"><i class="layui-icon layui-icon-star"></i><span>图标</span></button>
            <button type="button" class="lib-item" data-type="video"><i class="layui-icon layui-icon-video"></i><span>视频</span></button>
            <button type="button" class="lib-item" data-type="divider"><i class="layui-icon layui-icon-more"></i><span>分隔线</span></button>
            <button type="button" class="lib-item" data-type="spacer"><i class="layui-icon layui-icon-screen-full"></i><span>间距</span></button>
            <div class="lib-title">内容组件</div>
            <button type="button" class="lib-item" data-type="articleList"><i class="layui-icon layui-icon-list"></i><span>文章列表</span></button>
            <button type="button" class="lib-item" data-type="productList"><i class="layui-icon layui-icon-component"></i><span>产品列表</span></button>
            <button type="button" class="lib-item" data-type="jobList"><i class="layui-icon layui-icon-friends"></i><span>招聘列表</span></button>
            <div class="lib-title">全局组件</div>
            <button type="button" class="lib-item" data-type="logo"><i class="layui-icon layui-icon-picture-fine"></i><span>Logo</span></button>
            <button type="button" class="lib-item" data-type="navigation"><i class="layui-icon layui-icon-menu-fill"></i><span>导航菜单</span></button>
            <button type="button" class="lib-item" data-type="search"><i class="layui-icon layui-icon-search"></i><span>搜索</span></button>
            <button type="button" class="lib-item" data-type="language"><i class="layui-icon layui-icon-website"></i><span>语言切换</span></button>
            <button type="button" class="lib-item" data-type="contact"><i class="layui-icon layui-icon-cellphone"></i><span>联系方式</span></button>
            <button type="button" class="lib-item" data-type="social"><i class="layui-icon layui-icon-share"></i><span>社交链接</span></button>
            <button type="button" class="lib-item" data-type="copyright"><i class="layui-icon layui-icon-auz"></i><span>版权信息</span></button>
        </aside>
        <main class="designer-canvas-wrap"><div class="designer-canvas" id="canvas"></div></main>
        <aside class="designer-props" id="propsPanel"><div class="props-empty">请选择一个组件</div></aside>
    </div>
</div>
<script src="~/resource/layuiadmin/layui/layui.js"></script>
<script src="~/resource/js/jquery-1.12.4.min.js"></script>
<script src="~/resource/js/Sortable.min.js"></script>
<script>
window.pageDesignerConfig = {
    pageId: @ViewBag.PageId,
    pageName: @Html.Raw(pageNameJson),
    pagePath: @Html.Raw(pagePathJson)
};
</script>
<script src="~/site-builder/core/registry.js?v=2026090505"></script>
<script src="~/site-builder/core/tree.js?v=2026090505"></script>
<script src="~/site-builder/core/store.js?v=2026090505"></script>
<script src="~/site-builder/components/default-components.js?v=2026090505"></script>
<script src="~/site-builder/renderer/designer-renderer.js?v=2026090505"></script>
<script src="~/site-builder/inspector/inspector.js?v=2026090505"></script>
<script src="~/site-builder/presets.js?v=2026090505"></script>
<script src="~/site-builder/page-designer.js?v=2026090505"></script>
</body>
</html>