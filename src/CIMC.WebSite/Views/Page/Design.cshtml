@using Newtonsoft.Json
@{
    Layout = null;
    var pageNameJson = JsonConvert.SerializeObject(ViewBag.PageName ?? string.Empty);
    var pagePathJson = JsonConvert.SerializeObject(ViewBag.PagePath ?? string.Empty);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>页面装修 - @ViewBag.PageName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/resource/layuiadmin/layui/css/layui.css">
    <link rel="stylesheet" href="~/resource/layuiadmin/style/admin.css">
    <style>
        *{box-sizing:border-box}html,body{height:100%;margin:0;overflow:hidden;font-family:"Microsoft YaHei",sans-serif;background:#f3f5f7}
        .designer-layout{height:100vh;display:flex;flex-direction:column}.designer-toolbar{height:52px;background:#1677ff;color:#fff;display:flex;align-items:center;padding:0 14px;box-shadow:0 2px 7px rgba(0,0,0,.12);z-index:10}
        .designer-toolbar .title{flex:1;font-size:15px;margin-left:12px}.designer-toolbar .path{opacity:.7;margin-left:8px}.designer-toolbar button{border:0;border-radius:4px;padding:7px 13px;margin-left:7px;cursor:pointer;background:rgba(255,255,255,.18);color:#fff}.designer-toolbar button:hover{background:rgba(255,255,255,.28)}.designer-toolbar .primary{background:#fff;color:#1677ff}
        .designer-main{flex:1;display:flex;min-height:0}.designer-lib{width:225px;background:#fff;border-right:1px solid #e8e8e8;overflow:auto;padding:10px}.lib-title{font-size:12px;color:#8c8c8c;margin:12px 4px 7px;font-weight:600}.lib-tip{font-size:12px;color:#777;background:#f7f8fa;border-radius:4px;padding:8px;line-height:1.6}.lib-item{display:flex;align-items:center;gap:8px;padding:9px 11px;margin-bottom:6px;border:1px solid #eee;background:#fafafa;border-radius:5px;cursor:pointer;user-select:none}.lib-item:hover{border-color:#1677ff;background:#eaf3ff}.lib-item i{font-size:17px;color:#1677ff}
        .designer-canvas-wrap{flex:1;overflow:auto;padding:18px}.designer-canvas{min-height:100%;max-width:1180px;margin:0 auto;background:#fff;border-radius:6px;box-shadow:0 2px 12px rgba(0,0,0,.06);padding:8px}.designer-empty{padding:100px 20px;text-align:center;color:#aaa}.designer-block{border:1px dashed #cfcfcf;margin:8px;border-radius:5px;background:#fff}.designer-block.selected{border:2px solid #1677ff;box-shadow:0 0 0 3px rgba(22,119,255,.1)}.designer-block.hidden-block{opacity:.48}.designer-block-header{height:38px;display:flex;align-items:center;padding:0 10px;background:#fafafa;border-bottom:1px solid #f0f0f0;cursor:move}.block-name{flex:1;font-size:13px}.block-name i{color:#1677ff;margin-right:5px}.block-type{font-size:11px;color:#aaa;margin-right:10px}.block-actions{display:none;gap:4px}.designer-block:hover .block-actions{display:flex}.block-actions button{font-size:11px;border:1px solid #ddd;background:#fff;border-radius:3px;padding:2px 5px;cursor:pointer}.block-actions button:hover{border-color:#1677ff;color:#1677ff}.block-actions button.danger:hover{border-color:#ff4d4f;color:#ff4d4f}.designer-block-body{padding:13px;min-height:52px}.designer-preview-empty{text-align:center;color:#999;padding:18px}.designer-rich-preview{max-height:180px;overflow:hidden}.preview-caption{text-align:center;color:#999;font-size:12px;margin-top:6px}
        .designer-props{width:350px;background:#fff;border-left:1px solid #e8e8e8;overflow:auto;padding:15px}.props-title{font-size:15px;font-weight:600;padding-bottom:11px;border-bottom:1px solid #eee;margin-bottom:13px}.props-empty{text-align:center;color:#aaa;padding:70px 0}.designer-props .layui-form-label{width:88px;padding:7px 5px;font-size:12px}.designer-props .layui-input-block{margin-left:88px}.designer-props .layui-form-item{margin-bottom:11px}.designer-props .layui-input{height:32px;font-size:12px}.props-subtitle{font-size:12px;font-weight:600;margin:12px 0 8px;border-left:3px solid #1677ff;padding-left:7px}.banner-editor{padding:8px;background:#f7f8fa;border-radius:4px;margin-bottom:8px}.banner-editor-title{display:flex;justify-content:space-between;font-size:12px;font-weight:600;margin-bottom:6px}.banner-editor-title a{color:#ff4d4f;cursor:pointer}.banner-editor .layui-input{margin-top:5px}.props-thumb{width:65px;height:45px;object-fit:cover;margin-left:7px;border-radius:3px;vertical-align:middle}.rich-editor{border:1px solid #ddd;min-height:230px}.component-save-box{border-top:1px solid #eee;margin-top:18px;padding-top:14px}.component-save-tip{font-size:11px;text-align:center;color:#999;margin-top:7px}.component-save-tip.saved{color:#16a34a}
        .layui-icon-fonts:before{content:"\e62b"}.layui-icon-image:before{content:"\e60d"}.layui-icon-button:before{content:"\e64c"}
    </style>
</head>
<body>
<div class="designer-layout">
    <div class="designer-toolbar">
        <button type="button" onclick="location.href='/page/index'"><i class="layui-icon layui-icon-left"></i> 返回</button>
        <div class="title">页面装修：@ViewBag.PageName <span class="path">@ViewBag.PagePath</span></div>
        <button type="button" id="btnUndo">撤销</button>
        <button type="button" id="btnRedo">重做</button>
        <button type="button" id="btnPreview">保存并预览</button>
        <button type="button" id="btnSaveDraft" class="primary">保存全部草稿</button>
        <button type="button" id="btnPublish" class="primary">发布</button>
    </div>
    <div class="designer-main">
        <aside class="designer-lib">
            <div class="lib-tip">顶部导航已合并到【页面管理】，页脚继续在【页脚设置】维护。点击左侧组件可添加；拖动画布中的组件可调整顺序。</div>
            <div class="lib-title">基础组件</div>
            <div class="lib-item" data-type="banner"><i class="layui-icon layui-icon-picture"></i>Banner图</div>
            <div class="lib-item" data-type="title"><i class="layui-icon layui-icon-fonts-strong"></i>标题</div>
            <div class="lib-item" data-type="richText"><i class="layui-icon layui-icon-edit"></i>富文本</div>
            <div class="lib-item" data-type="image"><i class="layui-icon layui-icon-picture-fine"></i>图片</div>
            <div class="lib-item" data-type="button"><i class="layui-icon layui-icon-link"></i>按钮</div>
            <div class="lib-item" data-type="iconText"><i class="layui-icon layui-icon-template-1"></i>图文卡片</div>
            <div class="lib-item" data-type="video"><i class="layui-icon layui-icon-video"></i>视频</div>
            <div class="lib-item" data-type="divider"><i class="layui-icon layui-icon-more"></i>分隔线</div>
            <div class="lib-item" data-type="spacer"><i class="layui-icon layui-icon-screen-full"></i>间距</div>
            <div class="lib-title">内容组件</div>
            <div class="lib-item" data-type="news"><i class="layui-icon layui-icon-list"></i>文章列表</div>
            <div class="lib-item" data-type="product"><i class="layui-icon layui-icon-component"></i>产品列表</div>
            <div class="lib-item" data-type="job"><i class="layui-icon layui-icon-friends"></i>招聘列表</div>
        </aside>
        <main class="designer-canvas-wrap"><div class="designer-canvas" id="canvas"><div class="designer-empty">正在加载页面组件...</div></div></main>
        <aside class="designer-props" id="propsPanel"><div class="props-empty">请选择一个组件</div></aside>
    </div>
</div>
<script src="~/resource/layuiadmin/layui/layui.js"></script>
<script src="~/resource/js/jquery-1.12.4.min.js"></script>
<script src="~/resource/js/Sortable.min.js"></script>
<script src="~/resource/wangeditor-4.7.9/wangEditor.min.js"></script>
<script>
window.pageDesignerConfig = {
    pageId: @ViewBag.PageId,
    pageName: @Html.Raw(pageNameJson),
    pagePath: @Html.Raw(pagePathJson)
};
</script>
<script src="~/site-builder/page-designer.js"></script>
</body>
</html>