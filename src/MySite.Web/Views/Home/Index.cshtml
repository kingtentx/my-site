@model SitePageDto
@{
    ViewData["Title"] = Model.Title;
    var sections = Model.Sections.Where(p => p.IsEnabled).OrderBy(p => p.Sort).ToList();
}

@if (!sections.Any())
{
    <section class="empty-page">
        <h1>@Model.Title</h1>
        <p>当前页面还没有配置模块，请进入后台设计器添加组件。</p>
        <a class="btn" href="/Admin/Designer?pageKey=@Model.PageKey">进入后台配置</a>
    </section>
}

@foreach (var sect in sections)
{
    if (sect.Component == "hero")
    {
        var image = sect.Images.FirstOrDefault() ?? "/img/default-hero.svg";
        var height = sect.GetString("height", "640px");
        <section class="hero" style="min-height:@height;background-image:linear-gradient(90deg,rgba(3,23,54,.82),rgba(3,23,54,.28)),url('@image')">
            <div class="container hero-content">
                <span class="eyebrow">@sect.Name</span>
                <h1>@sect.Title</h1>
                <p>@sect.SubTitle</p>
                @if (!string.IsNullOrWhiteSpace(sect.LinkUrl))
                {
                    <a class="btn" href="@sect.LinkUrl">@(string.IsNullOrWhiteSpace(sect.LinkText) ? "了解更多" : sect.LinkText)</a>
                }
            </div>
        </section>
    }
    else if (sect.Component == "rich-text")
    {
        <section class="section rich-text">
            <div class="container">
                <div class="section-title">
                    <span>@sect.SubTitle</span>
                    <h2>@sect.Title</h2>
                </div>
                <div class="content-body">@Html.Raw(sect.GetString("html", "<p>请在后台填写内容。</p>"))</div>
            </div>
        </section>
    }
    else if (sect.Component == "feature-grid")
    {
        var columns = sect.GetString("columns", "3");
        <section class="section alt">
            <div class="container">
                <div class="section-title">
                    <span>@sect.SubTitle</span>
                    <h2>@sect.Title</h2>
                </div>
                <div class="feature-grid" style="grid-template-columns:repeat(@columns,minmax(0,1fr))">
                    @foreach (var item in sect.GetArray("items"))
                    {
                        <article class="feature-card">
                            <strong>@(item?["icon"]?.ToString() ?? "•")</strong>
                            <h3>@item?["title"]</h3>
                            <p>@item?["description"]</p>
                        </article>
                    }
                </div>
            </div>
        </section>
    }
    else if (sect.Component == "image-text")
    {
        var image = sect.Images.FirstOrDefault() ?? sect.GetString("image", "/img/default-image.svg");
        var reverse = string.Equals(sect.GetString("reverse", "false"), "true", StringComparison.OrdinalIgnoreCase);
        <section class="section">
            <div class="container image-text @(reverse ? "reverse" : "")">
                <div class="image-box"><img src="@image" alt="@sect.Title" /></div>
                <div class="copy-box">
                    <span class="eyebrow">@sect.SubTitle</span>
                    <h2>@sect.Title</h2>
                    <p>@sect.GetString("description", sect.SubTitle ?? string.Empty)</p>
                    @if (!string.IsNullOrWhiteSpace(sect.LinkUrl))
                    {
                        <a class="text-link" href="@sect.LinkUrl">@(string.IsNullOrWhiteSpace(sect.LinkText) ? "查看详情" : sect.LinkText)</a>
                    }
                </div>
            </div>
        </section>
    }
    else if (sect.Component == "stats")
    {
        <section class="section alt">
            <div class="container">
                <div class="section-title"><h2>@sect.Title</h2></div>
                <div class="stats-grid">
                    @foreach (var item in sect.GetArray("items"))
                    {
                        <div class="stat-card">
                            <strong>@item?["value"]</strong>
                            <span>@item?["label"]</span>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (sect.Component == "cta")
    {
        var background = sect.GetString("background", "#0b2b5c");
        <section class="section">
            <div class="container">
                <div class="cta" style="background:@background">
                    <h2>@sect.Title</h2>
                    <p>@sect.SubTitle</p>
                    @if (!string.IsNullOrWhiteSpace(sect.LinkUrl))
                    {
                        <a class="btn light" href="@sect.LinkUrl">@(string.IsNullOrWhiteSpace(sect.LinkText) ? "立即开始" : sect.LinkText)</a>
                    }
                </div>
            </div>
        </section>
    }
}
