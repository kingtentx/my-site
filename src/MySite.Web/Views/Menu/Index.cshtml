@model List<Menu>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>菜单管理</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="https://unpkg.com/layui@2.9.21/dist/css/layui.css">
    <link rel="stylesheet" href="~/css/layuiadmin-admin.css" asp-append-version="true" />
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-header">菜单管理</div>
        <div class="layui-card-body">
            <form class="layui-form layui-form-pane" method="post" action="/Menu/Save">
                <div class="layui-row layui-col-space10">
                    <div class="layui-col-md1"><input name="Id" class="layui-input" placeholder="ID" /></div>
                    <div class="layui-col-md2"><input name="Code" class="layui-input" placeholder="菜单编码" /></div>
                    <div class="layui-col-md2"><input name="Name" class="layui-input" placeholder="菜单名称" /></div>
                    <div class="layui-col-md3"><input name="Path" class="layui-input" placeholder="访问路径" /></div>
                    <div class="layui-col-md2"><input name="Icon" class="layui-input" placeholder="图标，如 layui-icon-template" /></div>
                    <div class="layui-col-md1"><input name="Sort" type="number" value="100" class="layui-input" /></div>
                    <div class="layui-col-md1"><button class="layui-btn" type="submit">保存</button></div>
                </div>
                <input type="hidden" name="IsEnabled" value="true" />
            </form>
            <table class="layui-table" lay-size="sm">
                <thead><tr><th>ID</th><th>编码</th><th>名称</th><th>路径</th><th>图标</th><th>排序</th><th>启用</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td><td>@item.Code</td><td>@item.Name</td><td>@item.Path</td><td>@item.Icon</td><td>@item.Sort</td><td>@(item.IsEnabled ? "是" : "否")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="https://unpkg.com/layui@2.9.21/dist/layui.js"></script>
</body>
</html>
