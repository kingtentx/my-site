@{
    Layout = null;
    var userName = ViewBag.UserName as string ?? "管理员";
    var serverInfo = ViewBag.ServerInfo as string ?? string.Empty;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>控制台</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="https://unpkg.com/layui@2.9.21/dist/css/layui.css">
    <link rel="stylesheet" href="~/css/layuiadmin-admin.css" asp-append-version="true" />
</head>
<body>
<div class="layui-fluid">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md12">
            <div class="layui-card">
                <div class="layui-card-header">控制台</div>
                <div class="layui-card-body">
                    <blockquote class="layui-elem-quote">您好：<b>@userName</b>，欢迎登录通用可视化建站后台。</blockquote>
                    <p>@serverInfo</p>
                </div>
            </div>
        </div>
        <div class="layui-col-md3"><div class="layui-card dashboard-card"><div class="layui-card-header">页面装修</div><div class="layui-card-body"><a class="layui-btn layui-btn-normal" href="/Admin/Designer?pageKey=home" target="_blank">设计首页</a></div></div></div>
        <div class="layui-col-md3"><div class="layui-card dashboard-card"><div class="layui-card-header">菜单权限</div><div class="layui-card-body"><a class="layui-btn" href="/Role">角色授权</a></div></div></div>
        <div class="layui-col-md3"><div class="layui-card dashboard-card"><div class="layui-card-header">审计日志</div><div class="layui-card-body"><a class="layui-btn layui-btn-warm" href="/AuditLog">查看日志</a></div></div></div>
        <div class="layui-col-md3"><div class="layui-card dashboard-card"><div class="layui-card-header">前台预览</div><div class="layui-card-body"><a class="layui-btn layui-btn-primary" href="/" target="_blank">打开网站</a></div></div></div>
    </div>
</div>
</body>
</html>
