@model IReadOnlyList<SitePageDto>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>页面管理</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="https://unpkg.com/layui@2.9.21/dist/css/layui.css">
    <link rel="stylesheet" href="~/css/layuiadmin-admin.css" asp-append-version="true" />
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-header">页面管理</div>
        <div class="layui-card-body">
            <div class="layui-form-item">
                <a class="layui-btn layui-btn-normal" href="/Admin/Designer?pageKey=home" target="_blank"><i class="layui-icon layui-icon-template-1"></i> 设计首页</a>
                <form class="layui-inline" method="get" action="/Admin/Designer" target="_blank" style="margin-left:10px;">
                    <div class="layui-inline"><input name="pageKey" class="layui-input" placeholder="新页面标识，如 contact" /></div>
                    <button class="layui-btn" type="submit">创建/编辑页面</button>
                </form>
            </div>
            <table class="layui-table">
                <thead><tr><th>页面标题</th><th>页面标识</th><th>模块数量</th><th>操作</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.PageKey</td>
                        <td>@item.Sections.Count</td>
                        <td>
                            <a class="layui-btn layui-btn-xs layui-btn-normal" href="/Admin/Designer?pageKey=@item.PageKey" target="_blank">装修</a>
                            <a class="layui-btn layui-btn-xs layui-btn-primary" href="/@(item.PageKey == "home" ? "" : item.PageKey)" target="_blank">预览</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
</body>
</html>
