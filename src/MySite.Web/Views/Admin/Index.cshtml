@model IReadOnlyList<SitePageDto>
@{
    ViewData["Title"] = "后台管理";
    var menus = ViewBag.Menus as List<Menu> ?? new List<Menu>();
}
<section class="admin-shell">
    <div class="admin-title">
        <div>
            <span class="eyebrow">Admin</span>
            <h1>后台管理</h1>
            <p>保留菜单、角色权限、审计日志基础能力，同时提供页面可视化设计。</p>
        </div>
        <a class="btn" href="/Admin/Designer?pageKey=home">设计首页</a>
    </div>
    <div class="admin-menu-grid">
        @foreach (var menu in menus)
        {
            <a class="page-card" href="@menu.Path">
                <h2>@menu.Name</h2>
                <p>菜单编码：@menu.Code</p>
                <p>路径：@menu.Path</p>
            </a>
        }
    </div>
    <h2 class="block-title">页面管理</h2>
    <div class="page-list">
        @foreach (var pagemodel in Model)
        {
            <article class="page-card">
                <h2>@pagemodel.Title</h2>
                <p>页面标识：@pagemodel.PageKey</p>
                <p>模块数量：@pagemodel.Sections.Count</p>
                <div class="card-actions">
                    <a class="btn small" href="/Admin/Designer?pageKey=@pagemodel.PageKey">可视化设计</a>
                    <a class="btn ghost small" href="/@(pagemodel.PageKey == "home" ? "" : pagemodel.PageKey)" target="_blank">前台预览</a>
                </div>
            </article>
        }
        <article class="page-card new-page">
            <h2>新增页面</h2>
            <p>在地址中输入新的 pageKey 即可创建，例如 products、contact。</p>
            <form method="get" action="/Admin/Designer">
                <input name="pageKey" placeholder="例如：contact" />
                <button class="btn small" type="submit">创建/编辑</button>
            </form>
        </article>
    </div>
</section>
