@model List<AuditLog>
@{
    Layout = null;
    var total = Convert.ToInt32(ViewBag.Total ?? 0);
    var pageindex = Convert.ToInt32(ViewBag.Page ?? 1);
    var pageSize = Convert.ToInt32(ViewBag.PageSize ?? 50);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>审计日志</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="https://unpkg.com/layui@2.9.21/dist/css/layui.css">
    <link rel="stylesheet" href="~/css/layuiadmin-admin.css" asp-append-version="true" />
</head>
<body>
<div class="layui-fluid">
    <div class="layui-card">
        <div class="layui-card-header">审计日志</div>
        <div class="layui-card-body">
            <table class="layui-table" lay-size="sm">
                <thead><tr><th>时间</th><th>用户</th><th>操作</th><th>方法</th><th>路径</th><th>状态</th><th>耗时</th><th>IP</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CreationTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@item.UserName</td>
                        <td>@item.Action</td>
                        <td>@item.Method</td>
                        <td>@item.Path</td>
                        <td>@item.StatusCode</td>
                        <td>@item.ElapsedMilliseconds ms</td>
                        <td>@item.Ip</td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="layui-box layui-laypage layui-laypage-default"><span class="layui-laypage-count">第 @pageindex 页，每页 @pageSize 条，共 @total 条</span></div>
        </div>
    </div>
</div>
<script src="https://unpkg.com/layui@2.9.21/dist/layui.js"></script>
</body>
</html>
