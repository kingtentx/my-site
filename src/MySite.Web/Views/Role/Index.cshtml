@model List<Role>
@{
    ViewData["Title"] = "角色权限";
    var menus = ViewBag.Menus as List<Menu> ?? new List<Menu>();
    var roleMenus = ViewBag.RoleMenus as List<RoleMenu> ?? new List<RoleMenu>();
    var currentRoleId = Convert.ToInt32(ViewBag.CurrentRoleId ?? 0);
    bool Has(int menuId, Func<RoleMenu, bool> check) => roleMenus.Any(p => p.MenuId == menuId && check(p));
}
<section class="admin-shell">
    <div class="admin-title">
        <div>
            <span class="eyebrow">Permission</span>
            <h1>角色权限</h1>
            <p>维护角色，并为角色分配菜单查看、新增、编辑、删除权限。</p>
        </div>
        <a class="btn ghost" href="/Admin">返回后台</a>
    </div>
    <div class="page-list">
        <form class="page-card" method="post" action="/Role/SaveRole">
            <h2>新增/编辑角色</h2>
            <input name="Id" placeholder="ID，新增可留空" />
            <input name="Code" placeholder="角色编码，例如 Editor" />
            <input name="Name" placeholder="角色名称" />
            <input name="Description" placeholder="角色说明" />
            <button class="btn small" type="submit">保存角色</button>
        </form>
        <div class="page-card">
            <h2>角色列表</h2>
            @foreach (var role in Model)
            {
                <p><a class="text-link" href="/Role?roleId=@role.Id">@role.Name</a> <span style="color:#667085">@role.Code</span></p>
            }
        </div>
    </div>
    @if (currentRoleId > 0)
    {
        <form class="table-card" method="post" action="/Role/SavePermissions">
            <input type="hidden" name="roleId" value="@currentRoleId" />
            <h2>权限分配</h2>
            <table>
                <thead><tr><th>菜单</th><th>查看</th><th>新增</th><th>编辑</th><th>删除</th></tr></thead>
                <tbody>
                @foreach (var menu in menus)
                {
                    <tr>
                        <td>@menu.Name<input type="hidden" name="menuIds" value="@menu.Id" /></td>
                        <td><input type="checkbox" name="viewIds" value="@menu.Id" @(Has(menu.Id, p => p.CanView) ? "checked" : "") /></td>
                        <td><input type="checkbox" name="addIds" value="@menu.Id" @(Has(menu.Id, p => p.CanAdd) ? "checked" : "") /></td>
                        <td><input type="checkbox" name="editIds" value="@menu.Id" @(Has(menu.Id, p => p.CanEdit) ? "checked" : "") /></td>
                        <td><input type="checkbox" name="deleteIds" value="@menu.Id" @(Has(menu.Id, p => p.CanDelete) ? "checked" : "") /></td>
                    </tr>
                }
                </tbody>
            </table>
            <button class="btn small" type="submit">保存权限</button>
        </form>
    }
</section>
