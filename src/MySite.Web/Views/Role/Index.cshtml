@model List<Role>
@{
    Layout = null;
    var menus = ViewBag.Menus as List<Menu> ?? new List<Menu>();
    var roleMenus = ViewBag.RoleMenus as List<RoleMenu> ?? new List<RoleMenu>();
    var currentRoleId = Convert.ToInt32(ViewBag.CurrentRoleId ?? 0);
    bool Has(int menuId, Func<RoleMenu, bool> check) => roleMenus.Any(p => p.MenuId == menuId && check(p));
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>角色权限</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
    <link rel="stylesheet" href="https://unpkg.com/layui@2.9.21/dist/css/layui.css">
    <link rel="stylesheet" href="~/css/layuiadmin-admin.css" asp-append-version="true" />
</head>
<body>
<div class="layui-fluid">
    <div class="layui-row layui-col-space15">
        <div class="layui-col-md4">
            <div class="layui-card">
                <div class="layui-card-header">角色维护</div>
                <div class="layui-card-body">
                    <form class="layui-form layui-form-pane" method="post" action="/Role/SaveRole">
                        <div class="layui-form-item"><label class="layui-form-label">ID</label><div class="layui-input-block"><input name="Id" class="layui-input" placeholder="新增留空" /></div></div>
                        <div class="layui-form-item"><label class="layui-form-label">编码</label><div class="layui-input-block"><input name="Code" class="layui-input" placeholder="例如 Editor" /></div></div>
                        <div class="layui-form-item"><label class="layui-form-label">名称</label><div class="layui-input-block"><input name="Name" class="layui-input" /></div></div>
                        <div class="layui-form-item"><label class="layui-form-label">说明</label><div class="layui-input-block"><input name="Description" class="layui-input" /></div></div>
                        <button class="layui-btn" type="submit">保存角色</button>
                    </form>
                    <hr>
                    <table class="layui-table" lay-size="sm">
                        <thead><tr><th>角色</th><th>编码</th><th>操作</th></tr></thead>
                        <tbody>
                        @foreach (var role in Model)
                        {
                            <tr><td>@role.Name</td><td>@role.Code</td><td><a class="layui-btn layui-btn-xs layui-btn-normal" href="/Role?roleId=@role.Id">授权</a></td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="layui-col-md8">
            <div class="layui-card">
                <div class="layui-card-header">权限分配</div>
                <div class="layui-card-body">
                    @if (currentRoleId <= 0)
                    {
                        <blockquote class="layui-elem-quote">请选择左侧角色进行授权。</blockquote>
                    }
                    else
                    {
                        <form class="layui-form" method="post" action="/Role/SavePermissions">
                            <input type="hidden" name="roleId" value="@currentRoleId" />
                            <table class="layui-table" lay-size="sm">
                                <thead><tr><th>菜单</th><th>查看</th><th>新增</th><th>编辑</th><th>删除</th></tr></thead>
                                <tbody>
                                @foreach (var menu in menus)
                                {
                                    <tr>
                                        <td>@menu.Name<input type="hidden" name="menuIds" value="@menu.Id" /></td>
                                        <td><input type="checkbox" name="viewIds" value="@menu.Id" lay-skin="primary" @(Has(menu.Id, p => p.CanView) ? "checked" : "") /></td>
                                        <td><input type="checkbox" name="addIds" value="@menu.Id" lay-skin="primary" @(Has(menu.Id, p => p.CanAdd) ? "checked" : "") /></td>
                                        <td><input type="checkbox" name="editIds" value="@menu.Id" lay-skin="primary" @(Has(menu.Id, p => p.CanEdit) ? "checked" : "") /></td>
                                        <td><input type="checkbox" name="deleteIds" value="@menu.Id" lay-skin="primary" @(Has(menu.Id, p => p.CanDelete) ? "checked" : "") /></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                            <button class="layui-btn layui-btn-normal" type="submit">保存权限</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://unpkg.com/layui@2.9.21/dist/layui.js"></script>
<script>layui.use(['form'], function(){ layui.form.render(); });</script>
</body>
</html>
